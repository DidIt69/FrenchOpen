<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["OpenDeFrance.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <!-- Bannière de diagnostic visuel (visible uniquement en cas d'erreur JS) -->
    <div id="blazor-diag-bar" style="position:fixed; top:0; left:0; right:0; z-index:99999; padding:6px 12px; font-size:13px; font-family:system-ui, -apple-system, sans-serif; background:#c0392b; color:#fff; text-align:center; display:none; box-shadow:0 2px 8px rgba(0,0,0,0.4);">
        <span id="blazor-diag-text"></span>
    </div>

    <script>
        // Diagnostic immédiat pour capturer toute erreur JS sur mobile / Safari
        window.onerror = function (msg, url, lineNo) {
            var bar = document.getElementById('blazor-diag-bar');
            var txt = document.getElementById('blazor-diag-text');
            if (bar && txt) {
                bar.style.display = 'block';
                var file = url ? url.split('/').pop() : 'inline';
                txt.innerText = '⚠️ Erreur JS: ' + msg + ' (' + file + ':' + lineNo + ')';
            }
            return false;
        };

        window.addEventListener('unhandledrejection', function (ev) {
            var bar = document.getElementById('blazor-diag-bar');
            var txt = document.getElementById('blazor-diag-text');
            if (bar && txt) {
                bar.style.display = 'block';
                txt.innerText = '⚠️ Rejet Promise: ' + (ev.reason ? (ev.reason.message || ev.reason) : 'inconnu');
            }
        });
    </script>

    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="js/tournament-audio.js"></script>
    <script src="js/auto-scroll.js"></script>
    <!-- Démarrage natif automatique de Blazor (.NET 10 standard) -->
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
