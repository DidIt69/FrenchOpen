<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["OpenDeFrance.Web.styles.css"]" />
    <!-- Polyfill ImportMap pour Safari < 16.4 : doit être AVANT <ImportMap /> -->
    <script async src="js/es-module-shims.js"></script>
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="js/tournament-audio.js"></script>
    <script src="js/auto-scroll.js"></script>
    <script src="@Assets["_framework/blazor.web.js"]" autostart="false"></script>
    <script>
        // Démarrage manuel de Blazor pour configurer SignalR avant la connexion.
        // LongPolling (transport=4) est utilisé pour tous les navigateurs car Azure App Service
        // désactive les WebSockets par défaut. LP est fiable, fonctionne partout
        // (Safari, Chrome, Firefox, proxy, VPN, Azure) sans warning console.
        //
        // Pour repasser sur WebSockets (meilleures performances temps-réel) :
        //   1. Activer "Web sockets" dans Azure App Service → Configuration → Paramètres généraux
        //   2. Remplacer `var transport = 4` par `var transport = 1 | 4`
        (function () {
            // HttpTransportType : WebSockets=1, ServerSentEvents=2, LongPolling=4
            var transport = 4; // LongPolling uniquement (Azure WS désactivés par défaut)

            Blazor.start({
                circuit: {
                    configureSignalR: function (builder) {
                        builder.withUrl("/_blazor", { transport: transport });
                    },
                    reconnectionOptions: {
                        maxRetries: 15,
                        retryIntervalMilliseconds: 2000
                    }
                }
            });

            // Indicateur de connexion : disparaît quand Blazor est connecté
            // Utile pour diagnostiquer les problèmes Safari en production
            setTimeout(function () {
                var indicator = document.getElementById('blazor-status');
                if (indicator) indicator.style.display = 'flex';
            }, 6000);

            document.addEventListener('blazorconnected', function () {
                var indicator = document.getElementById('blazor-status');
                if (indicator) indicator.remove();
            });

            // Safari mobile : force cursor:pointer sur body pour que les taps soient reconnus
            if (/iPhone|iPad|iPod/i.test(navigator.userAgent)) {
                if (document.body) {
                    document.body.style.cursor = "pointer";
                } else {
                    document.addEventListener("DOMContentLoaded", function () {
                        document.body.style.cursor = "pointer";
                    });
                }
            }
        })();
    </script>
    <!-- Indicateur visible si Blazor ne se connecte pas (Safari, réseau lent...) -->
    <!-- <div id="blazor-status" style="display:none; position:fixed; bottom:16px; right:16px; background:#c0392b; color:white; padding:10px 16px; border-radius:8px; z-index:9999; font-weight:bold; font-size:14px; align-items:center; gap:8px; box-shadow:0 2px 8px rgba(0,0,0,0.3);">
        <span>⚠️</span>
        <span>Blazor non connecté — rechargez la page</span>
    </div> -->
</body>

</html>
