@inject NavigationManager Navigation

@code {
    protected override void OnInitialized()
    {
        var relativeUri = Navigation.ToBaseRelativePath(Navigation.Uri);
        if (!string.IsNullOrWhiteSpace(relativeUri) && !relativeUri.StartsWith("login", StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo($"login?returnUrl={Uri.EscapeDataString(relativeUri)}", replace: true);
        }
        else
        {
            Navigation.NavigateTo("login", replace: true);
        }
    }
}
