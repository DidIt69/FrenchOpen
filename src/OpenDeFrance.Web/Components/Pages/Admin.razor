    // Kumite Draw Drag & Drop
    private void OnKumiteDragStart(int matchId, CornerColor corner)
    {
        draggingKumiteMatchId = matchId;
        draggingKumiteCorner = corner;
    }

    private void OnKumiteDragEnter(int matchId, CornerColor corner)
    {
        if (draggingKumiteMatchId.HasValue)
        {
            dragHoverTarget = $"admin_k_{matchId}_{corner}";
        }
    }

    private void OnKumiteDragLeave(int matchId, CornerColor corner)
    {
        if (dragHoverTarget == $"admin_k_{matchId}_{corner}")
        {
            dragHoverTarget = null;
        }
    }

    private void OnKumiteDrop(int targetMatchId, CornerColor targetCorner)
    {
        if (draggingKumiteMatchId.HasValue && draggingKumiteCorner.HasValue)
        {
            int srcMatchId = draggingKumiteMatchId.Value;
            CornerColor srcCorner = draggingKumiteCorner.Value;

            if (srcMatchId != targetMatchId || srcCorner != targetCorner)
            {
                var mSrc = TournamentService.GetMatch(srcMatchId);
                var mDst = TournamentService.GetMatch(targetMatchId);

                string srcName = (srcCorner == CornerColor.Aka ? mSrc?.AkaDisplayName : mSrc?.ShiroDisplayName) ?? "Combattant";
                string dstName = (targetCorner == CornerColor.Aka ? mDst?.AkaDisplayName : mDst?.ShiroDisplayName) ?? "Combattant";

                TournamentService.SwapKumiteCompetitors(srcMatchId, srcCorner, targetMatchId, targetCorner);
                statusMessage = $"Tirage mis à jour : {srcName} échangé avec {dstName}.";
                isError = false;
            }
        }
        ResetDrag();
    }

