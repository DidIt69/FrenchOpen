                                        <span class="badge bg-danger me-1">🎥 Vidéo</span>
                                    }
                                    @if (!string.IsNullOrEmpty(ad.ImageUrl))
                                    {
                                        <img src="@ad.ImageUrl" alt="" style="height: 40px; max-width: 80px; object-fit: contain; border-radius: 4px;" />
                                    }
                                    else if (string.IsNullOrEmpty(ad.VideoUrl))
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                                <td class="text-end text-nowrap">
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenEditAdForm(ad)">✏️ Modifier</button>
                                    <button class="btn btn-sm btn-outline-danger ms-1" @onclick="() => DeleteAd(ad.Id)" title="Supprimer">🗑️</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</div>

@code {
    private string activeTab = "draws";
    private List<Category> categories = new();
    private List<Competitor> competitors = new();
    private List<Tatami> tatamis = new();
    private List<KumiteMatch> allMatches = new();
    private List<KataPerformance> allKataPerformances = new();

    // Publicités
    private List<Advertisement> advertisements = new();
    private Advertisement? editingAd;
    private bool showAdForm = false;
    private bool isNewAd = false;
    private string? adStatusMessage;
    private bool adIsError = false;

    private Category? selectedCategory;
    private int selectedCategoryId;
    private List<KumiteMatch> categoryMatches = new();
    private List<KataPerformance> categoryKataPerformances = new();

    private string? statusMessage;
    private bool isError = false;
    private string competitorFilter = string.Empty;
    private string encounterSearchFilter = string.Empty;

    // Multi-Jours & Planification
    private int selectedDayFilter = 0; // 0 = Tous, 1 = Jour 1, 2 = Jour 2...
    private int selectedBoardDayFilter = 0;
    private int selectedBoardTatamiFilter = 0;
    private int selectedEncounterDayFilter = 0;
    private int tournamentDaysCount = 2;
    private int? tournamentActiveDay = null; // Jour actif défini par l'admin

    // Tatami Management Form
    private string newTatamiName = string.Empty;
    private CompetitionType newTatamiDiscipline = CompetitionType.Kumite;

    // Drag & Drop State for Draws
    private int? draggingKumiteMatchId;
    private CornerColor? draggingKumiteCorner;
    private int? draggingKataPerfId;
    private string? dragHoverTarget;

    // Drag & Drop State for Tatami Kanban Board
    private int? draggingBoardMatchId;
    private int? draggingBoardKataId;
    private int? dragBoardHoverTatamiId;

    protected override void OnInitialized()
    {
        RefreshData();
        TournamentService.OnStateChanged += HandleStateChanged;
        Lang.OnLanguageChanged += HandleLanguageChanged;
    }

    private void RefreshData()
    {
        var tournament = TournamentService.GetTournament();
        if (tournament != null)
        {
            tournamentDaysCount = Math.Max(1, tournament.DaysCount);
            tournamentActiveDay = tournament.ActiveDay;
        }

        tatamis = TournamentService.GetTatamis();
        categories = TournamentService.GetCategories().OrderBy(c => c.CompetitionDay).ThenBy(c => c.OrderIndex).ThenBy(c => c.Name).ToList();
        competitors = TournamentService.GetCompetitors();
        allMatches = TournamentService.GetMatches();
        allKataPerformances = TournamentService.GetKataPerformances();
        advertisements = TournamentService.GetAdvertisements();

        if (categories.Count > 0 && selectedCategory == null)
        {
            selectedCategoryId = categories[0].Id;
            selectedCategory = categories[0];
        }
        else if (selectedCategory != null)
        {
            selectedCategory = categories.FirstOrDefault(c => c.Id == selectedCategoryId);
        }

        if (selectedCategory != null)
        {
            categoryMatches = allMatches.Where(m => m.CategoryId == selectedCategoryId).ToList();
            categoryKataPerformances = allKataPerformances.Where(p => p.CategoryId == selectedCategoryId).ToList();
        }
    }

    // ===== PUBLICITES =====

    private void OpenNewAdForm()
    {
        editingAd = new Advertisement { OrderIndex = advertisements.Count, IsActive = true, DisplayDurationSeconds = 8 };
        isNewAd = true;
        showAdForm = true;
    }

    private void OpenEditAdForm(Advertisement ad)
    {
        // Copie pour édition sans toucher l'original immédiatement
        editingAd = new Advertisement
        {
            Id = ad.Id,
            Title = ad.Title,
            Subtitle = ad.Subtitle,
            Description = ad.Description,
            ImageUrl = ad.ImageUrl,
            VideoUrl = ad.VideoUrl,
            LogoUrl = ad.LogoUrl,
            WebsiteUrl = ad.WebsiteUrl,
            DisplayDurationSeconds = ad.DisplayDurationSeconds,
            OrderIndex = ad.OrderIndex,
            IsActive = ad.IsActive
        };
        isNewAd = false;
        showAdForm = true;
    }

    private void CloseAdForm()
    {
        showAdForm = false;
        editingAd = null;
        adStatusMessage = null;
    }

    private void SaveAd()
    {
        if (editingAd == null) return;
        if (string.IsNullOrWhiteSpace(editingAd.Title))
        {
            adStatusMessage = "Le titre de la publicité est obligatoire.";
            adIsError = true;
            return;
        }

        if (isNewAd)
        {
            TournamentService.AddAdvertisement(editingAd);
            adStatusMessage = $"Publicité \"{editingAd.Title}\" ajoutée avec succès !";
        }
        else
        {
            TournamentService.UpdateAdvertisement(editingAd);
            adStatusMessage = $"Publicité \"{editingAd.Title}\" mise à jour.";
        }
        adIsError = false;
        RefreshData();
        showAdForm = false;
        editingAd = null;
    }

    private void DeleteAd(int adId)
    {
        var ad = advertisements.FirstOrDefault(a => a.Id == adId);
        bool deleted = TournamentService.DeleteAdvertisement(adId);
        RefreshData();
        if (deleted)
        {
            adStatusMessage = $"Publicité \"{ad?.Title}\" supprimée.";
            adIsError = false;
        }
        else
        {
            adStatusMessage = "Impossible de supprimer cette publicité.";
            adIsError = true;
        }
    }

    private void PauseAllTatamis()
    {
        TournamentService.SetAllTatamisPause(true);
        RefreshData();
        adStatusMessage = "Tous les tatamis sont maintenant en PAUSE (publicités diffusées).";
        adIsError = false;
    }

    private void ResumeAllTatamis()
    {
        TournamentService.SetAllTatamisPause(false);
        RefreshData();
        adStatusMessage = "Tous les tatamis ont repris la compétition.";
        adIsError = false;
    }

    private void HandleChangeCategoryDay(int categoryId, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int day))
        {
            TournamentService.SetCategoryDay(categoryId, day);
            statusMessage = $"Catégorie programmée sur le Jour {day}. Tirages et numérotation mis à jour.";
            isError = false;
        }
    }

    private void HandleChangeCategoryOrder(int categoryId, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int order) && order > 0)
        {
            TournamentService.SetCategoryOrderIndex(categoryId, order);
            RefreshData();
            statusMessage = "Ordre de passage de la catégorie mis à jour. Rencontres et passages renumérotés.";
            isError = false;
        }
    }

    private void HandleMoveCategoryOrder(int categoryId, int direction)
    {
        TournamentService.MoveCategoryOrder(categoryId, direction);
        RefreshData();
        statusMessage = "Ordre des catégories réorganisé. Rencontres et passages renumérotés.";
        isError = false;
    }

    private void HandleChangeCategoryTatami(int categoryId, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int tatamiId))
        {
            TournamentService.SetCategoryTatami(categoryId, tatamiId > 0 ? tatamiId : null);
            RefreshData();
            if (tatamiId > 0)
            {
                var t = tatamis.FirstOrDefault(x => x.Id == tatamiId);
                statusMessage = $"Catégorie et ses rencontres assignées à {t?.Name ?? $"Tatami #{tatamiId}"}.";
