        tournamentActiveDay = day;
        TournamentService.SetActiveDay(day);
        statusMessage = day.HasValue
            ? $"Jour actif défini sur le Jour {day}."
            : "Filtre de jour actif réinitialisé (tous les jours).";
        isError = false;
