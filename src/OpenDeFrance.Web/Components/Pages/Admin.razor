            if (t != null)
            {
                TournamentService.UpdateTatami(tatamiId, t.Name, disc);
                RefreshData();
                statusMessage = $"Discipline du tatami mise à jour : {disc}. Combats rééquilibrés.";
                isError = false;
            }
        }
