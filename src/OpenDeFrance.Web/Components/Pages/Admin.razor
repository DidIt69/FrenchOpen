                        <div class="col-md-3">
                            <label class="form-label fw-bold">Ordre</label>
                            <input type="number" class="form-control" @bind="editingAd.OrderIndex" min="0" />
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="adIsActive" @bind="editingAd.IsActive" />
                                <label class="form-check-label fw-bold" for="adIsActive">✅ Publicité active (affichée en rotation)</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer d-flex justify-content-end gap-2">
                    <button class="btn btn-secondary" @onclick="CloseAdForm">Annuler</button>
                    <button class="btn btn-success fw-bold" @onclick="SaveAd">💾 Enregistrer</button>
                </div>
            </div>
        }

        <!-- Tableau des publicités -->
        @if (advertisements.Count == 0)
        {
            <div class="alert alert-info">
                Aucune publicité configurée. Cliquez sur <strong>Nouvelle publicité</strong> pour en ajouter.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>Active</th>
                            <th>Titre</th>
                            <th>Sous-titre</th>
                            <th>Durée</th>
                            <th>Aperçu</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ad in advertisements.OrderBy(a => a.OrderIndex))
                        {
                            <tr class="@(!ad.IsActive ? "table-secondary text-muted" : "")">
                                <td><span class="badge bg-secondary">@ad.OrderIndex</span></td>
                                <td>
                                    <span class="badge @(ad.IsActive ? "bg-success" : "bg-secondary")">
                                        @(ad.IsActive ? "✅ Active" : "❌ Inactive")
                                    </span>
                                </td>
                                <td><strong>@ad.Title</strong></td>
                                <td class="text-muted small">@ad.Subtitle</td>
                                <td><span class="badge bg-info text-dark">@ad.DisplayDurationSeconds s</span></td>
