    // Tatami Configuration
    private void HandleAddTatami()
    {
        string name = string.IsNullOrWhiteSpace(newTatamiName) ? $"Tatami {tatamis.Count + 1}" : newTatamiName.Trim();
        var added = TournamentService.AddTatami(name, newTatamiDiscipline);
        newTatamiName = string.Empty;
        RefreshData();
        statusMessage = $"Tatami '{added.Name}' ajouté avec succès ! Les combats ont été automatiquement rééquilibrés.";
        isError = false;
    }

    private void HandleDeleteTatami(int tatamiId)
    {
        bool deleted = TournamentService.DeleteTatami(tatamiId);
        RefreshData();
        if (deleted)
        {
            statusMessage = "Tatami supprimé. Ses rencontres ont été réparties et rééquilibrées sur les tatamis restants.";
            isError = false;
        }
        else
        {
            statusMessage = "Impossible de supprimer le dernier tatami.";
            isError = true;
        }
    }

    private void HandleUpdateTatamiName(int tatamiId, ChangeEventArgs e)
    {
        string newName = e.Value?.ToString() ?? string.Empty;
        var t = tatamis.FirstOrDefault(x => x.Id == tatamiId);
        if (t != null && !string.IsNullOrWhiteSpace(newName))
        {
            TournamentService.UpdateTatami(tatamiId, newName, t.CurrentDiscipline);
            RefreshData();
