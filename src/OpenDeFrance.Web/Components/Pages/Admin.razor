    // Competitor editing & filtering state
    private bool isCompetitorModalOpen = false;
    private bool isNewCompetitor = false;
    private Competitor? editingCompetitor;
    private HashSet<int> editingCompetitorCategoryIds = new();
    private int selectedCompetitorCategoryFilter = 0;
    private string selectedCompetitorDisciplineFilter = "all";

    private void ResetCompetitorFilters()
    {
        competitorFilter = string.Empty;
        selectedCompetitorCategoryFilter = 0;
        selectedCompetitorDisciplineFilter = "all";
    }

    private void OpenAddCompetitorModal()
    {
        isNewCompetitor = true;
        editingCompetitor = new Competitor
        {
            Country = "France",
            Gender = Gender.Male,
            Grade = BeltGrade.White,
            IsKumiteRegistered = true,
            IsKataRegistered = false
        };
        editingCompetitorCategoryIds.Clear();
        if (selectedCompetitorCategoryFilter > 0)
        {
            editingCompetitorCategoryIds.Add(selectedCompetitorCategoryFilter);
        }
        isCompetitorModalOpen = true;
    }

    private void OpenEditCompetitorModal(Competitor c)
    {
        isNewCompetitor = false;
        editingCompetitor = new Competitor
        {
            Id = c.Id,
            BibNumber = c.BibNumber,
            FirstName = c.FirstName,
            LastName = c.LastName,
            Country = c.Country,
            Club = c.Club,
            BirthDate = c.BirthDate,
            Age = c.Age,
            Weight = c.Weight,
            Grade = c.Grade,
            Gender = c.Gender,
            IsKumiteRegistered = c.IsKumiteRegistered,
            IsKataRegistered = c.IsKataRegistered
        };

        var compCats = categories
            .Where(cat => cat.Competitors.Any(comp => comp.Id == c.Id) || c.Categories.Any(cat2 => cat2.Id == cat.Id))
            .Select(cat => cat.Id)
            .ToList();
        editingCompetitorCategoryIds = new HashSet<int>(compCats);
        isCompetitorModalOpen = true;
    }

    private void CloseCompetitorModal()
    {
        isCompetitorModalOpen = false;
        editingCompetitor = null;
        editingCompetitorCategoryIds.Clear();
    }

    private void HandleBirthDateChange(ChangeEventArgs e)
    {
        if (editingCompetitor != null && DateTime.TryParse(e.Value?.ToString(), out var dt))
        {
            editingCompetitor.BirthDate = dt;
            int age = DateTime.Today.Year - dt.Year;
            if (dt.Date > DateTime.Today.AddYears(-age)) age--;
            if (age >= 0) editingCompetitor.Age = age;
        }
        else if (editingCompetitor != null)
        {
            editingCompetitor.BirthDate = null;
        }
    }

    private void ToggleCompetitorCategory(int categoryId, ChangeEventArgs e)
    {
        bool isChecked = (bool)(e.Value ?? false);
        if (isChecked)
        {
            editingCompetitorCategoryIds.Add(categoryId);
        }
        else
        {
            editingCompetitorCategoryIds.Remove(categoryId);
        }
    }

    private void SaveCompetitor()
    {
        if (editingCompetitor == null) return;

        if (string.IsNullOrWhiteSpace(editingCompetitor.LastName) || string.IsNullOrWhiteSpace(editingCompetitor.FirstName))
        {
            statusMessage = "Erreur : Le nom et le prénom du compétiteur sont obligatoires.";
            isError = true;
            return;
        }

        if (isNewCompetitor)
        {
            TournamentService.AddCompetitor(editingCompetitor, editingCompetitorCategoryIds.ToList());
            statusMessage = $"Compétiteur {editingCompetitor.FullName} ajouté avec succès !";
        }
        else
        {
            TournamentService.UpdateCompetitor(editingCompetitor, editingCompetitorCategoryIds.ToList());
            statusMessage = $"Compétiteur {editingCompetitor.FullName} modifié avec succès !";
        }

        isError = false;
        CloseCompetitorModal();
        RefreshData();
    }

