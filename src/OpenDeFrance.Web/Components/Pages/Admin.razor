        if (draggingKataPerfId.HasValue && draggingKataPerfId.Value != targetPerfId)
        {
            var p1 = categoryKataPerformances.FirstOrDefault(p => p.Id == draggingKataPerfId.Value);
            var p2 = categoryKataPerformances.FirstOrDefault(p => p.Id == targetPerfId);

            TournamentService.SwapKataPerformances(draggingKataPerfId.Value, targetPerfId);
            statusMessage = $"Ordre Kata modifié : {p1?.CompetitorDisplayName} ⇄ {p2?.CompetitorDisplayName}.";
            isError = false;
        }
