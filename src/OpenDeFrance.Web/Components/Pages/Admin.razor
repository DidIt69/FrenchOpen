                var t = tatamis.FirstOrDefault(x => x.Id == tatamiId);
                statusMessage = $"Toutes les rencontres de la catégorie ont été assignées au {t?.Name ?? $"Tatami {tatamiId}"}.";
            }
            else
            {
                TournamentService.SetCategoryTatami(categoryId, null);
                statusMessage = "Catégorie retirée des tatamis (non affichée sur les tatamis).";
            }
            RefreshData();
            isError = false;
        }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file == null) return;

            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            ms.Position = 0;

            var result = ExcelService.ImportTournamentData(ms);
            if (result.Success)
            {
                TournamentService.ApplyExcelImport(result);
                statusMessage = $"Succès : {result.Competitors.Count} compétiteurs importés dans {result.Categories.Count} catégories ! Tirages au sort générés automatiquement.";
                isError = false;
            }
            else
            {
                statusMessage = string.Join(" ", result.Errors);
                isError = true;
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Erreur lors de l'import : {ex.Message}";
            isError = true;
        }
    }

