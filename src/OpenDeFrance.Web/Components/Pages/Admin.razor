    protected override void OnInitialized()
    {
        RefreshData();
        TournamentService.OnStateChanged += HandleStateChanged;
        Lang.OnLanguageChanged += HandleLanguageChanged;
    }

    private void RefreshData()
    {
        var tournament = TournamentService.GetTournament();
        if (tournament != null)
        {
            tournamentDaysCount = Math.Max(1, tournament.DaysCount);
            tournamentActiveDay = tournament.ActiveDay;
        }

        tatamis = TournamentService.GetTatamis();
        categories = TournamentService.GetCategories().OrderBy(c => c.CompetitionDay).ThenBy(c => c.OrderIndex).ThenBy(c => c.Name).ToList();
        competitors = TournamentService.GetCompetitors();
        allMatches = TournamentService.GetMatches();
        allKataPerformances = TournamentService.GetKataPerformances();

        if (categories.Count > 0 && selectedCategory == null)
        {
            selectedCategoryId = categories[0].Id;
            selectedCategory = categories[0];
        }
        else if (selectedCategory != null)
        {
            selectedCategory = categories.FirstOrDefault(c => c.Id == selectedCategoryId);
        }

        if (selectedCategory != null)
        {
            categoryMatches = allMatches.Where(m => m.CategoryId == selectedCategoryId).ToList();
            categoryKataPerformances = allKataPerformances.Where(p => p.CategoryId == selectedCategoryId).ToList();
        }
    }

    private void HandleChangeCategoryDay(int categoryId, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int day))
        {
            TournamentService.SetCategoryDay(categoryId, day);
            statusMessage = $"Catégorie programmée sur le Jour {day}. Tirages et numérotation mis à jour.";
            isError = false;
        }
    }

    private void HandleChangeCategoryOrder(int categoryId, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int order) && order > 0)
        {
            TournamentService.SetCategoryOrderIndex(categoryId, order);
            RefreshData();
            statusMessage = "Ordre de passage de la catégorie mis à jour. Rencontres et passages renumérotés.";
            isError = false;
        }
    }

    private void HandleMoveCategoryOrder(int categoryId, int direction)
    {
        TournamentService.MoveCategoryOrder(categoryId, direction);
        RefreshData();
        statusMessage = "Ordre des catégories réorganisé. Rencontres et passages renumérotés.";
        isError = false;
    }

    private void HandleChangeCategoryTatami(int categoryId, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int tatamiId))
        {
            TournamentService.SetCategoryTatami(categoryId, tatamiId > 0 ? tatamiId : null);
            RefreshData();
            if (tatamiId > 0)
            {
                var t = tatamis.FirstOrDefault(x => x.Id == tatamiId);
                statusMessage = $"Catégorie et ses rencontres assignées à {t?.Name ?? $"Tatami #{tatamiId}"}.";
            }
            else
            {
                statusMessage = "Catégorie retirée des tatamis (non affichée sur les tatamis).";
            }
            isError = false;
        }
    }

    private void HandleChangeTournamentDaysCount(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int days) && days >= 1)
        {
            tournamentDaysCount = days;
            TournamentService.SetTournamentDaysCount(days);
            // Ajuster le jour actif si nécessaire
            if (tournamentActiveDay.HasValue && tournamentActiveDay.Value > days)
            {
                tournamentActiveDay = null;
            }
            statusMessage = $"Durée de la compétition configurée sur {days} jour(s).";
            isError = false;
        }
    }

    private void SetActiveDayAdmin(int? day)
