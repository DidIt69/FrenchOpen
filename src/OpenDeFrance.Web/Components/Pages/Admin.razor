@page "/admin"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@inject ITournamentService TournamentService
@inject IExcelTournamentService ExcelService
@inject ILanguageService Lang
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>@Lang["AdminTitle"]</PageTitle>

<div class="container-fluid py-3">
    <div class="align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-1">@Lang["AdminTitle"]</h2>
        </div>
        <div class="d-flex gap-2 flex-wrap align-items-center">
            <a href="/api/tournament/excel-template" target="_blank" class="btn btn-sm btn-outline-success">
                📥 Modèle Excel (.xlsx)
            </a>
            <button class="btn btn-sm btn-warning" @onclick="LoadSampleData">
                ⚡ Données d'exemple
            </button>
            <button class="btn btn-sm btn-outline-danger" @onclick="ResetData">
                🗑️ Réinitialiser
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="alert @(isError ? "alert-danger" : "alert-success") alert-dismissible fade show shadow-sm" role="alert">
            <span>@statusMessage</span>
            <button type="button" class="btn-close" @onclick="() => statusMessage = null"></button>
        </div>
    }

    <!-- Barre Paramètres Globaux : Jour Actif -->
    <div class="card shadow-sm border-0 mb-3 border-start border-4 border-warning">
        <div class="card-body py-2 px-3 d-flex align-items-center flex-wrap gap-3">
            <span class="fw-bold text-warning-emphasis small text-nowrap">🗓️ Jour actif (filtre Home) :</span>
            <div class="btn-group btn-group-sm">
                <button class="btn @(tournamentActiveDay == null ? "btn-warning fw-bold" : "btn-outline-secondary")"
                        @onclick="() => SetActiveDayAdmin(null)">
                    Tous les jours
                </button>
                @for (int d = 1; d <= tournamentDaysCount; d++)
                {
                    int dayNum = d;
                    <button class="btn @(tournamentActiveDay == dayNum ? "btn-warning fw-bold" : "btn-outline-warning")"
                            @onclick="() => SetActiveDayAdmin(dayNum)">
                        📅 Jour @(dayNum)
                    </button>
                }
            </div>
            @if (tournamentActiveDay.HasValue)
            {
                <span class="badge bg-warning text-dark px-3 py-2">
                    ✅ Affichage Home filtré sur le Jour @tournamentActiveDay
                </span>
            }
            else
            {
                <span class="badge bg-secondary px-3 py-2">
                    Aucun filtre — tous les jours visibles sur Home
                </span>
            }
            <span class="ms-auto text-muted small">Durée totale :
                <select class="form-select form-select-sm d-inline-block py-0 ms-1" style="width: auto;"
                        value="@tournamentDaysCount"
                        @onchange="HandleChangeTournamentDaysCount">
                    <option value="1">1 Jour</option>
                    <option value="2">2 Jours</option>
                    <option value="3">3 Jours</option>
                    <option value="4">4 Jours</option>
                </select>
            </span>
        </div>
    </div>

    <!-- Onglets de Navigation Admin -->
    <ul class="nav nav-pills mb-3 mb-md-4 bg-white p-1 p-md-2 rounded shadow-sm border flex-nowrap overflow-auto admin-tabs-nav">
        <li class="nav-item">
            <button class="nav-link fw-bold text-nowrap @(activeTab == "draws" ? "active" : "")" @onclick='() => activeTab = "draws"'>
                @Lang["TabDraws"]
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link fw-bold text-nowrap @(activeTab == "tatamis" ? "active" : "")" @onclick='() => activeTab = "tatamis"'>
                @Lang["TabTatamis"]
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link fw-bold text-nowrap @(activeTab == "categories" ? "active" : "")" @onclick='() => activeTab = "categories"'>
                @Lang["TabCategories"]
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link fw-bold text-nowrap @(activeTab == "competitors" ? "active" : "")" @onclick='() => activeTab = "competitors"'>
                @Lang["TabCompetitors"] (@competitors.Count)
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link fw-bold text-nowrap @(activeTab == "ads" ? "active" : "")" @onclick='() => activeTab = "ads"'>
                📢 Publicités & Pauses
            </button>
        </li>
    </ul>

    <!-- ========================================== -->
    <!-- TAB 1 : TIRAGES AU SORT (DRAG & DROP)      -->
    <!-- ========================================== -->
    @if (activeTab == "draws")
    {
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div class="d-flex align-items-center gap-3 flex-wrap">
                    <span class="fs-5 fw-bold">🎯 Modification des Tirages au Sort</span>
                    <select class="form-select form-select-sm" style="min-width: 260px;" @bind="selectedCategoryId" @bind:after="OnCategoryChanged">
                        @foreach (var cat in categories.OrderBy(c => c.CompetitionDay).ThenBy(c => c.OrderIndex).ThenBy(c => c.Name))
                        {
                            <option value="@cat.Id">
                                [#@cat.OrderIndex] 📅 Jour @(cat.CompetitionDay) • @(cat.Type == CompetitionType.Kumite ? "🥊" : "🥋") @cat.Name @(!cat.AssignedTatamiId.HasValue ? "(🚫 Sans tatami)" : "") (@cat.Competitors.Count inscrits)
                            </option>
                        }
                    </select>
                </div>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    @if (selectedCategory != null)
                    {
                        @if (selectedCategory.Type == CompetitionType.Kumite)
                        {
                            <div class="form-check form-switch bg-dark border border-secondary px-3 py-1 rounded d-flex align-items-center gap-2 m-0 text-white">
                                <input 
                                    class="form-check-input ms-0 me-2" 
                                    type="checkbox" 
                                    id="bronzeSwitch"
                                    checked="@selectedCategory.HasBronzeMatch"
                                    @onchange="(e) => ToggleCategoryBronzeMatch(selectedCategory.Id, e)" 
                                />
                                <label 
                                    class="form-check-label small mb-0 fw-bold" 
                                    for="bronzeSwitch"
                                >
                                    🥉 Petite Finale (3e place)
                                </label>
                            </div>
                        }
                        else
                        {
                            <div 
                                class="d-flex align-items-center gap-2 bg-dark border border-secondary px-3 py-1 rounded text-white small"
                            >
                                <label class="fw-bold mb-0 text-nowrap" for="kataQualifiersInput">🎯 Qualifiés Tour 2 :</label>
                                <input 
                                    id="kataQualifiersInput" 
                                    type="number" 
                                    class="form-control form-control-sm text-center bg-white text-dark fw-bold"
                                    style="width: 65px; height: 28px;"
                                    min="1" 
                                    max="32"
                                    value="@selectedCategory.KataQualifiersCount"
                                    @onchange="(e) => HandleChangeKataQualifiersCount(selectedCategory.Id, e)"
                                    title="Modifier le nombre de compétiteurs qualifiés pour la finale" 
                                />
                                <span class="text-white-50">compétiteur(s)</span>
                            </div>
                        }

                        <div 
                            class="d-flex align-items-center gap-1 bg-secondary text-white px-2 py-1 rounded small"
                        >
                            <span>Affecter toute la catégorie :</span>
                            <select 
                                class="form-select form-select-sm py-0 px-1 text-dark" 
                                style="width: auto; height: 26px;"
                                value="@(selectedCategory.AssignedTatamiId ?? 0)"
                                @onchange="(e) => BulkAssignCategoryTatami(selectedCategory.Id, e)"
                            >
                                <option value="0">🚫 Aucun tatami</option>
                                @foreach (var t in tatamis)
                                {
                                    <option value="@t.Id">@t.Name</option>
                                }
                            </select>
                        </div>
                    }
                    <button class="btn btn-sm btn-outline-warning" @onclick="() => RegenerateCategory(selectedCategoryId)">
                        🎲 Régénérer ce tirage
                    </button>
                </div>
            </div>

            <div class="card-body p-4">
                @if (selectedCategory != null)
                {
                    @if (selectedCategory.Type == CompetitionType.Kumite)
                    {
                        var matches = categoryMatches;
                        if (matches.Count == 0)
                        {
                            <div class="alert alert-warning text-center">
                                Aucun match généré pour cette catégorie. Cliquez sur <strong>Régénérer ce tirage</strong> ci-dessus.
                            </div>
                        }
                        else
                        {
                            <div class="d-md-none text-muted small text-center mb-2 py-1 bg-light rounded border">
                                ↔️ Faites défiler horizontalement pour explorer tout l'arbre
                            </div>
                            int maxRound = matches.Max(m => m.BracketRound);

                            <div class="bracket-container">
                                @for (int r = 1; r <= maxRound; r++)
                                {
                                    int currentRound = r;
                                    var roundMatches = matches.Where(m => m.BracketRound == currentRound).OrderBy(m => m.MatchNumber).ToList();
                                    var mainRoundMatches = roundMatches.Where(m => !m.IsBronzeMatch).ToList();
                                    var bronzeMatch = roundMatches.FirstOrDefault(m => m.IsBronzeMatch);
                                    string roundTitle = mainRoundMatches.FirstOrDefault()?.RoundName ?? $"Tour {currentRound}";

                                    <div class="bracket-round">
                                        <div class="round-header text-center fw-bold text-uppercase py-2 mb-3 bg-light rounded border">
                                            @roundTitle
                                        </div>
                                        @if (currentRound == maxRound && bronzeMatch != null)
                                        {
                                            <div class="round-matches-final-col">
                                                <!-- Grande Finale : parfaitement centrée au milieu des deux demi-finales -->
                                                <div class="final-main-match">
                                                    <div class="small fw-bold text-center text-uppercase text-dark bg-danger-subtle py-1 px-2 rounded mb-2 border border-danger">
                                                        🏆 @Lang["GrandFinal"]
                                                    </div>
                                                    @foreach (var match in mainRoundMatches)
                                                    {
                                                        bool canDragAka = match.BracketRound == 1 && (match.Status != MatchStatus.Finished || match.IsBye);
                                                        bool canDragShiro = match.BracketRound == 1 && (match.Status != MatchStatus.Finished || match.IsBye);
                                                        bool isAkaHover = dragHoverTarget == $"admin_k_{match.Id}_Aka";
                                                        bool isShiroHover = dragHoverTarget == $"admin_k_{match.Id}_Shiro";

                                                        <div class="bracket-match-card @(match.Status == MatchStatus.Finished ? "finished" : "") @(match.Status == MatchStatus.InProgress ? "in-progress" : "")">
                                                            <div class="match-meta d-flex justify-content-between align-items-center small text-muted px-2 py-1 bg-light border-bottom">
                                                                <span class="fw-bold">#@match.MatchNumber</span>
                                                                <div class="d-flex align-items-center gap-1">
                                                                    <select 
                                                                        class="form-select form-select-sm py-0 px-1 border-primary"
                                                                        style="font-size: 0.75rem; width: auto; height: 24px; cursor: pointer;"
                                                                        value="@match.TatamiId"
                                                                        @onchange="(e) => OnChangeMatchTatami(match.Id, e)"
                                                                    >
                                                                        @foreach (var t in tatamis)
                                                                        {
                                                                            <option value="@t.Id">@t.Name</option>
                                                                        }
                                                                    </select>
                                                                </div>
                                                            </div>

                                                            <!-- AKA -->
                                                            <div class="fighter-row aka @(match.WinnerCompetitorId == match.AkaCompetitorId && match.Status == MatchStatus.Finished ? "winner fw-bold" : "") @(canDragAka ? "draggable-slot" : "") @(isAkaHover ? "drop-target-hover" : "")"
                                                                 draggable="@(canDragAka ? "true" : "false")"
                                                                 @ondragstart="() => OnKumiteDragStart(match.Id, CornerColor.Aka)"
                                                                 @ondragend="ResetDrag"
                                                                 @ondragover="HandleDragOver"
                                                                 @ondragover:preventDefault="true"
                                                                 @ondragenter="() => OnKumiteDragEnter(match.Id, CornerColor.Aka)"
                                                                 @ondragleave="() => OnKumiteDragLeave(match.Id, CornerColor.Aka)"
                                                                 @ondrop="() => OnKumiteDrop(match.Id, CornerColor.Aka)">
                                                                <span class="corner-indicator red"></span>
                                                                @if (canDragAka)
                                                                {
                                                                    <span class="drag-handle" title="Glisser pour modifier le tirage">⠿</span>
                                                                }
                                                                <span class="name text-truncate">@match.AkaDisplayName</span>
                                                                <span class="score">
                                                                    @(match.AkaIppon > 0 ? "IPPON" : (match.AkaWazaAri > 0 ? $"{match.AkaWazaAri} W" : ""))
                                                                </span>
                                                            </div>

                                                            <!-- SHIRO -->
                                                            <div class="fighter-row shiro @(match.WinnerCompetitorId == match.ShiroCompetitorId && match.Status == MatchStatus.Finished ? "winner fw-bold" : "") @(canDragShiro ? "draggable-slot" : "") @(isShiroHover ? "drop-target-hover" : "")"
                                                                 draggable="@(canDragShiro ? "true" : "false")"
                                                                 @ondragstart="() => OnKumiteDragStart(match.Id, CornerColor.Shiro)"
                                                                 @ondragend="ResetDrag"
                                                                 @ondragover="HandleDragOver"
                                                                 @ondragover:preventDefault="true"
                                                                 @ondragenter="() => OnKumiteDragEnter(match.Id, CornerColor.Shiro)"
                                                                 @ondragleave="() => OnKumiteDragLeave(match.Id, CornerColor.Shiro)"
                                                                 @ondrop="() => OnKumiteDrop(match.Id, CornerColor.Shiro)">
                                                                <span class="corner-indicator white"></span>
                                                                @if (canDragShiro)
                                                                {
                                                                    <span class="drag-handle" title="Glisser pour modifier le tirage">⠿</span>
                                                                }
                                                                <span class="name text-truncate">@match.ShiroDisplayName</span>
                                                                <span class="score">
                                                                    @(match.ShiroIppon > 0 ? "IPPON" : (match.ShiroWazaAri > 0 ? $"{match.ShiroWazaAri} W" : ""))
                                                                </span>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>

                                                <!-- Petite Finale (3e place) : positionnée en dessous -->
                                                <div class="final-bronze-match">
                                                    <div class="small fw-bold text-center text-uppercase text-dark bg-warning-subtle py-1 px-2 rounded mb-2 border border-warning">
                                                        🥉 @Lang["BronzeMatch"]
                                                    </div>
                                                    <div class="bracket-match-card border-warning @(bronzeMatch.Status == MatchStatus.Finished ? "finished" : "") @(bronzeMatch.Status == MatchStatus.InProgress ? "in-progress" : "")">
                                                        <div class="match-meta d-flex justify-content-between align-items-center small text-muted px-2 py-1 bg-warning-subtle border-bottom">
                                                            <span class="fw-bold">#@bronzeMatch.MatchNumber</span>
                                                            <div class="d-flex align-items-center gap-1">
                                                                <span class="badge bg-light text-secondary border" style="font-size: 0.7rem;">Tatami</span>
                                                                <select class="form-select form-select-sm py-0 px-1 border-primary"
                                                                        style="font-size: 0.75rem; width: auto; height: 24px; cursor: pointer;"
                                                                        value="@bronzeMatch.TatamiId"
                                                                        @onchange="(e) => OnChangeMatchTatami(bronzeMatch.Id, e)">
                                                                    @foreach (var t in tatamis)
                                                                    {
                                                                        <option value="@t.Id">@t.Name</option>
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>

                                                        <!-- AKA -->
                                                        <div class="fighter-row aka @(bronzeMatch.WinnerCompetitorId == bronzeMatch.AkaCompetitorId && bronzeMatch.Status == MatchStatus.Finished ? "winner fw-bold" : "")">
                                                            <span class="corner-indicator red"></span>
                                                            <span class="name text-truncate">@bronzeMatch.AkaDisplayName</span>
                                                            <span class="score">
                                                                @(bronzeMatch.AkaIppon > 0 ? "IPPON" : (bronzeMatch.AkaWazaAri > 0 ? $"{bronzeMatch.AkaWazaAri} W" : ""))
                                                            </span>
                                                        </div>

                                                        <!-- SHIRO -->
                                                        <div class="fighter-row shiro @(bronzeMatch.WinnerCompetitorId == bronzeMatch.ShiroCompetitorId && bronzeMatch.Status == MatchStatus.Finished ? "winner fw-bold" : "")">
                                                            <span class="corner-indicator white"></span>
                                                            <span class="name text-truncate">@bronzeMatch.ShiroDisplayName</span>
                                                            <span class="score">
                                                                @(bronzeMatch.ShiroIppon > 0 ? "IPPON" : (bronzeMatch.ShiroWazaAri > 0 ? $"{bronzeMatch.ShiroWazaAri} W" : ""))
                                                            </span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="round-matches-col">
                                                @foreach (var match in mainRoundMatches)
                                                {
                                                    bool canDragAka = match.BracketRound == 1 && (match.Status != MatchStatus.Finished || match.IsBye);
                                                    bool canDragShiro = match.BracketRound == 1 && (match.Status != MatchStatus.Finished || match.IsBye);
                                                    bool isAkaHover = dragHoverTarget == $"admin_k_{match.Id}_Aka";
                                                    bool isShiroHover = dragHoverTarget == $"admin_k_{match.Id}_Shiro";

                                                    <div class="bracket-match-card @(match.Status == MatchStatus.Finished ? "finished" : "") @(match.Status == MatchStatus.InProgress ? "in-progress" : "")">
                                                        <div class="match-meta d-flex justify-content-between align-items-center small text-muted px-2 py-1 bg-light border-bottom">
                                                            <span class="fw-bold">#@match.MatchNumber</span>
                                                            <div class="d-flex align-items-center gap-1">
                                                                <select 
                                                                    class="form-select form-select-sm py-0 px-1 border-primary"
                                                                    style="width: 100px; height: 26px; cursor: pointer;"
                                                                    value="@match.TatamiId"
                                                                    @onchange="(e) => OnChangeMatchTatami(match.Id, e)"
                                                                >
                                                                    @foreach (var t in tatamis)
                                                                    {
                                                                        <option value="@t.Id">@t.Name</option>
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>

                                                        <!-- AKA -->
                                                        <div class="fighter-row aka @(match.WinnerCompetitorId == match.AkaCompetitorId && match.Status == MatchStatus.Finished ? "winner fw-bold" : "") @(canDragAka ? "draggable-slot" : "") @(isAkaHover ? "drop-target-hover" : "")"
                                                             draggable="@(canDragAka ? "true" : "false")"
                                                             @ondragstart="() => OnKumiteDragStart(match.Id, CornerColor.Aka)"
                                                             @ondragend="ResetDrag"
                                                             @ondragover="HandleDragOver"
                                                             @ondragover:preventDefault="true"
                                                             @ondragenter="() => OnKumiteDragEnter(match.Id, CornerColor.Aka)"
                                                             @ondragleave="() => OnKumiteDragLeave(match.Id, CornerColor.Aka)"
                                                             @ondrop="() => OnKumiteDrop(match.Id, CornerColor.Aka)">
                                                            <span class="corner-indicator red"></span>
                                                            @if (canDragAka)
                                                            {
                                                                <span class="drag-handle" title="Glisser pour modifier le tirage">⠿</span>
                                                            }
                                                            <span class="name text-truncate">@match.AkaDisplayName</span>
                                                            <span class="score">
                                                                @(match.AkaIppon > 0 ? "IPPON" : (match.AkaWazaAri > 0 ? $"{match.AkaWazaAri} W" : ""))
                                                            </span>
                                                        </div>

                                                        <!-- SHIRO -->
                                                        <div class="fighter-row shiro @(match.WinnerCompetitorId == match.ShiroCompetitorId && match.Status == MatchStatus.Finished ? "winner fw-bold" : "") @(canDragShiro ? "draggable-slot" : "") @(isShiroHover ? "drop-target-hover" : "")"
                                                             draggable="@(canDragShiro ? "true" : "false")"
                                                             @ondragstart="() => OnKumiteDragStart(match.Id, CornerColor.Shiro)"
                                                             @ondragend="ResetDrag"
                                                             @ondragover="HandleDragOver"
                                                             @ondragover:preventDefault="true"
                                                             @ondragenter="() => OnKumiteDragEnter(match.Id, CornerColor.Shiro)"
                                                             @ondragleave="() => OnKumiteDragLeave(match.Id, CornerColor.Shiro)"
                                                             @ondrop="() => OnKumiteDrop(match.Id, CornerColor.Shiro)">
                                                            <span class="corner-indicator white"></span>
                                                            @if (canDragShiro)
                                                            {
                                                                <span class="drag-handle" title="Glisser pour modifier le tirage">⠿</span>
                                                            }
                                                            <span class="name text-truncate">@match.ShiroDisplayName</span>
                                                            <span class="score">
                                                                @(match.ShiroIppon > 0 ? "IPPON" : (match.ShiroWazaAri > 0 ? $"{match.ShiroWazaAri} W" : ""))
                                                            </span>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <!-- KATA DRAW ADJUSTMENT -->
                        <div class="card border-primary shadow-sm">
                            <div class="card-header bg-primary text-white py-2 d-flex justify-content-between align-items-center">
                                <h5 class="mb-0 fw-bold">Ordre de Passage Kata - 1er Tour (Éliminatoire)</h5>
                                <span class="badge bg-light text-dark">Glisser-déposer une ligne pour réordonner</span>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Ordre</th>
                                            <th>Compétiteur</th>
                                            <th>Club</th>
                                            <th>Tatami</th>
                                            <th>Statut</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var p in categoryKataPerformances.Where(x => x.Round == KataRound.Turn1).OrderBy(x => x.PerformanceOrder))
                                        {
                                            bool canDragKata = p.Status != MatchStatus.Finished;
                                            bool isKataHover = dragHoverTarget == $"admin_kata_{p.Id}";

                                            <tr class="@(canDragKata ? "draggable-row" : "") @(isKataHover ? "drop-target-hover" : "")"
                                                draggable="@(canDragKata ? "true" : "false")"
                                                @ondragstart="() => OnKataDragStart(p.Id)"
                                                @ondragend="ResetDrag"
                                                @ondragover="HandleDragOver"
                                                @ondragover:preventDefault="true"
                                                @ondragenter="() => OnKataDragEnter(p.Id)"
                                                @ondragleave="() => OnKataDragLeave(p.Id)"
                                                @ondrop="() => OnKataDrop(p.Id)">
                                                <td>
                                                    <div class="d-flex align-items-center gap-1">
                                                        @if (canDragKata)
                                                        {
                                                            <span class="drag-handle" title="Glisser pour modifier l'ordre">⠿</span>
                                                        }
                                                        <span class="badge bg-light text-dark border fs-6">#@p.PerformanceOrder</span>
                                                    </div>
                                                </td>
                                                <td><strong>@p.Competitor?.FullName</strong></td>
                                                <td>@p.Competitor?.Club</td>
                                                <td>
                                                    <select 
                                                        class="form-select form-select-sm py-0 px-2 border-primary" 
                                                        style="width: 100px;"
                                                        value="@p.TatamiId"
                                                        @onchange="(e) => OnChangeKataTatami(p.Id, e)"
                                                    >
                                                        @foreach (var t in tatamis)
                                                        {
                                                            <option value="@t.Id">@t.Name</option>
                                                        }
                                                    </select>
                                                </td>
                                                <td>
                                                    @if (p.Status == MatchStatus.Finished)
                                                    {
                                                        <span class="badge bg-success">Terminé (Note: @p.FinalScore.ToString("0"))</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-light text-dark border">En attente</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    }

    <!-- ========================================== -->
    <!-- TAB 2 : PLANNING & KANBAN TATAMIS          -->
    <!-- ========================================== -->
    @if (activeTab == "tatamis")
    {
        <!-- Configuration & Modification des Tatamis -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <h5 class="mb-0 fw-bold">⚙️ Gestion des tatamis</h5>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-warning fw-bold" @onclick="RebalanceAllTatamis">
                        ⚖️ Rééquilibrer les combats sur les tatamis
                    </button>
                </div>
            </div>

            <div class="card-body p-4 bg-light">
                <!-- Formulaire d'ajout de Tatami -->
                <div class="row g-2 align-items-center mb-4 bg-white p-3 rounded border">
                    <div class="col-md-4">
                        <label class="form-label small fw-bold mb-1">Nom du nouveau Tatami :</label>
                        <input type="text" class="form-control form-control-sm" placeholder="ex: Tatami 4, Tatami Principal..." @bind="newTatamiName" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold mb-1">Discipline autorisée :</label>
                        <select class="form-select form-select-sm" @bind="newTatamiDiscipline">
                            <option value="@CompetitionType.Kumite">Kumite</option>
                            <option value="@CompetitionType.Kata">Kata</option>
                            <option value="@CompetitionType.Both">Les deux (Kumite &amp; Kata)</option>
                        </select>
                    </div>
                    <div class="col-md-4 pt-md-4">
                        <button class="btn btn-primary btn-sm w-100 fw-bold" @onclick="HandleAddTatami">
                            ➕ Ajouter un Tatami
                        </button>
                    </div>
                </div>

                <!-- Liste des Tatamis existants avec options de modification -->
                <div class="table-responsive bg-white rounded border">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Nom du Tatami</th>
                                <th>Discipline</th>
                                <th>Matches</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in tatamis)
                            {
                                int mCount = allMatches.Count(m => m.TatamiId == t.Id && !m.IsBye);
                                int kCount = allKataPerformances.Count(p => p.TatamiId == t.Id);

                                <tr>
                                    <td><strong>#@t.Number</strong></td>
                                    <td>
                                        <input 
                                            type="text" class="form-control form-control-sm" 
                                            style="max-width: 250px;"
                                            value="@t.Name"
                                            @onchange="(e) => HandleUpdateTatamiName(t.Id, e)" 
                                        />
                                    </td>
                                    <td>
                                        <select 
                                            class="form-select form-select-sm" 
                                            style="max-width: 210px;"
                                            value="@t.Discipline"
                                            @onchange="(e) => HandleUpdateTatamiDiscipline(t.Id, e)"
                                        >
                                            <option value="@CompetitionType.Kumite">Kumite</option>
                                            <option value="@CompetitionType.Kata">Kata</option>
                                            <option value="@CompetitionType.Both">Les deux (Kumite & Kata)</option>
                                        </select>
                                    </td>
                                    <td>
                                        <div class="d-flex flex-wrap gap-1 align-items-center">
                                            <span class="badge bg-secondary">
                                                @(mCount + kCount) total (@mCount 🥊, @kCount 🥋)
                                            </span>
                                            @for (int d = 1; d <= tournamentDaysCount; d++)
                                            {
                                                int dayNum = d;
                                                int dm = allMatches.Count(m => m.TatamiId == t.Id && !m.IsBye && m.CompetitionDay == dayNum);
                                                int dk = allKataPerformances.Count(p => p.TatamiId == t.Id && p.CompetitionDay == dayNum);
                                                if (dm > 0 || dk > 0)
                                                {
                                                    <span class="badge bg-warning text-dark border">
                                                        📅 Jour @dayNum : @(dm + dk) (@dm 🥊, @dk 🥋)
                                                    </span>
                                                }
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <button 
                                            class="btn btn-sm btn-outline-danger" 
                                            disabled="@(tatamis.Count <= 1)"
                                            @onclick="() => HandleDeleteTatami(t.Id)" title="Supprimer ce tatami (ses combats seront réassignés)"
                                        >
                                            🗑️ Supprimer
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Kanban Board Multi-Tatamis -->
        <div class="card shadow-sm border-0 mb-4">
            <div 
                class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center flex-wrap gap-2 row"
                style="margin-right:0px;margin-left:0px;"
            >
                <div>
                    <h5 class="mb-0 fw-bold">🥋 Planning des Rencontres par tatami</h5>
                </div>
                <div class="d-flex gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <span class="small text-white-50">Filtrer par tatami :</span>
                        <div class="btn-group btn-group-sm">
                            <button 
                                class="btn @(selectedBoardTatamiFilter == 0 ? "btn-warning text-dark fw-bold" : "btn-outline-light")"
                                @onclick="() => selectedBoardTatamiFilter = 0"
                            >
                                Tous
                            </button>
                            @for (int d = 1; d <= tatamis.Count; d++)
                            {
                                int tatamiNum = d;
                                <button 
                                    class="btn @(selectedBoardTatamiFilter == tatamiNum ? "btn-warning text-dark fw-bold" : "btn-outline-light")"
                                    @onclick="() => selectedBoardTatamiFilter = tatamiNum"
                                >
                                    Tatami @tatamiNum
                                </button>
                            }
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="small text-white-50">Filtrer par jour :</span>
                        <div class="btn-group btn-group-sm">
                            <button 
                                class="btn @(selectedBoardDayFilter == 0 ? "btn-warning text-dark fw-bold" : "btn-outline-light")"
                                @onclick="() => selectedBoardDayFilter = 0"
                            >
                                Tous
                            </button>
                            @for (int d = 1; d <= tournamentDaysCount; d++)
                            {
                                int dayNum = d;
                                <button 
                                    class="btn @(selectedBoardDayFilter == dayNum ? "btn-warning text-dark fw-bold" : "btn-outline-light")"
                                    @onclick="() => selectedBoardDayFilter = dayNum"
                                >
                                    Jour @dayNum
                                </button>
                            }
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <input 
                            type="text" 
                            class="form-control form-control-sm" 
                            placeholder="Rechercher combattant, catégorie..."
                            @bind="encounterSearchFilter" 
                            @bind:event="oninput" 
                            style="width: 260px;" 
                        />
                    </div>
                </div>
            </div>

            <div class="card-body p-4 bg-light">
                <!-- Tableau complet des rencontres avec filtre -->
                <div class="card border-0 shadow-sm">
                    <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th>#</th>
                                    <th>📅 Jour</th>
                                    <th>Discipline</th>
                                    <th>Catégorie</th>
                                    <th>Tour</th>
                                    <th>Match</th>
                                    <th>Statut</th>
                                    <th style="width:120px;">Tatami</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var m in FilteredMatches)
                                {
                                    <tr class="@(m.IsBronzeMatch ? "table-warning-subtle" : "")">
                                        <td><strong>#@m.MatchNumber</strong></td>
                                        <td>
                                            <select 
                                                class="form-select form-select-sm fw-bold border-warning py-0" style="width: 110px;"
                                                value="@m.CompetitionDay"
                                                @onchange="(e) => HandleChangeMatchDay(m.Id, e)"
                                            >
                                                @for (int d = 1; d <= tournamentDaysCount; d++)
                                                {
                                                    <option value="@d">📅 Jour @d</option>
                                                }
                                            </select>
                                        </td>
                                        <td>
                                            <span class="badge bg-danger">Kumite</span>
                                            @if (m.IsBronzeMatch)
                                            {
                                                <span class="badge bg-warning text-dark ms-1">🥉 Petite Finale</span>
                                            }
                                        </td>
                                        <td><span class="badge bg-warning text-dark ms-1">@Lang[m.Category?.Name]</span></td>
                                        <td><span class="badge bg-warning text-dark ms-1">@Lang[m.RoundName]</span></td>
                                        <td class="d-flex row">
                                            <span class="text-danger fw-bold">🔴 @m.AkaDisplayName</span>
                                            <span class="fw-bold">⚪ @m.ShiroDisplayName</span>
                                        </td>
                                        <td>
                                            <span class="badge @(m.Status == MatchStatus.Finished ? "bg-success" : (m.Status == MatchStatus.InProgress ? "bg-primary" : "bg-light text-dark border"))">
                                                @Lang[m.Status.ToString()]
                                            </span>
                                        </td>
                                        <td>
                                            <select 
                                                class="form-select form-select-sm border-primary"
                                                value="@m.TatamiId"
                                                @onchange="(e) => OnChangeMatchTatami(m.Id, e)"
                                            >
                                                @foreach (var t in tatamis)
                                                {
                                                    <option value="@t.Id">@t.Name</option>
                                                }
                                            </select>
                                        </td>
                                    </tr>
                                }
                                @foreach (var p in FilteredKataPerformances)
                                {
                                    <tr>
                                        <td><strong>P#@p.PerformanceOrder</strong></td>
                                        <td>
                                            <select class="form-select form-select-sm fw-bold border-warning py-0" style="width: 90px;"
                                                    value="@p.CompetitionDay"
                                                    @onchange="(e) => HandleChangeKataDay(p.Id, e)">
                                                @for (int d = 1; d <= tournamentDaysCount; d++)
                                                {
                                                    <option value="@d">📅 J@d</option>
                                                }
                                            </select>
                                        </td>
                                        <td><span class="badge bg-primary">Kata</span></td>
                                        <td>@p.Category?.Name</td>
                                        <td>@p.Round</td>
                                        <td><strong>🥋 @p.CompetitorDisplayName</strong></td>
                                        <td>
                                            <span class="badge @(p.Status == MatchStatus.Finished ? "bg-success" : "bg-light text-dark border")">
                                                @p.Status
                                            </span>
                                        </td>
                                        <td>
                                            <select class="form-select form-select-sm border-primary"
                                                    value="@p.TatamiId"
                                                    @onchange="(e) => OnChangeKataTatami(p.Id, e)">
                                                @foreach (var t in tatamis)
                                                {
                                                    <option value="@t.Id">@t.Name</option>
                                                }
                                            </select>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- ========================================== -->
    <!-- TAB 3 : IMPORT EXCEL & CATÉGORIES          -->
    <!-- ========================================== -->
    @if (activeTab == "categories")
    {
        <!-- Excel Upload Card -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-dark text-white py-3">
                <h5 class="mb-0 fw-bold">📤 Import des Compétiteurs depuis un fichier Excel (.xlsx)</h5>
            </div>
            <div class="card-body p-4">
                <div class="row align-items-center">
                    <div class="col-md-7">
                        <div class="input-group">
                            <InputFile OnChange="HandleFileSelected" accept=".xlsx" class="form-control form-control-lg" />
                        </div>
                    </div>
                    <div class="col-md-5 text-center border-start ps-4">
                        <button class="btn btn-primary btn-lg w-100 fw-bold" @onclick="RegenerateDraws">
                            🎲 Régénérer tous les tirages
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Catégories & Paramètres Kyokushinkai -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-light py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div class="d-flex align-items-center gap-3 flex-wrap">
                    <h5 class="mb-0 fw-bold">🥋 Catégories de la compétition (@categories.Count)</h5>
                    <div class="d-flex align-items-center gap-2 bg-white px-2 py-1 rounded border">
                        <label class="small fw-bold mb-0 text-nowrap">📅 Durée totale :</label>
                        <select class="form-select form-select-sm py-0" style="width: auto;"
                                value="@tournamentDaysCount"
                                @onchange="HandleChangeTournamentDaysCount">
                            <option value="1">1 Jour</option>
                            <option value="2">2 Jours</option>
                            <option value="3">3 Jours</option>
                            <option value="4">4 Jours</option>
                        </select>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="small fw-bold text-muted">Filtrer par jour :</span>
                    <div class="btn-group btn-group-sm">
                        <button class="btn @(selectedDayFilter == 0 ? "btn-dark" : "btn-outline-secondary")"
                                @onclick="() => selectedDayFilter = 0">Tous</button>
                        @for (int d = 1; d <= tournamentDaysCount; d++)
                        {
                            int dayNum = d;
                            <button class="btn @(selectedDayFilter == dayNum ? "btn-primary" : "btn-outline-primary")"
                                    @onclick="() => selectedDayFilter = dayNum">
                                Jour @dayNum
                            </button>
                        }
                    </div>
                    <span class="badge bg-secondary ms-2">@competitors.Count compétiteur(s) inscrits</span>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="min-width: 110px;"># Ordre</th>
                            <th>Catégorie</th>
                            <th>Discipline</th>
                            <th>Jour</th>
                            <th>Tatami Assigné</th>
                            <th>Inscrits</th>
                            <th>Durée</th>
                            <th>Prolongation</th>
                            <th>Petite Finale</th>
                            <th>Katas (T1 / T2)</th>
                            <th>Qualifiés</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cat in categories.Where(c => selectedDayFilter == 0 || c.CompetitionDay == selectedDayFilter).OrderBy(c => c.CompetitionDay).ThenBy(c => c.OrderIndex).ThenBy(c => c.Name))
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-1">
                                        <input type="number" class="form-control form-control-sm text-center fw-bold border-primary" style="width: 55px;"
                                               value="@cat.OrderIndex"
                                               min="1"
                                               @onchange="(e) => HandleChangeCategoryOrder(cat.Id, e)"
                                               title="Modifier l'ordre de passage de cette catégorie" />
                                        <div class="btn-group-vertical btn-group-sm">
                                            <button class="btn btn-outline-secondary py-0 px-1" style="font-size: 0.65rem; line-height: 1;"
                                                    @onclick="() => HandleMoveCategoryOrder(cat.Id, -1)"
                                                    title="Faire passer plus tôt (Monter)">▲</button>
                                            <button class="btn btn-outline-secondary py-0 px-1" style="font-size: 0.65rem; line-height: 1;"
                                                    @onclick="() => HandleMoveCategoryOrder(cat.Id, 1)"
                                                    title="Faire passer plus tard (Descendre)">▼</button>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="badge bg-warning text-dark ms-1">@Lang[cat.Name]</span></td>
                                <td>
                                    <span class="badge @(cat.Type == CompetitionType.Kumite ? "bg-danger" : "bg-primary")">
                                        @cat.Type
                                    </span>
                                </td>
                                <td>
                                    <select 
                                        class="form-select form-select-sm fw-bold border-warning" 
                                        style="min-width: 105px;"
                                        value="@cat.CompetitionDay"
                                        @onchange="(e) => HandleChangeCategoryDay(cat.Id, e)"
                                    >
                                        @for (int d = 1; d <= tournamentDaysCount; d++)
                                        {
                                            <option value="@d">📅 Jour @d</option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    <select 
                                        class="form-select form-select-sm" 
                                        style="min-width: 145px;"
                                        value="@(cat.AssignedTatamiId ?? -1)"
                                        @onchange="(e) => HandleChangeCategoryTatami(cat.Id, e)"
                                    >
                                        <option value="-1">🚫 Aucun tatami</option>
                                        @foreach (var t in tatamis)
                                        {
                                            <option value="@t.Id">🥋 @t.Name</option>
                                        }
                                    </select>
                                </td>
                                <td><span class="badge bg-light text-dark border">@cat.Competitors.Count inscrits</span></td>
                                <td>
                                    @if (cat.Type == CompetitionType.Kumite)
                                    {
                                        <input type="number" class="form-control form-control-sm text-center" style="width: 80px;"
                                               @bind="cat.KumiteRegularDurationSeconds" />
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (cat.Type == CompetitionType.Kumite)
                                    {
                                        <input type="number" class="form-control form-control-sm text-center" style="width: 80px;"
                                               @bind="cat.KumiteExtensionDurationSeconds" />
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (cat.Type == CompetitionType.Kumite)
                                    {
                                        <div class="form-check form-switch d-flex justify-content-center">
                                            <input class="form-check-input" type="checkbox"
                                                   checked="@cat.HasBronzeMatch"
                                                   @onchange="(e) => ToggleCategoryBronzeMatch(cat.Id, e)"
                                                   title="Activer la petite finale pour la 3e place" />
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (cat.Type == CompetitionType.Kata)
                                    {
                                        <div class="input-group input-group-sm">
                                            <input type="text" class="form-control" title="Kata Tour 1" @bind="cat.KataRound1MandatoryKata" placeholder="Kata Tour 1" />
                                            <span class="input-group-text">/</span>
                                            <input type="text" class="form-control" title="Kata Tour 2" @bind="cat.KataRound2MandatoryKata" placeholder="Kata Tour 2" />
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (cat.Type == CompetitionType.Kata)
                                    {
                                        <input type="number" class="form-control form-control-sm text-center" style="width: 70px;"
                                               min="1" max="32"
                                               value="@cat.KataQualifiersCount"
                                               @onchange="(e) => HandleChangeKataQualifiersCount(cat.Id, e)"
                                               title="Nombre de qualifiés pour le Tour 2" />
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => RegenerateCategory(cat.Id)">
                                        Tirage
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- ========================================== -->
    <!-- TAB 4 : LISTE DES COMPÉTITEURS            -->
    <!-- ========================================== -->
    @if (activeTab == "competitors")
    {
        <div class="card shadow-sm border-0">
            <div class="card-header bg-light py-3">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                    <h5 class="mb-0 fw-bold">👥 Liste des Compétiteurs Inscrits (@FilteredCompetitors.Count() / @competitors.Count)</h5>
                    <button class="btn btn-sm btn-primary" @onclick="OpenAddCompetitorModal">
                        ➕ Nouveau Compétiteur
                    </button>
                </div>
                <div class="row g-2 align-items-center">
                    <div class="col-md-4 col-sm-6">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white">🔍</span>
                            <input 
                                type="text" 
                                class="form-control" 
                                placeholder="Rechercher (nom, dossard, club, pays...)..."
                                @bind="competitorFilter" 
                                @bind:event="oninput" 
                            />
                            @if (!string.IsNullOrEmpty(competitorFilter))
                            {
                                <button class="btn btn-outline-secondary" @onclick="() => competitorFilter = string.Empty">✕</button>
                            }
                        </div>
                    </div>
                    <div class="col-md-4 col-sm-6">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white">📂 Catégorie</span>
                            <select 
                                class="form-select" 
                                @bind="selectedCompetitorCategoryFilter"
                            >
                                <option value="0">Toutes les catégories (@categories.Count)</option>
                                @foreach (var cat in categories.OrderBy(c => c.CompetitionDay).ThenBy(c => c.OrderIndex).ThenBy(c => c.Name))
                                {
                                    <option value="@cat.Id">
                                        [J@(cat.CompetitionDay)] @(cat.Type == CompetitionType.Kumite ? "🥊" : "🥋") @cat.Name (@cat.Competitors.Count inscrits)
                                    </option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-2 col-sm-6">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white">Discipline</span>
                            <select 
                                class="form-select" 
                                @bind="selectedCompetitorDisciplineFilter"
                            >
                                <option value="all">Toutes</option>
                                <option value="kumite">🥊 Kumité</option>
                                <option value="kata">🥋 Kata</option>
                                <option value="both">🥊+🥋 Les deux</option>
                            </select>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(competitorFilter) || selectedCompetitorCategoryFilter != 0 || selectedCompetitorDisciplineFilter != "all")
                    {
                        <div class="col-auto">
                            <button class="btn btn-sm btn-outline-secondary" @onclick="ResetCompetitorFilters">
                                Réinitialiser filtres
                            </button>
                        </div>
                    }
                </div>
            </div>
            <div class="table-responsive" style="max-height: 550px; overflow-y: auto;">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light sticky-top">
                        <tr>
                            <th>Dossard</th>
                            <th>Nom &amp; Prénom</th>
                            <th>Pays</th>
                            <th>Club / Dojo</th>
                            <th>Sexe</th>
                            <th>Âge</th>
                            <th>Grade</th>
                            <th>Poids</th>
                            <th>Disciplines</th>
                            <th>Catégories</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in FilteredCompetitors)
                        {
                            var compCats = categories
                                .Where(cat => cat.Competitors.Any(comp => comp.Id == c.Id) || c.Categories.Any(cat2 => cat2.Id == cat.Id))
                                .ToList();
                            <tr>
                                <td>
                                    <span class="badge bg-warning text-dark fw-bold px-2 py-1">
                                        @(c.BibNumber.HasValue ? $"#{c.BibNumber.Value}" : $"-")
                                    </span>
                                </td>
                                <td><strong>@c.FullName</strong></td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        <img 
                                            src="@c.FlagImageUrl" 
                                            alt="" 
                                            style="width: 16px; height: 11px; margin-right: 4px; vertical-align: middle;" 
                                        />
                                    </span>
                                </td>
                                <td>@c.Club</td>
                                <td>@(c.Gender == Gender.Female ? "Femme" : "Homme")</td>
                                <td>
                                    @c.Age ans
                                    @if (c.BirthDate.HasValue)
                                    {
                                        <div class="text-muted small">@c.BirthDate.Value.ToString("dd/MM/yyyy")</div>
                                    }
                                </td>
                                <td><span class="badge bg-secondary">@c.GradeName</span></td>
                                <td style="white-space:nowrap;">@c.Weight kg</td>
                                <td>
                                    @if (c.IsKumiteRegistered)
                                    {
                                        <span class="badge bg-danger me-1">Kumite</span>
                                    }
                                    @if (c.IsKataRegistered)
                                    {
                                        <span class="badge bg-primary">Kata</span>
                                    }
                                </td>
                                <td>
                                    @if (compCats.Count > 0)
                                    {
                                        @foreach (var cat in compCats)
                                        {
                                            <span class="badge @(cat.Type == CompetitionType.Kumite ? "bg-danger" : "bg-primary") me-1 small">
                                                @cat.Name
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Aucune</span>
                                    }
                                </td>
                                <td class="text-end text-nowrap">
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenEditCompetitorModal(c)">
                                        ✏️ Modifier
