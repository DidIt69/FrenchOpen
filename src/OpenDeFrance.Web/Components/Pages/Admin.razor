    private IEnumerable<Competitor> FilteredCompetitors
    {
        get
        {
            var result = competitors.AsEnumerable();

            if (selectedCompetitorCategoryFilter > 0)
            {
                result = result.Where(c =>
                    c.Categories.Any(cat => cat.Id == selectedCompetitorCategoryFilter) ||
                    categories.Any(cat => cat.Id == selectedCompetitorCategoryFilter && cat.Competitors.Any(comp => comp.Id == c.Id)));
            }

            if (selectedCompetitorDisciplineFilter == "kumite")
            {
                result = result.Where(c => c.IsKumiteRegistered);
            }
            else if (selectedCompetitorDisciplineFilter == "kata")
            {
                result = result.Where(c => c.IsKataRegistered);
            }
            else if (selectedCompetitorDisciplineFilter == "both")
            {
                result = result.Where(c => c.IsKumiteRegistered && c.IsKataRegistered);
            }

            if (!string.IsNullOrWhiteSpace(competitorFilter))
            {
                string term = competitorFilter.Trim().ToLowerInvariant();
                result = result.Where(c =>
                    c.FullName.ToLowerInvariant().Contains(term) ||
                    (c.BibNumber.HasValue && c.BibNumber.Value.ToString().Contains(term)) ||
                    c.Country.ToLowerInvariant().Contains(term) ||
                    c.Club.ToLowerInvariant().Contains(term) ||
                    c.Grade.ToString().ToLowerInvariant().Contains(term) ||
                    Competitor.GetGradeName(c.Grade).ToLowerInvariant().Contains(term) ||
                    c.Categories.Any(cat => cat.Name.ToLowerInvariant().Contains(term)) ||
                    categories.Any(cat => cat.Competitors.Any(comp => comp.Id == c.Id) && cat.Name.ToLowerInvariant().Contains(term)));
            }

            return result;
        }
    }

    private IEnumerable<KumiteMatch> FilteredMatches
    {
        get
        {
            var list = allMatches.Where(m => !m.IsBye && (selectedBoardDayFilter == 0 || m.CompetitionDay == selectedBoardDayFilter) && (selectedBoardTatamiFilter == 0 || m.Tatami.Number == selectedBoardTatamiFilter));

            if (string.IsNullOrWhiteSpace(encounterSearchFilter)) 
                return list;
            
            string term = encounterSearchFilter.Trim().ToLowerInvariant();
            
            return list.Where(m =>
                m.AkaDisplayName.ToLowerInvariant().Contains(term) ||
                m.ShiroDisplayName.ToLowerInvariant().Contains(term) ||
                (m.Category?.Name.ToLowerInvariant().Contains(term) ?? false) ||
                m.MatchNumber.ToString().Contains(term));
        }
    }

    private IEnumerable<KataPerformance> FilteredKataPerformances
    {
        get
        {
            var list = allKataPerformances.Where(p => selectedEncounterDayFilter == 0 || p.CompetitionDay == selectedEncounterDayFilter);
            if (string.IsNullOrWhiteSpace(encounterSearchFilter)) return list;
            string term = encounterSearchFilter.Trim().ToLowerInvariant();
            return list.Where(p =>
                p.CompetitorDisplayName.ToLowerInvariant().Contains(term) ||
                (p.Category?.Name.ToLowerInvariant().Contains(term) ?? false) ||
                p.PerformanceOrder.ToString().Contains(term));
        }
    }

    public void Dispose()
    {
        TournamentService.OnStateChanged -= HandleStateChanged;
        Lang.OnLanguageChanged -= HandleLanguageChanged;
    }
