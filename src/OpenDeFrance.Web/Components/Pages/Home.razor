                                    }
                                    <strong class="text-danger">@item.AkaName</strong>
                                    @if (!string.IsNullOrWhiteSpace(item.AkaClub) || !string.IsNullOrWhiteSpace(item.AkaGrade))
                                    {
                                        <small class="text-muted" style="font-size: 0.75rem;">(@string.Join(" • ", new[] { item.AkaClub, item.AkaGrade }.Where(s => !string.IsNullOrWhiteSpace(s))))</small>
                                    }
                                </div>

                                <!-- Ligne SHIRO -->
                                <div class="d-flex align-items-center gap-1 mb-1 flex-wrap ms-1">
                                    <span class="badge bg-white border border-secondary p-0 me-1 flex-shrink-0" style="width: 8px; height: 8px; border-radius: 50%; display: inline-block;"></span>
                                    @if (!string.IsNullOrEmpty(item.ShiroFlagUrl))
                                    {
                                        <img src="@item.ShiroFlagUrl" alt="@item.ShiroCountry" title="@item.ShiroCountry"
                                             class="border rounded-1 flex-shrink-0" style="width: 16px; height: 11px; object-fit: cover;" />
                                    }
                                    <strong>@item.ShiroName</strong>
                                    @if (!string.IsNullOrWhiteSpace(item.ShiroClub) || !string.IsNullOrWhiteSpace(item.ShiroGrade))
                                    {
                                        <small class="text-muted" style="font-size: 0.75rem;">(@string.Join(" • ", new[] { item.ShiroClub, item.ShiroGrade }.Where(s => !string.IsNullOrWhiteSpace(s))))</small>
                                    }
                                </div>
                            }

                            <!-- Ligne 3 : Catégorie et Score / Vainqueur -->
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center gap-1 flex-wrap">
                                    <span class="badge bg-light text-dark border" style="cursor: pointer; font-size: 0.7rem;"
                                          title="Filtrer uniquement sur cette catégorie"
                                          @onclick="() => FilterSingleCategory(item.CategoryId)">
                                        @Lang[item.CategoryName]
                                    </span>
                                    @if (item.IsKata && (!string.IsNullOrWhiteSpace(item.Notes) || !string.IsNullOrWhiteSpace(item.Score)))
                                    {
                                        <small class="text-muted">@item.Notes @item.Score</small>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(item.WinnerInfo))
                                {
                                    <small class="text-success fw-bold ms-1">🏆 @item.WinnerInfo</small>
                                }
                            </div>
                        </div>

                        <!-- === MODE DESKTOP (>= 768px) : colonnes alignées === -->
                        <div class="d-none d-md-block">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <div class="flex-grow-1" style="min-width: 0;">
                                    @if (item.IsKata)
                                    {
                                        <div class="d-flex align-items-center gap-1 flex-wrap">
                                            <span class="badge bg-info text-dark me-1 flex-shrink-0">#@item.Number</span>
                                            <span class="badge bg-primary me-1 flex-shrink-0" style="font-size:0.65rem;">KATA</span>
                                            @if (!string.IsNullOrEmpty(item.KataFlagUrl))
                                            {
                                                <img src="@item.KataFlagUrl" alt="@item.KataCountry" title="@item.KataCountry"
                                                     class="border rounded-1 me-1 flex-shrink-0" style="width: 18px; height: 12px; object-fit: cover;" />
                                            }
                                            <strong class="text-truncate me-1">@item.KataCompetitorName</strong>
                                            @if (!string.IsNullOrWhiteSpace(item.KataClub) || !string.IsNullOrWhiteSpace(item.KataGrade))
                                            {
                                                <small class="text-muted text-truncate me-2" style="font-size: 0.8rem;">(@string.Join(" • ", new[] { item.KataClub, item.KataGrade }.Where(s => !string.IsNullOrWhiteSpace(s))))</small>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <!-- Ligne 1 : Badge -->
                                        <div class="d-flex align-items-center gap-1 flex-wrap mb-1">
                                            <span class="badge bg-secondary me-1 flex-shrink-0">#@item.Number</span>
                                            <span class="badge bg-danger me-1 flex-shrink-0" style="font-size:0.65rem;">KUMITÉ</span>
                                        </div>

                                        <!-- Ligne 2 : AKA -->
                                        <div class="d-flex align-items-center gap-1 flex-wrap mb-1">
                                            <span class="badge bg-danger p-0 me-1 flex-shrink-0" style="width: 8px; height: 8px; border-radius: 50%; display: inline-block;"></span>
                                            @if (!string.IsNullOrEmpty(item.AkaFlagUrl))
                                            {
                                                <img 
                                                    src="@item.AkaFlagUrl" 
                                                    alt="@item.AkaCountry" 
                                                    title="@item.AkaCountry"
                                                    class="border rounded-1 me-1 flex-shrink-0" style="width: 18px; height: 12px; object-fit: cover;" 
                                                />
                                            }
                                            <strong class="text-danger text-truncate me-1">@item.AkaName</strong>
                                            @if (!string.IsNullOrWhiteSpace(item.AkaClub) || !string.IsNullOrWhiteSpace(item.AkaGrade))
                                            {
                                                <small class="text-muted text-truncate me-2" style="font-size: 0.8rem;">(@string.Join(" • ", new[] { item.AkaClub, item.AkaGrade }.Where(s => !string.IsNullOrWhiteSpace(s))))</small>
                                            }
                                        </div>

                                        <!-- Ligne 3 : SHIRO sur sa propre ligne -->
                                        <div class="d-flex align-items-center gap-1 flex-wrap ms-1">
                                            <span class="badge bg-white border border-secondary p-0 me-1 flex-shrink-0" style="width: 8px; height: 8px; border-radius: 50%; display: inline-block;"></span>
                                            @if (!string.IsNullOrEmpty(item.ShiroFlagUrl))
                                            {
                                                <img src="@item.ShiroFlagUrl" alt="@item.ShiroCountry" title="@item.ShiroCountry"
                                                     class="border rounded-1 me-1 flex-shrink-0" style="width: 18px; height: 12px; object-fit: cover;" />
                                            }
                                            <strong class="text-truncate me-1">@item.ShiroName</strong>
                                            @if (!string.IsNullOrWhiteSpace(item.ShiroClub) || !string.IsNullOrWhiteSpace(item.ShiroGrade))
                                            {
                                                <small class="text-muted text-truncate" style="font-size: 0.8rem;">(@string.Join(" • ", new[] { item.ShiroClub, item.ShiroGrade }.Where(s => !string.IsNullOrWhiteSpace(s))))</small>
                                            }
                                        </div>
                                    }
                                </div>
                                <!-- Colonne Statut alignée sur la 1ère ligne -->
                                <div style="width: 80px;" class="text-center flex-shrink-0 ms-auto">
                                    @if (isInProgress)
                                    {
                                        <span class="badge bg-success w-100" style="font-size:0.7rem;">@Lang["InProgress"]</span>
                                    }
                                    else if (isFinished)
                                    {
                                        <span class="badge bg-dark w-100" style="font-size:0.7rem;">@Lang["Finished"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary w-100" style="font-size:0.7rem;">@Lang["Coming"]</span>
                                    }
                                </div>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-1">
                                <div class="d-flex align-items-center gap-2 flex-grow-1 text-truncate">
                                    <small class="text-muted text-truncate">
                                        <span class="badge bg-light text-dark border me-1" style="cursor: pointer; font-size: 0.7rem;"
                                              title="Filtrer uniquement sur cette catégorie"
                                              @onclick="() => FilterSingleCategory(item.CategoryId)">
                                            @Lang[item.CategoryName]
                                        </span>
                                        @if (item.IsKata && (!string.IsNullOrWhiteSpace(item.Notes) || !string.IsNullOrWhiteSpace(item.Score)))
                                        {
                                            <span>• @item.Notes @item.Score</span>
                                        }
                                    </small>
                                    @if (!string.IsNullOrWhiteSpace(item.WinnerInfo))
                                    {
                                        <small class="text-success fw-bold text-truncate">🏆 @item.WinnerInfo</small>
                                    }
                                </div>
                                <!-- Colonnes Tatami et Tour alignées sur la 2nde ligne -->
                                <div class="d-flex align-items-center gap-1 gap-md-2 flex-shrink-0 ms-auto">
                                    <div style="width: 75px;" class="text-center">
                                        @if (!string.IsNullOrWhiteSpace(item.TatamiName))
                                        {
                                            <span class="badge bg-secondary w-100 text-truncate" title="@item.TatamiName" style="font-size:0.7rem;">@item.TatamiName</span>
                                        }
                                    </div>
                                    <div style="width: 80px;" class="text-center">
                                        <span class="badge bg-light text-dark border w-100 text-truncate" title="@item.RoundName" style="font-size:0.7rem;">@item.RoundName</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </li>
                }
            </ul>
        }
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "tatami")]
    public int? QueryTatamiId { get; set; }

    private List<Tatami> tatamis = new();
    private List<Category> categories = new();
    private List<Competitor> allCompetitors = new();
    private List<KumiteMatch> allMatches = new();
    private List<KataPerformance> allKatas = new();
    private int? activeDay = null; // Jour actif défini par l'admin (null = tous)
    private string searchTerm = string.Empty;
    private string disciplineFilter = "all";
    private bool hideFinished = true;
    private HashSet<int> selectedTatamiIds = new();
    private HashSet<int> selectedCategoryIds = new();
    private bool isCategoryDropdownOpen = false;
    private string categorySearchTerm = string.Empty;

    public class ScheduleItem
    {
        public int Id { get; set; }
        public int Number { get; set; }
        public int? TatamiId { get; set; }
        public int CategoryId { get; set; }
        public bool IsKata { get; set; }
        public string TatamiName { get; set; } = string.Empty;
        public string CategoryName { get; set; } = string.Empty;
        public string RoundName { get; set; } = string.Empty;
        public string KataCompetitorName { get; set; } = string.Empty;
        public string? KataFlagUrl { get; set; }
        public string? KataCountry { get; set; }
        public string? KataClub { get; set; }
        public string? KataGrade { get; set; }
        public string KataName { get; set; } = string.Empty;
        public string AkaName { get; set; } = string.Empty;
        public string? AkaFlagUrl { get; set; }
        public string? AkaCountry { get; set; }
        public string? AkaClub { get; set; }
        public string? AkaGrade { get; set; }
        public string ShiroName { get; set; } = string.Empty;
        public string? ShiroFlagUrl { get; set; }
        public string? ShiroCountry { get; set; }
        public string? ShiroClub { get; set; }
        public string? ShiroGrade { get; set; }
        public string WinnerInfo { get; set; } = string.Empty;
        public int DurationSeconds { get; set; }
        public MatchStatus Status { get; set; }
        public bool IsCurrentOnTatami { get; set; }
        public string Score { get; set; } = string.Empty;
        public string Notes { get; set; } = string.Empty;
    }

    protected override void OnParametersSet()
    {
        if (QueryTatamiId.HasValue && tatamis.Any(t => t.Id == QueryTatamiId.Value))
        {
            selectedTatamiIds.Clear();
            selectedTatamiIds.Add(QueryTatamiId.Value);
        }
    }

    private void SelectAllTatamis()
    {
        selectedTatamiIds.Clear();
    }

    private void ToggleTatamiSelection(int tatamiId)
    {
        if (selectedTatamiIds.Contains(tatamiId))
        {
            selectedTatamiIds.Remove(tatamiId);
        }
        else
        {
            selectedTatamiIds.Add(tatamiId);
        }
    }

    private void ToggleCategoryDropdown()
    {
        isCategoryDropdownOpen = !isCategoryDropdownOpen;
    }

    private void CloseCategoryDropdown()
    {
        isCategoryDropdownOpen = false;
    }

    private void ToggleCategorySelection(int categoryId)
    {
        if (selectedCategoryIds.Contains(categoryId))
        {
            selectedCategoryIds.Remove(categoryId);
        }
        else
        {
            selectedCategoryIds.Add(categoryId);
        }
    }

    private void FilterSingleCategory(int categoryId)
    {
        selectedCategoryIds.Clear();
        selectedCategoryIds.Add(categoryId);
    }

    private void SelectAllCategories()
    {
        foreach (var cat in FilteredCategoryChoices)
        {
            selectedCategoryIds.Add(cat.Id);
        }
    }

    private void ClearCategorySelection()
    {
        selectedCategoryIds.Clear();
    }

    private void ResetAllProgramFilters()
    {
        selectedCategoryIds.Clear();
        selectedTatamiIds.Clear();
        searchTerm = string.Empty;
        disciplineFilter = "all";
        hideFinished = true;
    }

    private int GetFinishedCount() =>
        allMatches.Count(m => !m.IsBye && m.Status == MatchStatus.Finished) + allKatas.Count(k => k.Status == MatchStatus.Finished);

    private int GetCategoryCompetitorCount(Category cat)
    {
        int count = cat.Competitors != null ? cat.Competitors.Count : 0;
        if (count > 0) return count;

        int fromAll = allCompetitors.Count(c => c.Categories != null && c.Categories.Any(cat2 => cat2.Id == cat.Id));
        if (fromAll > 0) return fromAll;

        int fromKatas = allKatas.Where(k => k.CategoryId == cat.Id && k.CompetitorId.HasValue).Select(k => k.CompetitorId!.Value).Distinct().Count();
        if (fromKatas > 0) return fromKatas;

        var akaIds = allMatches.Where(m => m.CategoryId == cat.Id && m.AkaCompetitorId.HasValue).Select(m => m.AkaCompetitorId!.Value);
        var shiroIds = allMatches.Where(m => m.CategoryId == cat.Id && m.ShiroCompetitorId.HasValue).Select(m => m.ShiroCompetitorId!.Value);
        return akaIds.Concat(shiroIds).Distinct().Count();
    }

    private int GetCategoryItemCount(int catId) =>
        allMatches.Count(m => m.CategoryId == catId && !m.IsBye) + allKatas.Count(k => k.CategoryId == catId);

    private bool IsCategoryFinished(Category cat)
    {
        var matches = allMatches.Where(m => m.CategoryId == cat.Id && !m.IsBye).ToList();
        var katas = allKatas.Where(k => k.CategoryId == cat.Id).ToList();
        int total = matches.Count + katas.Count;
        if (total == 0) return false;
        int finished = matches.Count(m => m.Status == MatchStatus.Finished)
                     + katas.Count(k => k.Status == MatchStatus.Finished);
        return finished == total;
    }

    private IEnumerable<Category> FilteredCategoryChoices
    {
        get
        {
            var list = categories.Where(c => GetCategoryCompetitorCount(c) > 0);

            // Filtre jour actif
            if (activeDay.HasValue)
            {
                list = list.Where(c => c.CompetitionDay == activeDay.Value);
            }

            if (disciplineFilter == "kata")
            {
                list = list.Where(c => c.Type == CompetitionType.Kata);
            }
            else if (disciplineFilter == "kumite")
            {
                list = list.Where(c => c.Type == CompetitionType.Kumite);
            }

            if (!string.IsNullOrWhiteSpace(categorySearchTerm))
            {
                string term = categorySearchTerm.Trim().ToLowerInvariant();
                list = list.Where(c => c.Name.ToLowerInvariant().Contains(term));
            }

            return list.OrderBy(c => c.CompetitionDay).ThenBy(c => c.OrderIndex).ThenBy(c => c.Name);
        }
    }

    private IEnumerable<Tatami> DisplayedTatamis =>
        selectedTatamiIds.Count == 0
            ? tatamis
            : tatamis.Where(t => selectedTatamiIds.Contains(t.Id));

    private string GetTatamiColClass()
    {
        int count = DisplayedTatamis.Count();
        if (count == 1) return "col-lg-6 col-md-8 mx-auto";
        if (count == 2) return "col-lg-6 col-md-6";
        return "col-lg-4 col-md-6";
    }

    protected override void OnInitialized()
    {
        RefreshData();
        TournamentService.OnStateChanged += HandleStateChanged;
        Lang.OnLanguageChanged += HandleLanguageChanged;
    }

    private void RefreshData()
    {
        tatamis = TournamentService.GetTatamis();
        categories = TournamentService.GetCategories();
        allMatches = TournamentService.GetMatches();
        allKatas = TournamentService.GetKataPerformances();
        allCompetitors = TournamentService.GetCompetitors();
        activeDay = TournamentService.GetTournament().ActiveDay;
    }

    private async void HandleStateChanged()
    {
        RefreshData();
        await InvokeAsync(StateHasChanged);
    }

    private IEnumerable<ScheduleItem> UnifiedSchedule
    {
        get
        {
            var items = new List<ScheduleItem>();

            // Katas
            if (disciplineFilter != "kumite")
            {
                foreach (var k in allKatas)
                {
                    // Filtre jour actif
                    if (activeDay.HasValue && k.CompetitionDay != activeDay.Value) continue;

                    int? tatamiId = k.TatamiId ?? k.Category?.AssignedTatamiId;
                    if (selectedTatamiIds.Count > 0 && (!tatamiId.HasValue || !selectedTatamiIds.Contains(tatamiId.Value)))
                    {
                        continue;
                    }

                    if (selectedCategoryIds.Count > 0 && !selectedCategoryIds.Contains(k.CategoryId))
                    {
                        continue;
                    }

                    var tatami = tatamis.FirstOrDefault(t => t.Id == tatamiId);
                    string tName = k.Tatami?.Name ?? tatami?.Name ?? (tatamiId.HasValue ? $"Tatami {tatamiId}" : "-");

                    bool isCurrent = tatami != null
                        && tatami.CurrentDiscipline == CompetitionType.Kata
                        && tatami.CurrentKataPerformanceId == k.Id
                        && k.Status != MatchStatus.Finished;

                    items.Add(new ScheduleItem
                    {
                        Id = k.Id,
                        Number = k.PerformanceOrder,
                        TatamiId = tatamiId,
                        CategoryId = k.CategoryId,
                        IsKata = true,
                        TatamiName = tName,
                        CategoryName = k.Category?.Name ?? "Kata",
                        RoundName = k.Round == KataRound.Turn1 ? Lang["Turn1"] : Lang["Turn2"],
                        KataCompetitorName = k.CompetitorDisplayName,
                        KataFlagUrl = k.Competitor?.FlagImageUrl,
                        KataCountry = k.Competitor?.Country,
                        KataClub = k.Competitor?.Club,
                        KataGrade = k.Competitor?.GradeName,
                        KataName = k.KataName,
                        Status = k.Status,
                        IsCurrentOnTatami = isCurrent,
                        Score = k.FinalScore.ToString(),
                        Notes = k.GetScoresDisplay(Lang)
                    });
                }
            }

            // Kumité
            if (disciplineFilter != "kata")
            {
                foreach (var m in allMatches.Where(m => !m.IsBye))
                {
                    // Filtre jour actif
                    if (activeDay.HasValue && m.CompetitionDay != activeDay.Value) continue;

                    int? tatamiId = m.TatamiId ?? m.Category?.AssignedTatamiId;
                    if (selectedTatamiIds.Count > 0 && (!tatamiId.HasValue || !selectedTatamiIds.Contains(tatamiId.Value)))
                    {
                        continue;
                    }

                    if (selectedCategoryIds.Count > 0 && !selectedCategoryIds.Contains(m.CategoryId))
                    {
                        continue;
                    }

                    var tatami = tatamis.FirstOrDefault(t => t.Id == tatamiId);
                    string tName = m.Tatami?.Name ?? tatami?.Name ?? (tatamiId.HasValue ? $"Tatami {tatamiId}" : "-");

                    bool isCurrent = tatami != null
                        && tatami.CurrentDiscipline == CompetitionType.Kumite
                        && tatami.CurrentKumiteMatchId == m.Id
                        && m.Status != MatchStatus.Finished;

                    items.Add(new ScheduleItem
                    {
                        Id = m.Id,
                        Number = m.MatchNumber,
                        TatamiId = tatamiId,
                        CategoryId = m.CategoryId,
                        IsKata = false,
                        TatamiName = tName,
                        CategoryName = m.Category?.Name ?? "Kumité",
                        RoundName = m.RoundName,
                        AkaName = m.AkaDisplayName,
                        AkaFlagUrl = m.AkaCompetitor?.FlagImageUrl,
                        AkaCountry = m.AkaCompetitor?.Country,
                        AkaClub = m.AkaCompetitor?.Club,
                        AkaGrade = m.AkaCompetitor?.GradeName,
                        ShiroName = m.ShiroDisplayName,
                        ShiroFlagUrl = m.ShiroCompetitor?.FlagImageUrl,
                        ShiroCountry = m.ShiroCompetitor?.Country,
                        ShiroClub = m.ShiroCompetitor?.Club,
                        ShiroGrade = m.ShiroCompetitor?.GradeName,
                        DurationSeconds = m.TotalDurationSeconds,
                        WinnerInfo = m.WinnerCompetitor != null ? m.WinnerCompetitor.FullName : "",
                        Status = m.Status,
                        IsCurrentOnTatami = isCurrent
                    });
                }
            }

            // Recherche et filtres de statut
            var query = items.AsEnumerable();

            if (hideFinished)
            {
                query = query.Where(i => i.Status != MatchStatus.Finished);
            }

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                string term = searchTerm.Trim().ToLowerInvariant();
                query = query.Where(i =>
                    i.CategoryName.ToLowerInvariant().Contains(term) ||
                    i.KataCompetitorName.ToLowerInvariant().Contains(term) ||
                    (i.KataClub != null && i.KataClub.ToLowerInvariant().Contains(term)) ||
                    i.AkaName.ToLowerInvariant().Contains(term) ||
                    (i.AkaClub != null && i.AkaClub.ToLowerInvariant().Contains(term)) ||
                    i.ShiroName.ToLowerInvariant().Contains(term) ||
                    (i.ShiroClub != null && i.ShiroClub.ToLowerInvariant().Contains(term)) ||
                    i.RoundName.ToLowerInvariant().Contains(term));
            }

            return query.OrderBy(i => i.Number);
        }
    }

    private async void HandleLanguageChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            await JS.InvokeVoidAsync("autoScrollManager.update");
        }
        catch { }
    }

    private string FormatSeconds(int seconds)
    {
        int m = seconds / 60;
        int s = seconds % 60;
        return $"{m:00}:{s:00}";
    }

    public void Dispose()
    {
        TournamentService.OnStateChanged -= HandleStateChanged;
        Lang.OnLanguageChanged -= HandleLanguageChanged;
    }
}
