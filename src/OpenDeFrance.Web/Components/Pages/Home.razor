@page "/"
@page "/live"
@rendermode InteractiveServer
@inject ITournamentService TournamentService
@inject IJSRuntime JS
@inject ILanguageService Lang
@inject UserPreferencesService Preferences
@implements IDisposable

<PageTitle>Open de France 2027</PageTitle>

<div class="container-fluid py-3">
    <!-- Top Hero Banner -->
    <div class="p-3 mb-4 rounded-3 text-white shadow" style="background: linear-gradient(135deg, #1b2838 0%, #0d121d 100%); border-left: 5px solid #ffc107;">
        <div class="d-flex flex-row align-items-center justify-content-between flex-wrap gap-2">
            <div>
                <h1 class="h3 fw-bold mb-0 fs-4">🥋 @Lang["FrenchOpen2027"]</h1>
            </div>
            <div class="d-flex align-items-center gap-2">
                <label for="tatamiSelect" class="form-label text-warning mb-0 fw-bold small text-nowrap d-none d-sm-inline">
                    🥋 @Lang["Tatami"] :
                </label>
                <select id="tatamiSelect" class="form-select form-select-sm bg-dark text-white border-secondary fw-semibold shadow-sm"
                        style="min-width: 170px; max-width: 240px; cursor: pointer;"
                        value="@selectedTatamiId"
                        @onchange="OnTatamiSelectChanged">
                    <option value="0">🌐 @Lang["AllTatamis"]</option>
                    @foreach (var t in tatamis)
                    {
                        <option value="@t.Id">@t.Name</option>
                    }
                </select>
            </div>
        </div>
    </div>

    <!-- Multi-Tatamis Live Grid -->
    @if (!DisplayedTatamis.Any())
    {
        <div class="alert alert-info text-center py-4 mb-5 shadow-sm">
            <em>Aucun tatami sélectionné ou disponible.</em>
            <div class="mt-2">
                <button class="btn btn-sm btn-primary" @onclick="SelectAllTatamis">@Lang["AllTatamis"]</button>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4 mb-5">
            @foreach (var tatami in DisplayedTatamis)
            {
                var currentKata = (activeDay.HasValue && tatami.CurrentKataPerformance?.CompetitionDay != activeDay.Value)
                    ? null
                    : tatami.CurrentKataPerformance;
                bool hasActiveKata = currentKata != null && currentKata.Status != MatchStatus.Finished;
                bool hasUpcomingKata = tatami.AssignedKataPerformances
                    .Any(p => p.Status != MatchStatus.Finished && (!activeDay.HasValue || p.CompetitionDay == activeDay.Value));
                bool hasKataToDisplay = hasActiveKata || hasUpcomingKata;

                bool hasKumiteMatches = tatami.AssignedKumiteMatches
                    .Any(m => (!activeDay.HasValue || m.CompetitionDay == activeDay.Value));

                // S'il n'y a plus de kata à afficher, on affiche les combats Kumité
                bool showKumite = tatami.CurrentDiscipline == CompetitionType.Kumite || (!hasKataToDisplay && hasKumiteMatches);

                var currentMatch = (activeDay.HasValue && tatami.CurrentKumiteMatch?.CompetitionDay != activeDay.Value)
                    ? null
                    : tatami.CurrentKumiteMatch;

                if (showKumite && (currentMatch == null || currentMatch.Status == MatchStatus.Finished))
                {
                    var activeMatch = tatami.AssignedKumiteMatches
                        .FirstOrDefault(m => (m.Status == MatchStatus.InProgress || m.Status == MatchStatus.Ready) && (!activeDay.HasValue || m.CompetitionDay == activeDay.Value));
                    if (activeMatch != null)
                    {
                        currentMatch = activeMatch;
                    }
                    else if (currentMatch?.Status == MatchStatus.Finished)
                    {
                        currentMatch = null;
                    }
                }
                <div class="@GetTatamiColClass()">
                <div class="card h-100 shadow border-0 overflow-hidden">
                    <!-- Tatami Header -->
                    <div class="card-header py-3 d-flex justify-content-between align-items-center @(tatami.IsPaused ? "bg-warning text-dark" : showKumite ? "bg-dark text-white" : "bg-primary text-white")">
                        <div>
                            <span class="fs-5 fw-bold">@tatami.Name</span>
                        </div>
                        @if (tatami.IsPaused)
                        {
                            <span class="badge bg-dark text-warning fs-6 fw-bold">⏸ PAUSE / PUB</span>
                        }
                        else if (showKumite)
                        {
                            @if (currentMatch != null && currentMatch.Status != MatchStatus.Finished && (!activeDay.HasValue || currentMatch.CompetitionDay == activeDay.Value))
                            {
                                <span class="badge bg-warning text-dark fs-6 fw-bold">Kumite #@currentMatch.MatchNumber</span>
                            }
                        }
                        else
                        {
                            @if (currentKata != null && currentKata.Status != MatchStatus.Finished && (!activeDay.HasValue || currentKata.CompetitionDay == activeDay.Value))
                            {
                                <span class="badge bg-warning text-dark fs-6 fw-bold">Kata #@currentKata.PerformanceOrder</span>
                            }
                        }
                    </div>

                    <div class="card-body p-0">
                        @if (tatami.IsPaused)
                        {
                            <!-- Ecran pause dans la home -->
                            <div class="d-flex flex-column align-items-center justify-content-center text-center py-5 px-3"
                                 style="background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%); min-height: 160px;">
                                <div class="fs-2 mb-2">⏸</div>
                                <div class="text-warning fw-bold fs-5 mb-1">PAUSE EN COURS</div>
                                @if (!string.IsNullOrEmpty(tatami.PauseMessage))
                                {
                                    <div class="text-light small">@tatami.PauseMessage</div>
                                }
                                else
                                {
                                    <div class="text-secondary small">Publicités diffusées sur l'écran TV</div>
                                }
                            </div>
                        }
                        else if (showKumite)
                        {
                            var isKataFinished = TournamentService.IsKataCompetitionFinished(competitionDay: activeDay, tatamiId: tatami.Id);
                            if (!isKataFinished)
                            {
                                var pendingKatas = TournamentService.GetPendingKataCount(competitionDay: activeDay, tatamiId: tatami.Id);
                                <div class="p-4 text-center py-5">
                                    <div class="fs-1 mb-2">🥋</div>
                                    <h5 class="fw-bold text-dark mb-1">@Lang["KataInProgressFightsPending"]</h5>
                                    <p class="text-muted small mb-3">
                                        @Lang["KataFirstNotice"]
                                    </p>
                                    <span class="badge bg-primary px-3 py-2">
                                        ⏳ @pendingKatas @Lang["PendingKataRemaining"]
                                    </span>
                                </div>
                            }
                            else
                            {
                                var match = currentMatch;
                                if (match != null)
                                {
                                    <!-- Current Kumite Match Banner -->
                                    <div class="p-3 bg-light border-bottom">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span class="badge bg-primary">@(Lang[match.Category.Name])</span>
                                        </div>

                                        <!-- Fighters Aka vs Shiro -->
                                        <div class="row g-2 text-center align-items-center mb-2">
                                            <!-- AKA (en haut sur mobile col-12, à gauche sur desktop col-md-5) -->
                                            <div class="col-12 col-md-5 p-2 rounded bg-danger text-white overflow-hidden">
                                                <div class="auto-scroll-container fw-bold small" title="@match.AkaDisplayName">
                                                    <span class="auto-scroll-content">@match.AkaDisplayName</span>
                                                </div>
                                                <div 
                                                    class="small" 
                                                    style="display:flex;align-items:center;justify-content:center;"
                                                    title="@(match.AkaCompetitor != null ? $"{match.AkaCompetitor.CountryFlag} {match.AkaCompetitor.Club}" : "")"
                                                >
                                                    <img 
                                                        src="@match.AkaCompetitor?.FlagImageUrl"
                                                        alt="@match.AkaCompetitor?.Country"
                                                        title="@match.AkaCompetitor?.Country"
                                                        class="border rounded-1 me-1 flex-shrink-0"
                                                        style="width: 22px; height: 15px; object-fit: cover; vertical-align: middle; box-shadow: 0 1px 2px rgba(0,0,0,0.15);" 
                                                    />
                                                    <div class="auto-scroll-container">
                                                        <span class="auto-scroll-content">@(match.AkaCompetitor != null ? $" {match.AkaCompetitor.Club}" : "")</span>
                                                    </div>
                                                </div>
                                                <div class="mt-1 badge bg-dark text-nowrap" style="font-size: 0.75rem;">
                                                    <small class="auto-scroll-content">@match.AkaCompetitor?.GradeName</small>
                                                </div>
                                            </div>

                                            <!-- VS (au milieu) -->
                                            <div class="col-12 col-md-2 fw-bold text-muted small py-1 py-md-0">
                                                <span class="badge bg-light text-secondary border">VS</span>
                                            </div>

                                            <!-- SHIRO (en bas sur mobile col-12, à droite sur desktop col-md-5) -->
                                            <div class="col-12 col-md-5 p-2 rounded border-secondary border overflow-hidden">
                                                <div class="auto-scroll-container fw-bold small" title="@match.ShiroDisplayName">
                                                    <span class="auto-scroll-content">@match.ShiroDisplayName</span>
                                                </div>
                                                <div 
                                                    class="small" 
                                                    style="display:flex;align-items:center;justify-content:center;"
                                                    title="@(match.ShiroCompetitor != null ? $"{match.ShiroCompetitor.CountryFlag} {match.ShiroCompetitor.Club}" : "")"
                                                >
                                                    <img 
                                                        src="@match.ShiroCompetitor?.FlagImageUrl"
                                                        alt="@match.ShiroCompetitor?.Country"
                                                        title="@match.ShiroCompetitor?.Country"
                                                        class="border rounded-1 me-1 flex-shrink-0"
                                                        style="width: 22px; height: 15px; object-fit: cover; vertical-align: middle; box-shadow: 0 1px 2px rgba(0,0,0,0.15);" 
                                                    />
                                                    <div class="auto-scroll-container">
                                                        <span class="auto-scroll-content">@(match.ShiroCompetitor != null ? $" {match.ShiroCompetitor.Club}" : "")</span>
                                                    </div>
                                                </div>
                                                <div class="mt-1 badge bg-secondary text-nowrap" style="font-size: 0.75rem;">
                                                    <small class="auto-scroll-content">@match.ShiroCompetitor?.GradeName</small>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Live Timer -->
                                        <div class="d-flex justify-content-between align-items-center mt-4 pt-2 border-top">
                                            <span class="font-monospace fs-4 fw-bold @(match.IsTimerRunning ? "text-success" : "text-muted")">
                                                ⏱️ @FormatSeconds(match.RemainingSeconds)
                                            </span>
                                            @if (match.ExtensionsCount > 0)
                                            {
                                                <span class="badge bg-danger">@match.CurrentPeriodName</span>
                                            }
                                            else
                                            {
                                                <span class="badge @(match.IsTimerRunning ? "bg-success" : "bg-warning text-dark")">
                                                    @(match.IsTimerRunning ? @Lang["InProgress"] : @Lang["Stopped"])
                                                </span>
                                            }
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="p-4 text-center text-muted">
                                        <em>@Lang["NoFightOnTatami"]</em>
                                    </div>
                                }

                                 <!-- Upcoming Matches on this Tatami -->
                                <div class="p-3">
                                    <h6 class="text-uppercase text-secondary fw-bold small mb-2">
                                        @Lang["NextFight"]
                                    </h6>
                                    @{
                                        var upcomingKumite = tatami.AssignedKumiteMatches
                                            .Where(m => m.Status != MatchStatus.Finished && m.Id != match?.Id);
                                        if (activeDay.HasValue)
                                        {
                                            upcomingKumite = upcomingKumite.Where(m => m.CompetitionDay == activeDay.Value);
                                        }
                                        var upcoming = upcomingKumite
                                            .OrderBy(m => m.MatchNumber)
                                            .Take(3)
                                            .ToList();
                                    }
                                    @if (upcoming.Count == 0)
                                    {
                                        <div class="text-muted small">@Lang["NoOtherFightPending"]</div>
                                    }
                                    else
                                    {
                                        <ul class="list-group list-group-flush">
                                            @foreach (var up in upcoming)
                                            {
                                                <li class="list-group-item px-0 py-2">
                                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                                        <div class="d-flex align-items-center gap-1">
                                                            <span class="badge bg-secondary me-1">#@up.MatchNumber</span>
                                                            <small class="badge bg-light text-dark">@Lang[up.RoundName]</small>
                                                        </div>
                                                        <small class="text-muted">@Lang[up.Category?.Name]</small>
                                                    </div>
                                                    
                                                    <!-- Ligne AKA -->
                                                    <div 
                                                        class="d-flex align-items-center gap-1 text-nowrap" 
                                                        style="overflow: hidden; max-width: 100%;"
                                                    >
                                                        <span class="badge bg-danger p-0 me-1 flex-shrink-0" style="width: 8px; height: 8px; border-radius: 50%; display: inline-block;"></span>

                                                        @if (up.AkaCompetitor != null)
                                                        {
                                                            <img 
                                                                src="@up.AkaCompetitor.FlagImageUrl" 
                                                                alt="@up.AkaCompetitor.Country" title="@up.AkaCompetitor.Country"
                                                                class="border rounded-1 me-1 flex-shrink-0" 
                                                                style="width: 18px; height: 12px; object-fit: cover;" 
                                                            />
                                                        }

                                                        <strong class="text-danger me-1 flex-shrink-0">@up.AkaDisplayName</strong>
                                                    </div>
                                                    <div class="small px-5">
                                                        @if (up.AkaCompetitor != null && (!string.IsNullOrWhiteSpace(up.AkaCompetitor.Club) || !string.IsNullOrWhiteSpace(up.AkaCompetitor.GradeName)))
                                                        {
                                                            <div 
                                                                class="auto-scroll-container flex-grow-1 text-muted" 
                                                                title="@up.AkaCompetitor.Club • @up.AkaCompetitor.GradeName"
                                                            >
                                                                <small class="auto-scroll-content">@up.AkaCompetitor.Club • @up.AkaCompetitor.GradeName</small>
                                                            </div>
                                                        }
                                                    </div>

                                                    <!-- Ligne SHIRO -->
                                                    <div class="d-flex align-items-center gap-1 text-nowrap" style="overflow: hidden; max-width: 100%;">
                                                        <span class="badge bg-white border border-secondary p-0 me-1 flex-shrink-0" style="width: 8px; height: 8px; border-radius: 50%; display: inline-block;"></span>
                                                        
                                                        @if (up.ShiroCompetitor != null)
                                                        {
                                                            <img 
                                                                src="@up.ShiroCompetitor.FlagImageUrl" 
                                                                alt="@up.ShiroCompetitor.Country" 
                                                                title="@up.ShiroCompetitor.Country"
                                                                class="border rounded-1 me-1 flex-shrink-0" 
                                                                style="width: 18px; height: 12px; object-fit: cover;" 
                                                            />
                                                        }
                                                        
                                                        <strong class="me-1 flex-shrink-0">@up.ShiroDisplayName</strong>
                                                    </div>
                                                    <div class="small px-5">
                                                        @if (up.ShiroCompetitor != null && (!string.IsNullOrWhiteSpace(up.ShiroCompetitor.Club) || !string.IsNullOrWhiteSpace(up.ShiroCompetitor.GradeName)))
                                                        {
                                                            <div 
                                                                class="auto-scroll-container flex-grow-1 text-muted" 
                                                                title="@up.ShiroCompetitor.Club • @up.ShiroCompetitor.GradeName"
                                                            >
                                                                <small class="auto-scroll-content">@up.ShiroCompetitor.Club • @up.ShiroCompetitor.GradeName</small>
                                                            </div>
                                                        }
                                                    </div>
                                                </li>
                                            }
                                        </ul>
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            <!-- Kata Tatami Live View -->
                            var kata = currentKata;
                            if (kata != null)
                            {
                                <div class="p-3 bg-light border-bottom">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="badge bg-primary">@(Lang[kata.Category.Name])</span>
                                        <span class="badge bg-secondary">@(kata.Round == KataRound.Turn1 ? Lang["Turn1"] : Lang["Turn2Final"])</span>
                                    </div>
                                    <div class="auto-scroll-container mb-1" title="@kata.CompetitorDisplayName">
                                        <h5 class="fw-bold mb-0 auto-scroll-content">@kata.CompetitorDisplayName</h5>
                                    </div>
                                    <div class="text-muted small mb-2 d-flex align-items-center gap-1 text-nowrap flex-nowrap" style="overflow: hidden; width: 100%; min-width: 0;">
                                        @if (kata.Competitor != null)
                                        {
                                            <img src="@kata.Competitor.FlagImageUrl"
                                                 alt="@kata.Competitor.Country"
                                                 title="@kata.Competitor.Country"
                                                 class="border rounded-1 me-1 flex-shrink-0"
                                                 style="width: 22px; height: 15px; object-fit: cover; vertical-align: middle; box-shadow: 0 1px 2px rgba(0,0,0,0.15);" 
                                            />
                                            <div class="auto-scroll-container flex-grow-1" style="min-width: 0;" title="@kata.Competitor.Club • @kata.Competitor.GradeName">
                                                <span class="auto-scroll-content">@kata.Competitor.Club • @kata.Competitor.GradeName</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <span>Club • Grade : -</span>
                                        }
                                    </div>

                                    <div class="p-2 rounded bg-warning bg-opacity-25 border border-warning mb-2 text-center">
                                        <small class="text-uppercase fw-bold text-dark d-block">@Lang["Kata"]</small>
                                        <strong class="fs-5 text-dark">@kata.KataName</strong>
                                    </div>

                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="text-muted small">@Lang["Notes"] : @((kata.ScoresDisplay == "NotNotes")?Lang["NotNotes"]:kata.ScoresDisplay)</span>
                                        <span class="fs-6 fw-bold text-primary">
                                            @(kata.FinalScore > 0 ? $"{kata.FinalScore:0} pts" : "")
                                        </span>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="p-4 text-center text-muted">
                                    <em>@Lang["NoKataOnTatami"]</em>
                                </div>
                            }

                            <!-- Upcoming Kata Performances -->
                            <div class="p-3">
                                <h6 class="text-uppercase text-secondary fw-bold small mb-2">
                                    @(Lang["NextKata"])
                                </h6>
                                @{
                                    var upcomingKata = tatami.AssignedKataPerformances
                                        .Where(p => p.Status != MatchStatus.Finished && p.Id != kata?.Id);
                                    if (activeDay.HasValue)
                                    {
                                        upcomingKata = upcomingKata.Where(p => p.CompetitionDay == activeDay.Value);
                                    }
                                    var upcomingKatas = upcomingKata
                                        .OrderBy(p => p.PerformanceOrder)
                                        .Take(3)
                                        .ToList();
                                }
                                @if (upcomingKatas.Count == 0)
                                {
                                    <div class="text-muted small">@Lang["NoOtherPassagesPending"]</div>
                                }
                                else
                                {
                                    <ul class="list-group list-group-flush">
                                        @foreach (var up in upcomingKatas)
                                        {
                                            <li class="list-group-item px-0 py-2">
                                                <div class="d-flex justify-content-between align-items-start">
                                                    <div>
                                                        <span class="badge bg-info text-dark me-1">#@up.PerformanceOrder</span>
                                                        <strong>@up.CompetitorDisplayName</strong>
                                                    </div>
                                                    <span class="badge bg-light text-dark">@(Lang[up.Round.ToString()])</span>
                                                </div>
                                                @if (up.Competitor != null)
                                                {
                                                    <div class="d-flex align-items-center gap-1 mt-1 text-nowrap" style="overflow: hidden; max-width: 100%;">
                                                        <img src="@up.Competitor.FlagImageUrl"
                                                             alt="@up.Competitor.Country"
                                                             title="@up.Competitor.Country"
                                                             class="border rounded-1 me-1 flex-shrink-0"
                                                             style="width: 20px; height: 14px; object-fit: cover; vertical-align: middle; box-shadow: 0 1px 2px rgba(0,0,0,0.15);" />
                                                        <div class="auto-scroll-container flex-grow-1" title="@up.Competitor.Club • @up.Competitor.GradeName">
                                                            <small class="text-muted auto-scroll-content">@up.Competitor.Club • @up.Competitor.GradeName</small>
                                                        </div>
                                                    </div>
                                                }
                                            </li>
                                        }
                                    </ul>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
        </div>
    }

    <!-- Search & Full Upcoming Matches Board -->
    <div class="card shadow border-0 overflow-hidden mb-5">
        <div class="card-header py-3 bg-dark text-white d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <h5 class="mb-0 fw-bold">@Lang["Program"]</h5>
                <span class="badge @(selectedTatamiId > 0 ? "bg-warning text-dark" : "bg-secondary text-light") fw-bold" style="font-size: 0.9rem;">
                    @(selectedTatamiId > 0 ? $"🥋 {GetSelectedTatamiName()}" : $"🌐 {Lang["AllTatamis"]}")
                </span>
                @if (selectedCategoryIds.Count > 0)
                {
                    <span class="badge bg-info text-dark small">
                        @selectedCategoryIds.Count @Lang["CategoriesFiltered"]
                    </span>
                }
            </div>
            <div class="d-flex gap-2 align-items-center flex-wrap">
                <button class="btn btn-primary" @onclick="OpenListFilter">
                    @if(disciplineFilter == "all" && selectedCategoryIds.Count == 0 && searchTerm == "") 
                    {
                        <svg xmlns="http://w3.org" width="16" height="16" fill="currentColor" class="bi bi-funnel" viewBox="0 0 16 16">
                            <path d="M1.5 1.5A.5.5 0 0 1 2 1h12a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-.128.334L10 8.692V13.5a.5.5 0 0 1-.342.474l-3 1A.5.5 0 0 1 6 14.5V8.692L1.128 3.834A.5.5 0 0 1 1 3.5zm1 .5v1.308l4.372 4.858A.5.5 0 0 1 7 8.5v5.306l2-.666V8.5a.5.5 0 0 1 .128-.334L13.5 3.308V2z"/>
                        </svg>
                    } 
                    else 
                    {
                        <svg xmlns="http://w3.org" width="16" height="16" fill="currentColor" class="bi bi-funnel-fill" viewBox="0 0 16 16">
                            <path d="M1.5 1.5A.5.5 0 0 1 2 1h12a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-.128.334L10 8.692V13.5a.5.5 0 0 1-.342.474l-3 1A.5.5 0 0 1 6 14.5V8.692L1.128 3.834A.5.5 0 0 1 1 3.5z"/>
                        </svg>
                    }   
                </button>
            </div>
        </div>

        @if (selectedCategoryIds.Count > 0)
        {
            <div class="bg-light px-3 py-2 border-bottom d-flex align-items-center flex-wrap gap-1">
                <span class="small text-muted me-1 fw-bold">📂 @Lang["FilterByCategory"]</span>
                @foreach (var catId in selectedCategoryIds.ToList())
                {
                    var cat = categories.FirstOrDefault(c => c.Id == catId);
                    if (cat != null)
                    {
                        <span class="badge @(cat.Type == CompetitionType.Kumite ? "bg-danger" : "bg-primary") text-white d-inline-flex align-items-center gap-1 py-1 px-2 shadow-sm" style="font-size: 0.8rem;">
                            <span>@(cat.Type == CompetitionType.Kumite ? "🥊" : "🥋") @cat.Name</span>
                            <button type="button" class="btn-close btn-close-white ms-1" style="font-size: 0.55rem;"
                                    aria-label="Supprimer" @onclick="() => ToggleCategorySelection(cat.Id)"></button>
                        </span>
                    }
                }
                <button class="btn btn-sm btn-link text-danger p-0 ms-2 text-decoration-none small fw-bold"
                        @onclick="ClearCategorySelection">
                    ✕ @Lang["ResetFilter"]
                </button>
            </div>
        }

        <div class="card-body p-0">
            @if (!UnifiedSchedule.Any())
        {
            <div class="p-4 text-center text-muted">
                <em>Aucune rencontre ou kata ne correspond aux filtres sélectionnés.</em>
                @if (selectedCategoryIds.Count > 0 || selectedTatamiId > 0 || !string.IsNullOrWhiteSpace(searchTerm) || hideFinished)
                {
