        {
            selectedTatamiId = QueryTatamiId.Value;
            Preferences.SelectedTatamiId = selectedTatamiId;
        }
    }

    private async Task OnTatamiSelectChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int val))
        {
            await SetSelectedTatami(val);
        }
    }

    private async Task SetSelectedTatami(int val)
    {
        selectedTatamiId = val;
        Preferences.SelectedTatamiId = val;

        if (selectedCategoryIds.Count > 0 && val > 0)
        {
            var validIds = categories
                .Where(c => IsCategoryMatchingDayAndTatami(c))
                .Select(c => c.Id)
                .ToHashSet();
            selectedCategoryIds.IntersectWith(validIds);
        }

        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", "home_selectedTatamiId", val.ToString());
        }
        catch { }
    }

    private async Task SelectAllTatamis()
    {
        await SetSelectedTatami(0);
    }

