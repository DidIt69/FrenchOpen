    @if(isListFilterOpen) 
    {
        <!-- Le fond noir semi-transparent (Backdrop) -->
        <div class="modal-backdrop fade show"></div>

        <!-- La structure de la modale Bootstrap -->
        <div class="modal fade show d-block" tabindex="-1" role="dialog">
            <div class="modal-dialog modal-dialog-centered" role="document">
                <div class="modal-content bg-dark">                
                    <!-- En-tête -->
                    <div class="modal-header d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-2">
                            <h5 class="modal-title text-white mb-0">@Lang["Filter"]</h5>
                            <span class="badge @(selectedTatamiId > 0 ? "bg-warning text-dark" : "bg-secondary text-light") fw-bold">
                                @(selectedTatamiId > 0 ? $"🥋 {GetSelectedTatamiName()}" : $"🌐 {Lang["AllTatamis"]}")
                            </span>
                        </div>
                        <button 
                            type="button" 
                            style="margin: calc(-0.5rem) calc(-0.5rem) calc(-0.5rem) auto;background: transparent;border: 0px;"
                            @onclick="CloseListFilter" 
                        >
                            <svg xmlns='http://www.w3.org/2000/svg' width="16" height="16" fill="#FFF" class="bi bi-funnel-fill" viewBox="0 0 16 16">
                                <path d='M.293.293a1 1 0 0 1 1.414 0L8 6.586 14.293.293a1 1 0 1 1 1.414 1.414L9.414 8l6.293 6.293a1 1 0 0 1-1.414 1.414L8 9.414l-6.293 6.293a1 1 0 0 1-1.414-1.414L6.586 8 .293 1.707a1 1 0 0 1 0-1.414z'/>
                            </svg>
                        </button>
                    </div>
                
                    <!-- Corps -->
                    <div class="modal-body d-flex flex-column gap-2 align-self-center w-100">
                        <div class="d-flex align-items-center justify-content-between pb-2 border-bottom border-secondary small text-light">
                            <span>🥋 @Lang["Tatami"] :</span>
                            <span class="badge @(selectedTatamiId > 0 ? "bg-warning text-dark" : "bg-secondary text-light") fw-bold">
                                @(selectedTatamiId > 0 ? GetSelectedTatamiName() : Lang["AllTatamis"])
                            </span>
                        </div>
                        <div class="d-flex gap-2 align-items-center flex-wrap">
                            <div class="btn-group btn-group-sm">
                                <button class="btn @(disciplineFilter == "all" ? "btn-warning" : "btn-outline-light")" @onclick='() => disciplineFilter = "all"'>@Lang["All"]</button>
                                <button class="btn @(disciplineFilter == "kata" ? "btn-warning" : "btn-outline-light")" @onclick='() => disciplineFilter = "kata"'>@Lang["Katas"]</button>
                                <button class="btn @(disciplineFilter == "kumite" ? "btn-warning" : "btn-outline-light")" @onclick='() => disciplineFilter = "kumite"'>@Lang["Kumites"]</button>
                            </div>

                            <!-- Category Multi-Select Dropdown -->
                            <div class="dropdown position-relative">
                                <button 
                                    class="btn btn-sm @(selectedCategoryIds.Count > 0 ? "btn-warning text-dark fw-bold" : "btn-outline-light") dropdown-toggle d-flex align-items-center gap-1"
                                    type="button"
                                    @onclick="ToggleCategoryDropdown"
                                >
                                    <span>📂</span>
                                    <span>@(selectedCategoryIds.Count == 0 ? Lang["AllCategories"] : $"{selectedCategoryIds.Count} {Lang["CategoriesFiltered"]}")</span>
                                </button>
                    
                                @if (isCategoryDropdownOpen)
                                {
