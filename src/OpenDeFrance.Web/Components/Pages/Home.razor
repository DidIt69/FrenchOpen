@page "/"
@page "/live"
@rendermode InteractiveServer
@inject ITournamentService TournamentService
@inject IJSRuntime JS
@implements IDisposable
@inject ILanguageService Lang

<PageTitle>Direct Compétition - Open de France Kyokushinkai</PageTitle>

<div class="container-fluid py-3">
    <!-- Top Hero Banner -->
    <div class="p-3 mb-4 rounded-3 text-white shadow" style="background: linear-gradient(135deg, #1b2838 0%, #0d121d 100%); border-left: 5px solid #ffc107;">
        <div class="d-flex flex-column flex-md-row align-items-center gap-2">
            <div class="align-self-start align-self-md-center">
                <h1 class="h3 fw-bold mb-0 fs-4">🥋 @Lang["FrenchOpen2027"]</h1>
            </div>
            <div class="flex-grow-1 d-flex flex-wrap gap-2 justify-content-center justify-content-md-end">
                @foreach (var t in tatamis)
                {
                    bool isSelected = selectedTatamiIds.Contains(t.Id);
                    <button 
                        class="btn btn-sm @(isSelected ? "btn-primary fw-bold shadow-sm" : "btn-outline-primary")"
                        @onclick="() => ToggleTatamiSelection(t.Id)"
                    >
                        @t.Name
                    </button>
                }
            </div>
        </div>
    </div>

    <!-- Multi-Tatamis Live Grid -->
    @if (!DisplayedTatamis.Any())
    {
        <div class="alert alert-info text-center py-4 mb-5 shadow-sm">
            <em>Aucun tatami sélectionné ou disponible.</em>
            <div class="mt-2">
                <button class="btn btn-sm btn-primary" @onclick="SelectAllTatamis">@Lang["AllTatamis"]</button>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4 mb-5">
            @foreach (var tatami in DisplayedTatamis)
            {
                <div class="@GetTatamiColClass()">
                <div class="card h-100 shadow border-0 overflow-hidden">
                    <!-- Tatami Header -->
                    <div class="card-header py-3 d-flex justify-content-between align-items-center @(tatami.IsPaused ? "bg-warning text-dark" : tatami.CurrentDiscipline == CompetitionType.Kumite ? "bg-dark text-white" : "bg-primary text-white")">
                        <div>
                            <span class="fs-5 fw-bold">@tatami.Name</span>
                        </div>
                        @if (tatami.IsPaused)
                        {
                            <span class="badge bg-dark text-warning fs-6 fw-bold">⏸ PAUSE / PUB</span>
                        }
                        else if (tatami.CurrentDiscipline == CompetitionType.Kumite)
                        {
                            @if (tatami.CurrentKumiteMatch != null && tatami.CurrentKumiteMatch.Status != MatchStatus.Finished)
                            {
                                <span class="badge bg-warning text-dark fs-6 fw-bold">Kumite #@tatami.CurrentKumiteMatch.MatchNumber</span>
                            }
                        }
                        else
                        {
                            @if (tatami.CurrentKataPerformance != null && tatami.CurrentKataPerformance.Status != MatchStatus.Finished)
                            {
                                <span class="badge bg-warning text-dark fs-6 fw-bold">Kata #@tatami.CurrentKataPerformance.PerformanceOrder</span>
                            }
                        }
                    </div>

                    <div class="card-body p-0">
                        @if (tatami.IsPaused)
                        {
                            <!-- Ecran pause dans la home -->
                            <div class="d-flex flex-column align-items-center justify-content-center text-center py-5 px-3"
                                 style="background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%); min-height: 160px;">
                                <div class="fs-2 mb-2">⏸</div>
                                <div class="text-warning fw-bold fs-5 mb-1">PAUSE EN COURS</div>
                                @if (!string.IsNullOrEmpty(tatami.PauseMessage))
                                {
                                    <div class="text-light small">@tatami.PauseMessage</div>
                                }
                                else
                                {
                                    <div class="text-secondary small">Publicités diffusées sur l'écran TV</div>
                                }
                            </div>
                        }
                        else if (tatami.CurrentDiscipline == CompetitionType.Kumite)
                        {
                            var isKataFinished = TournamentService.IsKataCompetitionFinished(tatamiId: tatami.Id);
                            if (!isKataFinished)
                            {
                                var pendingKatas = TournamentService.GetPendingKataCount(tatamiId: tatami.Id);
                                <div class="p-4 text-center py-5">
                                    <div class="fs-1 mb-2">🥋</div>
                                    <h5 class="fw-bold text-dark mb-1">@Lang["KataInProgressFightsPending"]</h5>
                                    <p class="text-muted small mb-3">
                                        @Lang["KataFirstNotice"]
                                    </p>
                                    <span class="badge bg-primary px-3 py-2">
                                        ⏳ @pendingKatas @Lang["PendingKataRemaining"]
                                    </span>
                                </div>
                            }
                            else
                            {
                                var match = tatami.CurrentKumiteMatch;
                                if (match != null)
                                {
                                    <!-- Current Kumite Match Banner -->
                                    <div class="p-3 bg-light border-bottom">
                                        <h6 class="fw-bold text-primary mb-2">@Lang[match.Category?.Name]</h6>

                                        <!-- Fighters Aka vs Shiro -->
                                        <div class="row g-2 text-center align-items-center mb-2">
                                            <div class="col-5 p-2 rounded bg-danger text-white overflow-hidden">
                                                <div class="auto-scroll-container fw-bold small" title="@match.AkaDisplayName">
                                                    <span class="auto-scroll-content">@match.AkaDisplayName</span>
                                                </div>
                                                <div 
                                                    class="small" 
                                                    style="display:flex;align-items:center;justify-content:center;"
                                                    title="@(match.AkaCompetitor != null ? $"{match.AkaCompetitor.CountryFlag} {match.AkaCompetitor.Club}" : "")"
                                                >
                                                    <img 
                                                        src="@match.AkaCompetitor?.FlagImageUrl"
                                                        alt="@match.AkaCompetitor.Country"
                                                        title="@match.AkaCompetitor.Country"
                                                        class="border rounded-1 me-1 flex-shrink-0"
                                                        style="width: 22px; height: 15px; object-fit: cover; vertical-align: middle; box-shadow: 0 1px 2px rgba(0,0,0,0.15);" 
                                                    />
                                                    <div class="auto-scroll-container">
                                                        <span class="auto-scroll-content">@(match.AkaCompetitor != null ? $" {match.AkaCompetitor.Club}" : "")</span>
                                                    </div>
                                                </div>
                                                <div class="mt-1 badge bg-dark text-nowrap" style="font-size: 0.75rem;">
                                                    <small class="auto-scroll-content">@match.AkaCompetitor.GradeName</small>
                                                </div>
                                            </div>

                                            <div class="col-2 fw-bold text-muted small">VS</div>

                                            <div class="col-5 p-2 rounded border-secondary border overflow-hidden">
                                                <div class="auto-scroll-container fw-bold small" title="@match.ShiroDisplayName">
                                                    <span class="auto-scroll-content">@match.ShiroDisplayName</span>
                                                </div>
                                                <div 
                                                    class="small" 
                                                    style="display:flex;align-items:center;justify-content:center;"
                                                    title="@(match.ShiroCompetitor != null ? $"{match.ShiroCompetitor.CountryFlag} {match.ShiroCompetitor.Club}" : "")"
                                                >
                                                    <img 
                                                        src="@match.ShiroCompetitor?.FlagImageUrl"
                                                        alt="@match.ShiroCompetitor.Country"
                                                        title="@match.ShiroCompetitor.Country"
                                                        class="border rounded-1 me-1 flex-shrink-0"
                                                        style="width: 22px; height: 15px; object-fit: cover; vertical-align: middle; box-shadow: 0 1px 2px rgba(0,0,0,0.15);" 
                                                    />
                                                    <div class="auto-scroll-container">
                                                        <span class="auto-scroll-content">@(match.ShiroCompetitor != null ? $" {match.ShiroCompetitor.Club}" : "")</span>
                                                    </div>
                                                </div>
                                                <div class="mt-1 badge bg-secondary text-nowrap" style="font-size: 0.75rem;">
                                                    <small class="auto-scroll-content">@match.AkaCompetitor.GradeName</small>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Live Timer -->
                                        <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top">
                                            <span class="font-monospace fs-4 fw-bold @(match.IsTimerRunning ? "text-success" : "text-muted")">
                                                ⏱️ @FormatSeconds(match.RemainingSeconds)
                                            </span>
                                            @if (match.ExtensionsCount > 0)
                                            {
                                                <span class="badge bg-danger">@match.CurrentPeriodName</span>
                                            }
                                            else
                                            {
                                                <span class="badge @(match.IsTimerRunning ? "bg-success" : "bg-warning text-dark")">
                                                    @(match.IsTimerRunning ? @Lang["InProgress"] : @Lang["Stopped"])
                                                </span>
                                            }
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="p-4 text-center text-muted">
                                        <em>@Lang["NoFightOnTatami"]</em>
                                    </div>
                                }

                                 <!-- Upcoming Matches on this Tatami -->
                                <div class="p-3">
                                    <h6 class="text-uppercase text-secondary fw-bold small mb-2">
                                        @Lang["NextFight"]
                                    </h6>
                                    @{
                                        var upcoming = tatami.AssignedKumiteMatches
                                            .Where(m => m.Status != MatchStatus.Finished && m.Id != match?.Id)
                                            .OrderBy(m => m.MatchNumber)
                                            .Take(3)
                                            .ToList();
                                    }
                                    @if (upcoming.Count == 0)
                                    {
                                        <div class="text-muted small">@Lang["NoOtherFightPending"]</div>
                                    }
                                    else
                                    {
                                        <ul class="list-group list-group-flush">
                                            @foreach (var up in upcoming)
                                            {
                                                <li class="list-group-item px-0 py-2">
                                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                                        <div class="d-flex align-items-center gap-1">
                                                            <span class="badge bg-secondary me-1">#@up.MatchNumber</span>
                                                            <small class="badge bg-light text-dark">@Lang[up.RoundName]</small>
                                                        </div>
                                                        <small class="text-muted">@Lang[up.Category?.Name]</small>
                                                    </div>
                                                    
                                                    <!-- Ligne AKA -->
                                                    <div 
                                                        class="d-flex align-items-center gap-1 text-nowrap" 
                                                        style="overflow: hidden; max-width: 100%;"
                                                    >
                                                        <span class="badge bg-danger p-0 me-1 flex-shrink-0" style="width: 8px; height: 8px; border-radius: 50%; display: inline-block;"></span>

                                                        @if (up.AkaCompetitor != null)
                                                        {
                                                            <img 
                                                                src="@up.AkaCompetitor.FlagImageUrl" 
                                                                alt="@up.AkaCompetitor.Country" title="@up.AkaCompetitor.Country"
                                                                class="border rounded-1 me-1 flex-shrink-0" 
                                                                style="width: 18px; height: 12px; object-fit: cover;" 
                                                            />
                                                        }

                                                        <strong class="text-danger me-1 flex-shrink-0">@up.AkaDisplayName</strong>
                                                    </div>
                                                    <div class="small px-5">
                                                        @if (up.AkaCompetitor != null && (!string.IsNullOrWhiteSpace(up.AkaCompetitor.Club) || !string.IsNullOrWhiteSpace(up.AkaCompetitor.GradeName)))
                                                        {
                                                            <div 
                                                                class="auto-scroll-container flex-grow-1 text-muted" 
                                                                title="@up.AkaCompetitor.Club • @up.AkaCompetitor.GradeName"
                                                            >
                                                                <small class="auto-scroll-content">@up.AkaCompetitor.Club • @up.AkaCompetitor.GradeName</small>
                                                            </div>
                                                        }
                                                    </div>

                                                    <!-- Ligne SHIRO -->
                                                    <div class="d-flex align-items-center gap-1 text-nowrap" style="overflow: hidden; max-width: 100%;">
                                                        <span class="badge bg-white border border-secondary p-0 me-1 flex-shrink-0" style="width: 8px; height: 8px; border-radius: 50%; display: inline-block;"></span>
                                                        
                                                        @if (up.ShiroCompetitor != null)
                                                        {
                                                            <img 
                                                                src="@up.ShiroCompetitor.FlagImageUrl" 
                                                                alt="@up.ShiroCompetitor.Country" 
                                                                title="@up.ShiroCompetitor.Country"
                                                                class="border rounded-1 me-1 flex-shrink-0" 
                                                                style="width: 18px; height: 12px; object-fit: cover;" 
                                                            />
                                                        }
                                                        
                                                        <strong class="me-1 flex-shrink-0">@up.ShiroDisplayName</strong>
                                                    </div>
                                                    <div class="small px-5">
                                                        @if (up.ShiroCompetitor != null && (!string.IsNullOrWhiteSpace(up.ShiroCompetitor.Club) || !string.IsNullOrWhiteSpace(up.ShiroCompetitor.GradeName)))
                                                        {
                                                            <div 
                                                                class="auto-scroll-container flex-grow-1 text-muted" 
                                                                title="@up.ShiroCompetitor.Club • @up.ShiroCompetitor.GradeName"
                                                            >
                                                                <small class="auto-scroll-content">@up.ShiroCompetitor.Club • @up.ShiroCompetitor.GradeName</small>
                                                            </div>
                                                        }
                                                    </div>
                                                </li>
                                            }
                                        </ul>
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            <!-- Kata Tatami Live View -->
                            var kata = tatami.CurrentKataPerformance;
                            if (kata != null)
                            {
                                <div class="p-3 bg-light border-bottom">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="badge bg-primary">@(Lang[kata.Category.Name])</span>
                                        <span class="badge bg-secondary">@(kata.Round == KataRound.Turn1 ? Lang["Turn1"] : Lang["Turn2Final"])</span>
                                    </div>
                                    <div class="auto-scroll-container mb-1" title="@kata.CompetitorDisplayName">
                                        <h5 class="fw-bold mb-0 auto-scroll-content">@kata.CompetitorDisplayName</h5>
                                    </div>
                                    <div class="text-muted small mb-2 d-flex align-items-center gap-1 text-nowrap flex-nowrap" style="overflow: hidden; width: 100%; min-width: 0;">
                                        @if (kata.Competitor != null)
                                        {
                                            <img src="@kata.Competitor.FlagImageUrl"
                                                 alt="@kata.Competitor.Country"
                                                 title="@kata.Competitor.Country"
                                                 class="border rounded-1 me-1 flex-shrink-0"
                                                 style="width: 22px; height: 15px; object-fit: cover; vertical-align: middle; box-shadow: 0 1px 2px rgba(0,0,0,0.15);" 
                                            />
                                            <div class="auto-scroll-container flex-grow-1" style="min-width: 0;" title="@kata.Competitor.Club • @kata.Competitor.GradeName">
                                                <span class="auto-scroll-content">@kata.Competitor.Club • @kata.Competitor.GradeName</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <span>Club • Grade : -</span>
                                        }
                                    </div>

                                    <div class="p-2 rounded bg-warning bg-opacity-25 border border-warning mb-2 text-center">
                                        <small class="text-uppercase fw-bold text-dark d-block">@Lang["Kata"]</small>
                                        <strong class="fs-5 text-dark">@kata.KataName</strong>
                                    </div>

                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="text-muted small">@Lang["Notes"] : @((kata.ScoresDisplay == "NotNotes")?Lang["NotNotes"]:kata.ScoresDisplay)</span>
                                        <span class="fs-6 fw-bold text-primary">
                                            @(kata.FinalScore > 0 ? $"{kata.FinalScore:0} pts" : "")
                                        </span>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="p-4 text-center text-muted">
                                    <em>@Lang["NoKataOnTatami"]</em>
                                </div>
                            }

                            <!-- Upcoming Kata Performances -->
                            <div class="p-3">
                                <h6 class="text-uppercase text-secondary fw-bold small mb-2">
                                    @(Lang["NextKataPassages"])
                                </h6>
                                @{
                                    var upcomingKatas = tatami.AssignedKataPerformances
                                        .Where(p => p.Status != MatchStatus.Finished && p.Id != kata?.Id)
                                        .OrderBy(p => p.PerformanceOrder)
                                        .Take(3)
                                        .ToList();
                                }
                                @if (upcomingKatas.Count == 0)
                                {
                                    <div class="text-muted small">@Lang["NoOtherPassagesPending"]</div>
                                }
                                else
                                {
                                    <ul class="list-group list-group-flush">
                                        @foreach (var up in upcomingKatas)
                                        {
                                            <li class="list-group-item px-0 py-2">
                                                <div class="d-flex justify-content-between align-items-start">
                                                    <div>
                                                        <span class="badge bg-info text-dark me-1">#@up.PerformanceOrder</span>
                                                        <strong>@up.CompetitorDisplayName</strong>
                                                    </div>
                                                    <span class="badge bg-light text-dark">@(Lang[up.Round.ToString()])</span>
                                                </div>
                                                @if (up.Competitor != null)
                                                {
                                                    <div class="d-flex align-items-center gap-1 mt-1 text-nowrap" style="overflow: hidden; max-width: 100%;">
                                                        <img src="@up.Competitor.FlagImageUrl"
                                                             alt="@up.Competitor.Country"
                                                             title="@up.Competitor.Country"
                                                             class="border rounded-1 me-1 flex-shrink-0"
                                                             style="width: 20px; height: 14px; object-fit: cover; vertical-align: middle; box-shadow: 0 1px 2px rgba(0,0,0,0.15);" />
                                                        <div class="auto-scroll-container flex-grow-1" title="@up.Competitor.Club • @up.Competitor.GradeName">
                                                            <small class="text-muted auto-scroll-content">@up.Competitor.Club • @up.Competitor.GradeName</small>
                                                        </div>
                                                    </div>
                                                }
                                            </li>
                                        }
                                    </ul>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
        </div>
    }

    <!-- Search & Full Upcoming Matches Board -->
    <div class="card shadow border-0 overflow-hidden mb-5">
        <div class="card-header py-3 bg-dark text-white d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <h5 class="mb-0 fw-bold">@Lang["Program"]</h5>
                @if (selectedTatamiIds.Count > 0)
                {
                    <span class="badge bg-warning text-dark small">
                        @(selectedTatamiIds.Count == 1
                            ? (tatamis.FirstOrDefault(t => t.Id == selectedTatamiIds.First())?.Name ?? "Tatami filtré")
                            : $"{selectedTatamiIds.Count} tatamis filtrés")
                    </span>
                }
                @if (selectedCategoryIds.Count > 0)
                {
                    <span class="badge bg-info text-dark small">
                        @selectedCategoryIds.Count @Lang["CategoriesFiltered"]
                    </span>
                }
            </div>
            <div class="d-flex gap-2 align-items-center flex-wrap">
                <div class="btn-group btn-group-sm">
                    <button class="btn @(disciplineFilter == "all" ? "btn-warning" : "btn-outline-light")" @onclick='() => disciplineFilter = "all"'>@Lang["All"]</button>
                    <button class="btn @(disciplineFilter == "kata" ? "btn-warning" : "btn-outline-light")" @onclick='() => disciplineFilter = "kata"'>@Lang["Katas"]</button>
                    <button class="btn @(disciplineFilter == "kumite" ? "btn-warning" : "btn-outline-light")" @onclick='() => disciplineFilter = "kumite"'>@Lang["Kumites"]</button>
                </div>

                <!-- Category Multi-Select Dropdown -->
                <div class="dropdown position-relative">
                    <button class="btn btn-sm @(selectedCategoryIds.Count > 0 ? "btn-warning text-dark fw-bold" : "btn-outline-light") dropdown-toggle d-flex align-items-center gap-1"
                            type="button"
                            @onclick="ToggleCategoryDropdown">
                        <span>📂</span>
                        <span>@(selectedCategoryIds.Count == 0 ? Lang["AllCategories"] : $"{selectedCategoryIds.Count} {Lang["CategoriesFiltered"]}")</span>
                    </button>
                    @if (isCategoryDropdownOpen)
                    {
                        <div class="dropdown-menu show shadow-lg p-2 border position-absolute"
                             style="min-width: 340px; max-height: 420px; overflow-y: auto; right: 0; left: auto; z-index: 1060;">
                            <div class="d-flex justify-content-between align-items-center mb-2 px-1">
                                <span class="fw-bold text-dark small">📂 @Lang["FilterByCategory"]</span>
                                <button type="button" class="btn-close" style="font-size: 0.65rem;" @onclick="CloseCategoryDropdown" aria-label="Fermer"></button>
                            </div>
                            <div class="p-1 mb-2 border-bottom">
                                <input type="text" class="form-control form-control-sm mb-2"
                                       placeholder="@Lang["Search"]"
                                       @bind="categorySearchTerm" @bind:event="oninput" />
                                <div class="d-flex justify-content-between align-items-center gap-1">
                                    <button class="btn btn-xs btn-outline-primary py-0 px-2"
                                            style="font-size: 0.75rem;"
                                            @onclick="SelectAllCategories">
                                        ✓ @Lang["SelectAll"]
                                    </button>
                                    <button class="btn btn-xs btn-outline-secondary py-0 px-2"
                                            style="font-size: 0.75rem;"
                                            @onclick="ClearCategorySelection">
                                        ✕ @Lang["DeselectAll"]
                                    </button>
                                </div>
                            </div>
                            <div class="list-group list-group-flush small" style="max-height: 280px; overflow-y: auto;">
                                @foreach (var cat in FilteredCategoryChoices)
                                {
                                    bool isChecked = selectedCategoryIds.Contains(cat.Id);
                                    int compCount = GetCategoryCompetitorCount(cat);
                                    bool catFinished = IsCategoryFinished(cat);
                                    <label class="list-group-item list-group-item-action py-1 px-2 border-0 d-flex align-items-center gap-2 rounded user-select-none @(catFinished ? "opacity-50" : "")"
                                           style="cursor: pointer;">
                                        <input class="form-check-input m-0 flex-shrink-0" type="checkbox"
                                               checked="@isChecked"
                                               @onchange="() => ToggleCategorySelection(cat.Id)" />
                                        <div class="d-flex align-items-center gap-1 flex-grow-1 text-truncate">
                                            <span class="badge @(cat.Type == CompetitionType.Kumite ? "bg-danger" : "bg-primary")" style="font-size: 0.65rem;">
                                                @(cat.Type == CompetitionType.Kumite ? "🥊" : "🥋")
                                            </span>
                                            <span class="badge bg-light text-dark border" style="font-size: 0.65rem;">J@(cat.CompetitionDay)</span>
                                            <span class="text-truncate @(catFinished ? "text-decoration-line-through text-muted" : "")" title="@cat.Name">@cat.Name</span>
                                        </div>
                                        <span class="badge bg-secondary-subtle text-secondary-emphasis" style="font-size: 0.65rem;" title="@($"{compCount} compétiteur(s)")">
                                            @compCount @(compCount > 1 ? "inscrits" : "inscrit")
                                        </span>
                                        @if (catFinished)
                                        {
                                            <span class="badge bg-success-subtle text-success-emphasis" style="font-size: 0.6rem;">✅ Terminé</span>
                                        }
                                    </label>
                                }
                                @if (!FilteredCategoryChoices.Any())
                                {
                                    <div class="text-muted text-center py-2 small">
                                        <em>Aucune catégorie</em>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>

                <!-- Filter Hide/Show Finished -->
                <button class="btn btn-sm @(hideFinished ? "btn-outline-light" : "btn-warning text-dark fw-bold") d-flex align-items-center gap-1"
                        @onclick="() => hideFinished = !hideFinished"
                        title="@(hideFinished ? Lang["ShowFinished"] : Lang["HideFinished"])">
                    <span>@(hideFinished ? $"👁️ {Lang["ShowFinished"]}" + (GetFinishedCount() > 0 ? $" ({GetFinishedCount()})" : "") : $"👁️‍🗨️ {Lang["HideFinished"]}")</span>
                </button>

                <input type="text" class="form-control form-control-sm" placeholder="@(Lang["Search"])"
                       @bind="searchTerm" @bind:event="oninput" style="min-width: 180px;" />
            </div>
        </div>

        @if (selectedCategoryIds.Count > 0)
        {
            <div class="bg-light px-3 py-2 border-bottom d-flex align-items-center flex-wrap gap-1">
                <span class="small text-muted me-1 fw-bold">📂 @Lang["FilterByCategory"]</span>
                @foreach (var catId in selectedCategoryIds.ToList())
                {
                    var cat = categories.FirstOrDefault(c => c.Id == catId);
                    if (cat != null)
                    {
                        <span class="badge @(cat.Type == CompetitionType.Kumite ? "bg-danger" : "bg-primary") text-white d-inline-flex align-items-center gap-1 py-1 px-2 shadow-sm" style="font-size: 0.8rem;">
                            <span>@(cat.Type == CompetitionType.Kumite ? "🥊" : "🥋") @cat.Name</span>
                            <button type="button" class="btn-close btn-close-white ms-1" style="font-size: 0.55rem;"
                                    aria-label="Supprimer" @onclick="() => ToggleCategorySelection(cat.Id)"></button>
                        </span>
                    }
                }
                <button class="btn btn-sm btn-link text-danger p-0 ms-2 text-decoration-none small fw-bold"
                        @onclick="ClearCategorySelection">
                    ✕ @Lang["ResetFilter"]
                </button>
            </div>
        }

        <div class="card-body p-0">
            @if (!UnifiedSchedule.Any())
        {
            <div class="p-4 text-center text-muted">
                <em>Aucune rencontre ou kata ne correspond aux filtres sélectionnés.</em>
                @if (selectedCategoryIds.Count > 0 || selectedTatamiIds.Count > 0 || !string.IsNullOrWhiteSpace(searchTerm) || hideFinished)
                {
                    <div class="mt-2 d-flex justify-content-center gap-2">
                        <button class="btn btn-sm btn-outline-secondary" @onclick="ResetAllProgramFilters">
                            Réinitialiser les filtres
                        </button>
                        @if (hideFinished && GetFinishedCount() > 0)
                        {
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => hideFinished = false">
                                👁️ Afficher les @GetFinishedCount() terminés
                            </button>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <ul class="list-group list-group-flush">
                @foreach (var item in UnifiedSchedule)
                {
                    var isFinished = item.Status == MatchStatus.Finished;
                    var isInProgress = !isFinished && item.IsCurrentOnTatami;

                    <li class="list-group-item px-3 py-2 @(isFinished ? "opacity-75 bg-light" : "") @(isInProgress ? "border-start border-2 border-success bg-success bg-opacity-10" : "")">
                        <!-- === MODE MOBILE (< 768px) : 3 lignes === -->
                        <div class="d-md-none">
                            <!-- Ligne 1 : Les badges (Tatami, Tour, Statut) -->
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <div class="d-flex align-items-center gap-1">
                                    @if (!string.IsNullOrWhiteSpace(item.TatamiName))
                                    {
                                        <span class="badge bg-secondary" style="font-size:0.7rem;">@item.TatamiName</span>
                                    }
                                    <span class="badge bg-light text-dark border" style="font-size:0.7rem;">@item.RoundName</span>
                                </div>
                                <div>
                                    @if (isInProgress)
                                    {
                                        <span class="badge bg-success" style="font-size:0.7rem;">@Lang["InProgress"]</span>
                                    }
                                    else if (isFinished)
                                    {
                                        <span class="badge bg-dark" style="font-size:0.7rem;">@Lang["Finished"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary" style="font-size:0.7rem;">@Lang["Coming"]</span>
                                    }
                                </div>
                            </div>

                            @if (item.IsKata)
                            {
                                <!-- Ligne 2 : Position (#numéro), Type (KATA) et compétiteur -->
                                <div class="d-flex align-items-center gap-1 mb-1 flex-wrap">
                                    <span class="badge bg-info text-dark flex-shrink-0" style="font-size:0.7rem;">#@item.Number</span>
                                    <span class="badge bg-primary flex-shrink-0" style="font-size:0.65rem;">KATA</span>
                                    @if (!string.IsNullOrEmpty(item.KataFlagUrl))
                                    {
                                        <img src="@item.KataFlagUrl" alt="@item.KataCountry" title="@item.KataCountry"
                                             class="border rounded-1 flex-shrink-0" style="width: 18px; height: 12px; object-fit: cover;" />
                                    }
                                    <strong>@item.KataCompetitorName</strong>
                                    @if (!string.IsNullOrWhiteSpace(item.KataClub) || !string.IsNullOrWhiteSpace(item.KataGrade))
                                    {
                                        <small class="text-muted" style="font-size: 0.75rem;">(@string.Join(" • ", new[] { item.KataClub, item.KataGrade }.Where(s => !string.IsNullOrWhiteSpace(s))))</small>
                                    }
                                </div>
                            }
                            else
                            {
                                <!-- Ligne 2 : Position (#numéro), Type (KUMITÉ) et AKA -->
                                <div class="d-flex align-items-center gap-1 mb-1 flex-wrap">
                                    <span class="badge bg-secondary flex-shrink-0" style="font-size:0.7rem;">#@item.Number</span>
                                    <span class="badge bg-danger flex-shrink-0" style="font-size:0.65rem;">KUMITÉ</span>
                                    <span class="badge bg-danger p-0 me-1 flex-shrink-0" style="width: 8px; height: 8px; border-radius: 50%; display: inline-block;"></span>
                                    @if (!string.IsNullOrEmpty(item.AkaFlagUrl))
                                    {
