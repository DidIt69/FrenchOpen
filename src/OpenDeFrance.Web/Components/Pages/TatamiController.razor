                                                <button class="btn btn-outline-secondary" @onclick='() => AddScore(match.Id, CornerColor.Shiro, "remove_chui")'>-1</button>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="p-2 border rounded">
