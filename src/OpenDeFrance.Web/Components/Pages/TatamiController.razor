                                            </div>
                                        </div>
                                    </div>
                                </div> -->

                                <div class="d-grid gap-2">
                                    <button class="btn btn-danger btn-lg fw-bold" @onclick="() => DeclareWinner(CornerColor.Aka, MatchWinnerReason.WazaAriDecision)">
                                        🏆 DÉCLARER VAINQUEUR AKA
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- SHIRO (Blanc) -->
                    <div class="col-md-6">
                        <div class="card border-secondary h-100 shadow">
                            <div class="card-header bg-dark text-white py-2">
                                <h4 class="mb-0 fw-bold">SHIRO</h4>
                                <h4 class="mb-0 fw-bold">@match.ShiroDisplayName</h4>
                                <div 
                                    class="small d-flex align-items-center jusitify-content-center" 
                                    title="@(match.ShiroCompetitor != null ? $"{match.ShiroCompetitor.CountryFlag} {match.ShiroCompetitor.Club}" : "")"
                                >
                                    <img 
                                        src="@match.ShiroCompetitor?.FlagImageUrl"
                                        alt="@match.ShiroCompetitor?.Country"
                                        title="@match.ShiroCompetitor?.Country"
                                        class="border rounded-1 me-1 flex-shrink-0"
                                        style="width: 22px; height: 15px; object-fit: cover; vertical-align: middle; box-shadow: 0 1px 2px rgba(0,0,0,0.15);" 
                                    />
                                    <div class="auto-scroll-container">
                                        <span class="auto-scroll-content">@(match.ShiroCompetitor != null ? $" {match.ShiroCompetitor.Club}" : "")</span>
                                    </div>
                                </div>
                                <div class="mt-1 badge bg-secondary text-nowrap" style="font-size: 0.75rem;">
                                    <small class="auto-scroll-content">@match.ShiroCompetitor?.GradeName</small>
                                </div>
                            </div>
                            <div class="card-body text-center">
                                <!-- <div class="row g-2 mb-3">
                                    <div class="col-6">
                                        <div class="p-2 border rounded bg-light">
                                            <div class="text-muted fw-bold">WAZA-ARI</div>
                                            <div class="display-4 fw-bold text-dark">@match.ShiroWazaAri</div>
                                            <div class="btn-group mt-2 w-100">
                                                <button class="btn btn-outline-dark btn-sm" @onclick='() => AddScore(match.Id, CornerColor.Shiro, "wazaari")'>+1</button>
                                                <button class="btn btn-outline-secondary btn-sm" @onclick='() => AddScore(match.Id, CornerColor.Shiro, "remove_wazaari")'>-1</button>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="p-2 border rounded bg-light">
                                            <div class="text-muted fw-bold">IPPON</div>
                                            <div class="display-4 fw-bold text-dark">@match.ShiroIppon</div>
                                            <button class="btn btn-dark btn-sm mt-2 w-100 fw-bold" @onclick='() => AddScore(match.Id, CornerColor.Shiro, "ippon")'>
                                                + IPPON
                                            </button>
                                        </div>
                                    </div>
                                </div> -->

                                <!-- <div class="row g-2 mb-3">
                                    <div class="col-6">
                                        <div class="p-2 border rounded">
                                            <span class="text-muted">CHUI (Avertiss.) : </span>
                                            <strong class="text-warning fs-5">@match.ShiroChui</strong>
                                            <div class="btn-group btn-group-sm w-100 mt-1">
