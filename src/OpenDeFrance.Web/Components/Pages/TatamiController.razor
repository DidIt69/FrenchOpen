@page "/tatami/{TatamiId:int}/controller"
@attribute [Authorize(Roles = "Admin,Table")]
@rendermode InteractiveServer
@inject ITournamentService TournamentService
@inject IJSRuntime JS
@implements IDisposable
@inject ILanguageService Lang

<PageTitle>Table de Marque - Tatami @TatamiId</PageTitle>

<div class="container-fluid py-3">
    @if (tatami == null)
    {
        <div class="alert alert-danger">Tatami @TatamiId non trouvé.</div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h2 class="mb-0 fw-bold">
                    ⏱️ Table - @tatami.Name
                    <span class="badge @(tatami.CurrentDiscipline == CompetitionType.Kumite ? "bg-danger" : "bg-primary") ms-2">
                        @tatami.CurrentDiscipline
                    </span>
                    @if (tatami.Discipline == CompetitionType.Both)
                    {
                        <span class="badge bg-success ms-1 fs-6">Mixte (Kumité &amp; Kata)</span>
                    }
                </h2>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <button 
                    class="btn @(tatami.IsPaused ? "btn-success fw-bold" : "btn-warning fw-bold")"
                    @onclick="TogglePause"
                >
                    @(tatami.IsPaused ? "▶ REPRENDRE" : "⏸ PAUSE")
                </button>
            </div>
        </div>

        @if (tatami.IsPaused)
        {
            <div class="alert alert-warning border-warning d-flex align-items-center gap-3 mb-3 flex-wrap">
                <span class="fs-5">⏸ <strong>TATAMI EN PAUSE</strong> — L'écran TV affiche la publicité/pause.</span>
                <div class="d-flex align-items-center gap-2 flex-grow-1">
                    <input 
                        type="text" class="form-control form-control-sm"
                        placeholder="Message de pause (optionnel, affiché si aucune pub)"
                        @bind="pauseMessage" @bind:event="oninput" style="max-width: 320px;" 
                    />
                    <button class="btn btn-sm btn-outline-dark" @onclick="UpdatePauseMessage">Mettre à jour</button>
                </div>
            </div>
        }

        @if (tatami.Discipline == CompetitionType.Both)
        {
            <div class="alert alert-light border shadow-sm py-2 px-3 mb-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div class="d-flex align-items-center gap-2">
                    <span class="fw-bold">🥋 Mode actif du Tatami :</span>
                    <span class="text-muted small">Ce tatami accueille Kumité et Kata. Basculez d'un mode à l'autre selon le programme :</span>
                </div>
                <div class="btn-group">
                    <button 
                        class="btn @(tatami.CurrentDiscipline == CompetitionType.Kumite ? "btn-danger fw-bold active" : "btn-outline-danger")"
                        @onclick="() => SwitchDiscipline(CompetitionType.Kumite)"
                    >
                        🥊 Mode Kumité (@tatami.AssignedKumiteMatches.Count)
                    </button>
                    <button 
                        class="btn @(tatami.CurrentDiscipline == CompetitionType.Kata ? "btn-primary fw-bold active" : "btn-outline-primary")"
                        @onclick="() => SwitchDiscipline(CompetitionType.Kata)"
                    >
                        🥋 Mode Kata (@tatami.AssignedKataPerformances.Count)
                    </button>
                </div>
            </div>
        }

        @if (tatami.CurrentDiscipline == CompetitionType.Kumite)
        {
            @if (!TournamentService.IsKataCompetitionFinished(tatamiId: TatamiId))
            {
                <div class="alert alert-warning border-warning d-flex align-items-center gap-2 mb-3 shadow-sm py-2 px-3">
                    <span class="fs-4">🥋</span>
                    <div>
                        <strong>Épreuves Kata en cours :</strong> Les katas se déroulent en premier sur ce tatami (@TournamentService.GetPendingKataCount(tatamiId: TatamiId) restant(s)). Les combats ne doivent être lancés qu'une fois les Katas de ce tatami terminés.
                    </div>
                </div>
            }

            var match = tatami.CurrentKumiteMatch;
            if (match == null)
            {
                <div class="card p-4 text-center my-4">
                    <h4>Aucun combat en cours sur ce tatami</h4>
                    <p class="text-muted">Sélectionnez un combat dans la liste ci-dessous pour démarrer.</p>
                </div>
            }
            else
            {
                <!-- Info combat actif -->
                <div class="card bg-dark text-white mb-3">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <span class="badge bg-warning text-dark fs-5 me-2">Match #@match.MatchNumber</span>
                            <span class="fs-4 fw-bold">@Lang[match.Category?.Name]</span>
                            <span class="badge bg-secondary ms-2 fs-6">@Lang[match.RoundName]</span>
                        </div>
                        <div>
                            @if (match.ExtensionsCount > 0)
                            {
                                <span class="badge bg-danger fs-5 px-3 py-2 me-2">
                                    ⚠️ @match.CurrentPeriodName
                                </span>
                            }
                            <span class="badge @(match.IsTimerRunning ? "bg-success" : "bg-warning text-dark") fs-5 px-3 py-2">
                                @(match.IsTimerRunning ? "EN COURS" : "ARRÊTÉ")
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Section Chronomètre & Prolongations -->
                <div class="card p-2 p-md-3 mb-3 text-center shadow-sm">
                    <div class="controller-timer-digits fw-bold font-monospace @(match.RemainingSeconds <= 10 ? "text-danger" : (match.IsTimerRunning ? "text-success" : "text-primary")) mb-2 mb-md-3">
                        @FormatSeconds(match.RemainingSeconds)
                    </div>

                    <div class="d-flex justify-content-center gap-2 flex-wrap mb-3">
                        <button class="btn @(match.IsTimerRunning ? "btn-warning" : "btn-success") btn-lg px-3 px-md-4 py-2 py-md-3 fs-5 fs-md-4 fw-bold flex-grow-1 flex-md-grow-0" @onclick="ToggleTimer" style="min-height: 52px;">
                            @(match.IsTimerRunning ? "⏸ PAUSE (Espace)" : "▶ DÉMARRER (Espace)")
                        </button>
                        <button class="btn btn-secondary btn-lg px-3 py-2 fs-6 fs-md-5" @onclick="ResetTimer" style="min-height: 52px;">
                            🔄 Remise à zéro
                        </button>
                    </div>

                    <!-- Bouton Prolongation -->
                    <div class="border-top pt-2 pt-md-3">
                        <button class="btn btn-danger btn-lg px-4 fw-bold w-100 w-md-auto" @onclick="AddExtension" style="min-height: 48px;">
                            ➕ PROLONGATION
                        </button>
                        <small class="d-block text-muted mt-1">
                            En cas d'égalité : ajoute une prolongation (@(match.Category?.KumiteExtensionDurationSeconds ?? 120)s) et réinitialise le chrono.
                        </small>
                    </div>
                </div>

                <!-- Section Scores AKA vs SHIRO -->
                <div class="row g-3 mb-4">
                    <!-- AKA (Rouge) -->
                    <div class="col-md-6">
                        <div class="card border-danger h-100 shadow">
                            <div class="card-header bg-danger text-white py-2">
                                <h4 class="mb-0 fw-bold">AKA</h4>
                                <h4 class="mb-0 fw-bold">@match.AkaDisplayName</h4>
                                <div 
                                    class="small d-flex align-items-center jusitify-content-center" 
                                    title="@(match.AkaCompetitor != null ? $"{match.AkaCompetitor.CountryFlag} {match.AkaCompetitor.Club}" : "")"
                                >
                                    <img 
                                        src="@match.AkaCompetitor?.FlagImageUrl"
                                        alt="@match.AkaCompetitor?.Country"
                                        title="@match.AkaCompetitor?.Country"
                                        class="border rounded-1 me-1 flex-shrink-0"
                                        style="width: 22px; height: 15px; object-fit: cover; vertical-align: middle; box-shadow: 0 1px 2px rgba(0,0,0,0.15);" 
                                    />
                                    <div class="auto-scroll-container">
                                        <span class="auto-scroll-content">@(match.AkaCompetitor != null ? $" {match.AkaCompetitor.Club}" : "")</span>
                                    </div>
                                </div>
                                <div class="mt-1 badge bg-secondary text-nowrap" style="font-size: 0.75rem;">
                                    <small class="auto-scroll-content">@match.AkaCompetitor?.GradeName</small>
                                </div>
                            </div>
                            <div class="card-body text-center">
                                <!-- <div class="row g-2 mb-3">
                                    <div class="col-6">
                                        <div class="p-2 border rounded bg-light">
                                            <div class="text-muted fw-bold">WAZA-ARI</div>
                                            <div class="display-4 fw-bold text-danger">@match.AkaWazaAri</div>
                                            <div class="btn-group mt-2 w-100">
                                                <button class="btn btn-outline-danger btn-sm" @onclick='() => AddScore(match.Id, CornerColor.Aka, "wazaari")'>+1</button>
                                                <button class="btn btn-outline-secondary btn-sm" @onclick='() => AddScore(match.Id, CornerColor.Aka, "remove_wazaari")'>-1</button>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="p-2 border rounded bg-light">
                                            <div class="text-muted fw-bold">IPPON</div>
                                            <div class="display-4 fw-bold text-danger">@match.AkaIppon</div>
                                            <button class="btn btn-danger btn-sm mt-2 w-100 fw-bold" @onclick='() => AddScore(match.Id, CornerColor.Aka, "ippon")'>
                                                + IPPON
                                            </button>
                                        </div>
                                    </div>
                                </div> -->

                                <!-- <div class="row g-2 mb-3">
                                    <div class="col-6">
                                        <div class="p-2 border rounded">
                                            <span class="text-muted">CHUI (Avertiss.) : </span>
                                            <strong class="text-warning fs-5">@match.AkaChui</strong>
                                            <div class="btn-group btn-group-sm w-100 mt-1">
                                                <button class="btn btn-outline-warning" @onclick='() => AddScore(match.Id, CornerColor.Aka, "chui")'>+1</button>
                                                <button class="btn btn-outline-secondary" @onclick='() => AddScore(match.Id, CornerColor.Aka, "remove_chui")'>-1</button>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="p-2 border rounded">
                                            <span class="text-muted">GENTEN (Pénalité) : </span>
                                            <strong class="text-danger fs-5">@match.AkaGenten</strong>
                                            <div class="btn-group btn-group-sm w-100 mt-1">
