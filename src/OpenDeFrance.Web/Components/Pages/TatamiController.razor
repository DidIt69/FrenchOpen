                                            </div>
                                        </div>
                                    </div>
                                </div> -->

                                <div class="d-grid gap-2">
                                    <button class="btn btn-dark btn-lg fw-bold" @onclick="() => DeclareWinner(CornerColor.Shiro, MatchWinnerReason.WazaAriDecision)">
                                        🏆 DÉCLARER VAINQUEUR SHIRO
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Liste des combats assignés sur ce tatami -->
            <div class="card">
                <div class="card-header bg-light d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <h5 class="mb-0 fw-bold">Combats Tatami @tatami.Number</h5>
                    <div class="d-flex align-items-center gap-2">
                        <span class="small fw-bold text-muted">Jour :</span>
                        <select class="form-select form-select-sm" style="width: auto;" @bind="selectedDayFilter">
                            <option value="0">Tous les jours</option>
                            @for (int d = 1; d <= tournamentDaysCount; d++)
                            {
                                <option value="@d">📅 Jour @d</option>
                            }
                        </select>
                        <span class="badge bg-secondary">@FilteredKumiteMatches.Count() combat(s)</span>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Jour</th>
                                <th>Catégorie</th>
                                <th>Tour</th>
                                <th>AKA</th>
                                <th>SHIRO</th>
                                <th>Statut</th>
                                <th>Vainqueur</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var m in FilteredKumiteMatches)
                            {
                                bool isCurrent = tatami.CurrentKumiteMatchId == m.Id;
                                <tr class="@(isCurrent ? "table-warning fw-bold" : "")">
                                    <td>#@m.MatchNumber</td>
                                    <td><span class="badge bg-light text-dark border">Jour @m.CompetitionDay</span></td>
                                    <td>@Lang[m.Category?.Name]</td>
                                    <td>@Lang[m.RoundName]</td>
                                    <td class="text-danger">@m.AkaDisplayName</td>
                                    <td class="text-dark">@m.ShiroDisplayName</td>
                                    <td>
                                        <span class="badge @(m.Status == MatchStatus.Finished ? "bg-success" : (isCurrent ? "bg-primary" : "bg-secondary"))">
                                            @m.Status
                                        </span>
                                    </td>
                                    <td>
                                        @(m.WinnerCompetitor != null ? $"🏆 {m.WinnerCompetitor.FullName}" : "-")
                                    </td>
                                    <td>
                                        @if (!isCurrent)
                                        {
                                            <button class="btn btn-sm btn-outline-primary" @onclick="() => SelectMatch(m.Id)">
                                                Mettre sur le tatami
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">Sur le tatami</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else
        {
            <!-- Controller KATA -->
            var kata = tatami.CurrentKataPerformance;
            <div class="card mb-3">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h4 class="mb-0 fw-bold">Saisie des notes Kata - Tatami @tatami.Number</h4>
                    @if (kata != null)
                    {
                        <span class="badge bg-light text-primary fs-6">
                            Passage #@kata.PerformanceOrder - @(kata.Round == KataRound.Turn1 ? "Tour 1" : "Tour 2 (Finale)")
                        </span>
                    }
                </div>
                <div class="card-body">
                    @if (kata == null)
                    {
                        <div class="text-center py-4">
                            <h5>Aucun passage en cours</h5>
                            <p class="text-muted">Sélectionnez un compétiteur dans la liste ci-dessous.</p>
                        </div>
                    }
                    else
                    {
                        <div class="row align-items-center mb-4">
                            <div class="col-md-7">
                                <h3>
                                    @if (kata.Competitor?.BibNumber.HasValue == true)
                                    {
                                        <span class="badge bg-warning text-dark me-2 fs-5 align-middle">#@kata.Competitor.BibNumber</span>
                                    }
                                    @kata.Competitor?.FullName
                                </h3>
                                <p class="lead mb-1">@kata.Competitor?.CountryWithFlag • @kata.Competitor?.Club • Grade : @kata.Competitor?.Grade</p>
                                <div class="badge bg-warning text-dark fs-5">
                                    Kata imposé : <strong>@kata.KataName</strong>
                                </div>
                            </div>
                            <div class="col-md-5 text-end">
                                <div class="text-muted">Note Finale Retenue :</div>
                                <div class="display-3 fw-bold text-primary">@(kata.FinalScore > 0 ? kata.FinalScore.ToString("0") : "-")</div>
                            </div>
                        </div>

                        <!-- Formulaire 5 juges -->
                        <h5 class="fw-bold mb-3">Notes des 5 Juges (de 50 à 99) :</h5>
                        <div class="row g-2 mb-3">
                            @for (int i = 0; i < 5; i++)
                            {
                                int idx = i;
                                <div class="col-4 col-sm-4 col-md">
                                    <label class="form-label fw-bold small text-nowrap">Juge @(idx + 1)</label>
                                    <input 
                                        type="number" 
                                        step="1" 
                                        min="50" 
                                        max="99" 
                                        class="form-control form-control-lg text-center fw-bold px-1"
                                        @bind="judgeInputScores[idx]" 
                                    />
                                </div>
                            }
                        </div>

                        <div class="d-flex flex-wrap gap-2">
                            <button 
                                class="btn btn-success btn-lg px-4 fw-bold flex-grow-1 flex-md-grow-0" 
                                @onclick="SubmitScores" 
                                style="min-height: 48px;"
                            >
                                💾 Valider et Enregistrer les Notes
                            </button>
                        </div>
                    }
                </div>
            </div>

            <!-- Liste des passages Kata -->
            <div class="card">
                <div class="card-header bg-light d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div class="d-flex align-items-center gap-3">
                        <h5 class="mb-0 fw-bold">Liste des passages Kata</h5>
                        <div class="d-flex align-items-center gap-1">
                            <span class="small fw-bold text-muted">Jour :</span>
                            <select class="form-select form-select-sm" style="width: auto;" @bind="selectedDayFilter">
                                <option value="0">Tous les jours</option>
                                @for (int d = 1; d <= tournamentDaysCount; d++)
                                {
                                    <option value="@d">📅 Jour @d</option>
                                }
                            </select>
                        </div>
                    </div>
                    @if (tatami.CurrentKataPerformance != null && tatami.CurrentKataPerformance.CategoryId > 0)
                    {
                        int catId = tatami.CurrentKataPerformance.CategoryId;
                        <div class="btn-group">
                            <button class="btn btn-primary btn-sm" @onclick="() => QualifyTour1(catId)">
                                🏁 Clôturer Tour 1 &amp; Qualifier les @(tatami.CurrentKataPerformance?.Category?.KataQualifiersCount ?? 4) meilleurs
                            </button>
                            <button class="btn btn-warning btn-sm" @onclick="() => FinalizeTour2(catId)">
                                🏆 Clôturer Tour 2 & Podium Final
                            </button>
                        </div>
                    }
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Ordre</th>
                                <th>Jour</th>
                                <th>Tour</th>
                                <th>Compétiteur</th>
                                <th>Club</th>
                                <th>Kata</th>
                                <th>Notes</th>
                                <th>Note</th>
                                <th>Rang</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in FilteredKataPerformances)
                            {
                                bool isCurrent = tatami.CurrentKataPerformanceId == p.Id;
                                <tr class="@(isCurrent ? "table-warning fw-bold" : "")">
                                    <td>#@p.PerformanceOrder</td>
                                    <td><span class="badge bg-light text-dark border">Jour @p.CompetitionDay</span></td>
                                    <td>
                                        <span class="badge @(p.Round == KataRound.Turn1 ? "bg-info text-dark" : "bg-warning text-dark")">
                                            @p.Round
                                        </span>
                                    </td>
                                    <td>@(p.Competitor != null ? p.Competitor.FullName : "(En attente de qualification)")</td>
                                    <td>@p.Competitor?.Club</td>
                                    <td>@p.KataName</td>
                                    <td><small class="text-muted">@p.ScoresDisplay</small></td>
                                    <td><strong class="fs-5 text-primary">@(p.FinalScore > 0 ? p.FinalScore.ToString("0") : "-")</strong></td>
                                    <td>
                                        @if (p.RankInRound.HasValue)
                                        {
                                            <span class="badge @(p.IsQualifiedForTour2 ? "bg-success" : "bg-secondary")">
                                                @(p.RankInRound.Value == 1 ? "🥇 1er" : (p.RankInRound.Value == 2 ? "🥈 2e" : (p.RankInRound.Value == 3 ? "🥉 3e" : $"{p.RankInRound}e")))
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (!isCurrent)
                                        {
                                            <button class="btn btn-sm btn-outline-primary" @onclick="() => SelectKata(p.Id)">
                                                Faire passer
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>

@code {
    [Parameter]
    public int TatamiId { get; set; }

    private Tatami? tatami;
    private List<Tatami> tatamis = new();
    private double[] judgeInputScores = new double[5];
    private int selectedDayFilter = 0;
    private int tournamentDaysCount = 1;
    private string pauseMessage = "";

    private IEnumerable<KumiteMatch> FilteredKumiteMatches => tatami != null
        ? tatami.AssignedKumiteMatches.Where(m => selectedDayFilter == 0 || m.CompetitionDay == selectedDayFilter).OrderBy(m => m.MatchNumber)
        : Enumerable.Empty<KumiteMatch>();

    private IEnumerable<KataPerformance> FilteredKataPerformances => tatami != null
        ? tatami.AssignedKataPerformances.Where(p => selectedDayFilter == 0 || p.CompetitionDay == selectedDayFilter).OrderBy(p => p.Round).ThenBy(p => p.PerformanceOrder)
        : Enumerable.Empty<KataPerformance>();

    protected override void OnInitialized()
    {
        RefreshData();
        TournamentService.OnTatamiUpdated += HandleTatamiUpdated;
        TournamentService.OnStateChanged += HandleStateChanged;
        Lang.OnLanguageChanged += HandleLanguageChanged;
    }

    protected override void OnParametersSet()
    {
        RefreshData();
    }

    private async void HandleLanguageChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    private void RefreshData()
    {
        var tournament = TournamentService.GetTournament();
        if (tournament != null)
        {
            tournamentDaysCount = Math.Max(1, tournament.DaysCount);
        }

        tatamis = TournamentService.GetTatamis();
        tatami = TournamentService.GetTatami(TatamiId);

        if (tatami?.CurrentKataPerformance != null && tatami.CurrentKataPerformance.JudgeScores.Count == 5)
        {
            for (int i = 0; i < 5; i++)
            {
                judgeInputScores[i] = tatami.CurrentKataPerformance.JudgeScores[i];
            }
        }
        else 
        {
            judgeInputScores = new double[5];
        }
    }

    private void SwitchDiscipline(CompetitionType mode)
    {
        TournamentService.SwitchTatamiMode(TatamiId, mode);
        RefreshData();
    }

    private async void HandleTatamiUpdated(int updatedTatamiId)
    {
        if (updatedTatamiId == TatamiId || updatedTatamiId == 0)
        {
            RefreshData();
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ToggleTimer()
    {
        TournamentService.ToggleTimer(TatamiId);
    }

    private void ResetTimer()
    {
        TournamentService.ResetTimer(TatamiId);
    }

    private void AdjustTimer(int delta)
    {
        TournamentService.AdjustTimer(TatamiId, delta);
    }

    private void AddExtension()
    {
        TournamentService.AddExtension(TatamiId);
    }

    private void AddScore(int matchId, CornerColor corner, string type)
    {
        TournamentService.AddScore(matchId, corner, type);
    }

    private void DeclareWinner(CornerColor corner, MatchWinnerReason reason)
    {
        if (tatami?.CurrentKumiteMatchId.HasValue == true)
        {
            TournamentService.DeclareWinner(tatami.CurrentKumiteMatchId.Value, corner, reason);
        }
    }

    private void SelectMatch(int matchId)
    {
        TournamentService.SetTatamiCurrentMatch(TatamiId, matchId);
    }

    private void SelectKata(int perfId)
    {
        TournamentService.SetTatamiCurrentKata(TatamiId, perfId);
        RefreshData();
    }

    private void SubmitScores()
    {
        if (tatami?.CurrentKataPerformanceId.HasValue == true)
        {
            // Arrondir et restreindre les notes entre 55 et 100
            for (int i = 0; i < 5; i++)
            {
                judgeInputScores[i] = Math.Clamp(Math.Round(judgeInputScores[i]), 55, 100);
            }

            TournamentService.SubmitKataScores(tatami.CurrentKataPerformanceId.Value, judgeInputScores.ToList());
            RefreshData();
        }
    }

    private void FillSampleScores()
    {
        var rand = new Random();
        for (int i = 0; i < 5; i++)
        {
            judgeInputScores[i] = rand.Next(70, 86); // Ex: 75, 82, 78, 80...
        }
    }

    private void QualifyTour1(int categoryId)
    {
        TournamentService.QualifyKataRound1(categoryId);
        RefreshData();
    }

    private void FinalizeTour2(int categoryId)
    {
        TournamentService.FinalizeKataRound2(categoryId);
        RefreshData();
    }

    private void TogglePause()
    {
        if (tatami == null) return;
        bool willPause = !tatami.IsPaused;
        TournamentService.SetTatamiPause(TatamiId, willPause, willPause ? pauseMessage : null);
        RefreshData();
    }

    private void UpdatePauseMessage()
    {
        if (tatami?.IsPaused == true)
        {
            TournamentService.SetTatamiPause(TatamiId, true, pauseMessage);
        }
    }

    private void PauseAll()
    {
        TournamentService.SetAllTatamisPause(true, pauseMessage);
        RefreshData();
    }

    private void ResumeAll()
    {
        TournamentService.SetAllTatamisPause(false);
        RefreshData();
    }

    private async Task PlayGong()
    {
        await JS.InvokeVoidAsync("tournamentAudio.playGong");
    }

    private string FormatSeconds(int seconds)
    {
        int m = seconds / 60;
        int s = seconds % 60;
        return $"{m:00}:{s:00}";
    }

    private async void HandleStateChanged()
    {
        RefreshData();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        TournamentService.OnTatamiUpdated -= HandleTatamiUpdated;
        TournamentService.OnStateChanged -= HandleStateChanged;
        Lang.OnLanguageChanged -= HandleLanguageChanged;
    }
}

