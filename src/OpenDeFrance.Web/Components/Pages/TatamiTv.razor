@page "/tatami/{TatamiId:int}/tv"
@attribute [Authorize(Roles = "Admin,Table,Tv,Streamer")]
@layout EmptyLayout
@rendermode InteractiveServer
@inject ITournamentService TournamentService
@inject IJSRuntime JS
@implements IDisposable
@inject ILanguageService Lang

<div class="tatami-tv-container">
    @if (tatami == null)
    {
        <div class="d-flex align-items-center justify-content-center h-100">
            <h1 class="text-danger">Tatami @TatamiId introuvable</h1>
        </div>
    }
    else
    {
        <!-- Header TV -->
        <header 
            class="tv-header d-flex justify-content-between align-items-center px-4 py-2" 
            style="justify-content:center !important;"
        >
            <div class="d-flex align-items-center gap-3">
                <span 
                    class="badge bg-warning text-dark fs-1 px-3 py-2 fw-bold"
                    style="font-size: 5rem !important;"
                >
                    TATAMI @tatami.Number
                </span>
            </div>
        </header>

        <!-- Main Content -->
        @if (tatami.IsPaused)
        {
            <!-- ========== ECRAN PAUSE / PUBLICITE ========== -->
            var ads = TournamentService.GetAdvertisements(onlyActive: true)
                                       .OrderBy(a => a.OrderIndex).ToList();
            @if (ads.Count > 0)
            {
                var ad = ads[currentAdIndex % ads.Count];
                <div class="pause-screen d-flex flex-column align-items-center justify-content-center text-center">
                    @if (!string.IsNullOrEmpty(ad.ImageUrl))
                    {
                        <img 
                            src="@ad.ImageUrl" 
                            alt="@ad.Title"
                            style="max-width: 70%; max-height: 45vh; object-fit: contain; margin-bottom: 24px; border-radius: 12px;" 
                        />
                    }

                    @if (!string.IsNullOrEmpty(ad.LogoUrl))
                    {
                        <img 
                            src="@ad.LogoUrl" 
                            alt="logo"
                            style="max-height: 80px; object-fit: contain; margin-bottom: 16px;" 
                        />
                    }
                    
                    <h1 class="display-3 fw-bold text-white mb-2">@ad.Title</h1>
                    
                    @if (!string.IsNullOrEmpty(ad.Subtitle))
                    {
                        <h3 class="text-warning mb-3">@ad.Subtitle</h3>
                    }
                    
                    @if (!string.IsNullOrEmpty(ad.Description))
                    {
                        <p class="fs-4 text-light mb-4" style="max-width: 700px;">@ad.Description</p>
                    }
                    
                    @if (!string.IsNullOrEmpty(ad.WebsiteUrl))
                    {
                        <div class="badge bg-warning text-dark fs-5 px-4 py-2 mb-4">🌐 @ad.WebsiteUrl</div>
                    }
                    
                    <!-- Indicateurs de slides -->
                    <div class="d-flex gap-2 mt-3">
                        @for (int i = 0; i < ads.Count; i++)
                        {
                            int idx = i;
                            <span style="width: 12px; height: 12px; border-radius: 50%; display: inline-block;
                                         background: @(idx == currentAdIndex % ads.Count ? "#ffd700" : "rgba(255,255,255,0.3)");
                                         transition: background 0.4s;">
                            </span>
                        }
                    </div>
                </div>
            }
            else
            {
                <!-- Pas de pub configurée : écran de pause générique -->
                <div class="empty-screen d-flex flex-column align-items-center justify-content-center p-5 text-center">
                    <div class="display-1 mb-4">⏸</div>
                    <h1 class="display-3 fw-bold text-warning mb-3">PAUSE</h1>
                    @if (!string.IsNullOrEmpty(tatami.PauseMessage))
                    {
                        <p class="fs-3 text-light">@tatami.PauseMessage</p>
                    }
                    else
                    {
                        <p class="fs-3 text-muted">La compétition reprend bientôt…</p>
                    }
                </div>
            }
        }
        else if (tatami.CurrentDiscipline == CompetitionType.Kumite)
        {
            if (!TournamentService.IsKataCompetitionFinished(tatamiId: TatamiId))
            {
                <div class="empty-screen d-flex flex-column align-items-center justify-content-center p-5 text-center">
                    <div class="display-1 mb-3">🥋</div>
                    <h1 class="display-4 text-warning fw-bold mb-3">ÉPREUVES KATA EN COURS</h1>
                    <p class="fs-3 text-light mb-4">Les épreuves Kata se déroulent en premier sur ce tatami.</p>
                    <div class="badge bg-primary fs-3 px-4 py-2">
                        ⏳ @TournamentService.GetPendingKataCount(tatamiId: TatamiId) passage(s) restant(s) avant les combats
                    </div>
                </div>
            }
            else
            {
                var match = tatami.CurrentKumiteMatch;
                if (match == null)
                {
                    <div class="empty-screen d-flex flex-column align-items-center justify-content-center">
                        <h2 class="display-4 text-secondary mb-3">En attente du prochain combat...</h2>
                        <p class="fs-4 text-muted">Tatami @tatami.Number en préparation</p>
                    </div>
                }
                else
                {
                    <!-- Match Details Bar -->
                    <div class="match-info-bar px-3">
                        <div class="container-fluid w-100">
                            <div class="row align-items-center">
                                <!-- Colonne 1 -->
                                <div class="col-3 border p-3 text-center">
                                    <span class="fw-bold text-warning" style="font-size: 4rem !important;">Match #@match.MatchNumber</span>
                                </div>

                                <!-- Colonne 2 -->
                                <div class="col border p-3 text-center">
                                    <span class="fw-bold text-white" style="font-size: 4rem !important;">@Lang[match.Category?.Name]</span>
                                </div>

                                <!-- Colonne 3 -->
                                <div class="col-3 border p-3 text-center">
                                    <span class="text-uppercase" style="font-size: 4rem !important;">@Lang[match.RoundName]</span>
                                </div>
                            </div>            
                        </div>                        
                    </div>

                    <!-- Timer & Prolongation Display -->
                    <div class="timer-section text-center py-2">
                        @if (match.ExtensionsCount > 0)
                        {
                            <div class="extension-banner mb-2">
                                <span class="badge bg-danger fs-3 px-4 py-2 text-uppercase animate-pulse">
                                    ⚠️ @match.CurrentPeriodName
                                </span>
                            </div>
                        }

                        <div 
                            class="timer-digits @(match.IsTimerRunning ? "running" : "paused") @(match.RemainingSeconds <= 10 ? "critical" : "")"
                             style="font-size: 18rem !important;"
                         >
                            @FormatSeconds(match.RemainingSeconds)
                        </div>
                    </div>

                    <!-- Two Corners: AKA (Red) vs SHIRO (White) -->
                    <div class="corners-grid-vs">
                        <!-- AKA Corner -->
                        <div 
                            class="align-content-center corner-box aka-corner @(match.WinnerCompetitorId == match.AkaCompetitorId && match.Status == MatchStatus.Finished ? "winner-glow" : "")"
                            style="display:block !important;"
                        >
                            <div class="fighter-name d-flex justify-content-center align-items-center">
                                @if (match.AkaCompetitor?.BibNumber.HasValue == true)
                                {
                                    <span class="badge bg-warning text-dark me-2 fs-3 align-middle">#@match.AkaCompetitor.BibNumber</span>
                                }
                                @(match.AkaCompetitor?.FullName ?? "En attente...")
                            </div>
                            <div class="fighter-details d-flex align-items-center justify-content-center text-center fs-1">
                                <img 
                                    src="@match.AkaCompetitor?.FlagImageUrl"
                                    alt="@match.AkaCompetitor.Country"
                                    title="@match.AkaCompetitor.Country"
                                    class="border rounded-1 me-1 flex-shrink-0"
                                    style="width: 44px; height: 30px; object-fit: cover; vertical-align: middle; box-shadow: 0 1px 2px rgba(0,0,0,0.15);" 
                                />
                                @(match.AkaCompetitor != null ? $"{match.AkaCompetitor.Club}" : "")
                            </div>
                            <div class="fighter-details text-center fs-2">
                                @(match.AkaCompetitor != null ? $"{match.AkaCompetitor.GradeName}" : "")
                            </div>

                            @if (match.WinnerCompetitorId == match.AkaCompetitorId && match.Status == MatchStatus.Finished)
                            {
                                <div class="winner-stamp">VAINQUEUR</div>
                            }
                        </div>

                        <div class="align-items-center d-flex" style="font-size:50px;font-weight:bold;">
                            VS
                        </div>

                        <!-- SHIRO Corner -->
                        <div 
                            class="align-content-center corner-box shiro-corner @(match.WinnerCompetitorId == match.ShiroCompetitorId && match.Status == MatchStatus.Finished ? "winner-glow" : "")"
                            style="display:block !important;"
                        >
                            <div class="fighter-name d-flex justify-content-center align-items-center">
                                @if (match.ShiroCompetitor?.BibNumber.HasValue == true)
                                {
                                    <span class="badge bg-warning text-dark me-2 fs-3 align-middle">#@match.ShiroCompetitor.BibNumber</span>
                                }
                                @(match.ShiroCompetitor?.FullName ?? "En attente...")
                            </div>
                            <div class="fighter-details d-flex align-items-center justify-content-center text-center fs-1">
                               <img 
                                    src="@match.ShiroCompetitor?.FlagImageUrl"
                                    alt="@match.ShiroCompetitor.Country"
                                    title="@match.ShiroCompetitor.Country"
                                    class="border rounded-1 me-1 flex-shrink-0"
                                    style="width: 44px; height: 30px; object-fit: cover; vertical-align: middle; box-shadow: 0 1px 2px rgba(0,0,0,0.15);" 
                                />
                                @(match.ShiroCompetitor != null ? $"{match.ShiroCompetitor.Club}" : "")
                            </div>
                            <div class="fighter-details text-center fs-2">
                                @(match.AkaCompetitor != null ? $"{match.AkaCompetitor.GradeName}" : "")
                            </div>

                            @if (match.WinnerCompetitorId == match.ShiroCompetitorId && match.Status == MatchStatus.Finished)
                            {
                                <div class="winner-stamp">VAINQUEUR</div>
                            }
                        </div>
                    </div>
                }
            }
        }
        else
        {
            <!-- Kata TV View -->
            var kata = tatami.CurrentKataPerformance;
            if (kata == null)
            {
                <div class="empty-screen d-flex flex-column align-items-center justify-content-center">
                    <h2 class="display-4 text-secondary mb-3">En attente de la compétition Kata...</h2>
                    <p class="fs-4 text-muted">Tatami @tatami.Number en préparation</p>
                </div>
            }
            else
            {
                <!-- Match Details Bar -->
                <div class="match-info-bar px-3">
                    <div class="container-fluid w-100">
                        <div class="row align-items-center">
                            <!-- Colonne 1 -->
                            <div class="col-3 border p-3 text-center">
                                <span class="fw-bold text-warning" style="font-size: 4rem !important;">Kata #@kata.PerformanceOrder</span>
                            </div>

                            <!-- Colonne 2 -->
                            <div class="col border p-3 text-center">
                                <span class="fw-bold text-white" style="font-size: 4rem !important;">@Lang[kata.Category?.Name]</span>
                            </div>

                            <!-- Colonne 3 -->
                            <div class="col-3 border p-3 text-center">
                                <span class="text-uppercase" style="font-size: 4rem !important;">@(kata.Round == KataRound.Turn1 ? "Eliminatoire" : "Finale")</span>
                            </div>
                        </div>            
                    </div>                        
                </div>

                <div class="kata-details-card text-center my-4">
                    <div class="display-1 fw-bolder text-warning text-uppercase mb-4">@kata.KataName</div>

                    <div 
                        class="fighter-name d-flex justify-content-center align-items-center"
                        style="font-size:5rem;"
                    >
                        @if (kata.Competitor?.BibNumber.HasValue == true)
                        {
                            <span class="badge bg-warning text-dark me-3 fs-2 align-middle">#@kata.Competitor.BibNumber</span>
                        }
                        @kata.Competitor?.FullName
                    </div>
                    <div 
                        class="fighter-details d-flex align-items-center justify-content-center text-center"
                        style="font-size:3rem;"
                    >
                        <img 
                            src="@kata.Competitor?.FlagImageUrl"
                            alt="@kata.Competitor?.Country"
                            title="@kata.Competitor?.Country"
                            class="border rounded-1 me-1 flex-shrink-0"
                            style="width: 46px; height: 35px; object-fit: cover; vertical-align: middle; box-shadow: 0 1px 2px rgba(0,0,0,0.15);" 
                        />
                        @(kata.Competitor != null ? $"{kata.Competitor.Club}" : "")
                    </div>
                    <div 
                        class="fighter-details text-center"
                        style="font-size:2rem;"
                    >
                        @(kata.Competitor != null ? $"{kata.Competitor.GradeName}" : "")
                    </div>

                    <!-- Judges scores grid -->
                    <div class="judges-grid-container my-4">
                        <div class="d-flex justify-content-center gap-4">
                            @for (int j = 0; j < 5; j++)
                            {
                                int judgeNum = j + 1;
                                double? score = kata.JudgeScores.Count > j ? kata.JudgeScores[j] : null;
                                bool isLowest = score.HasValue && score == kata.DroppedLowestScore;
                                bool isHighest = score.HasValue && score == kata.DroppedHighestScore;

                                <div class="judge-score-box @(isLowest ? "dropped" : "") @(isHighest ? "dropped" : "")">
                                    <div class="judge-num">Juge @judgeNum</div>
                                    <div class="judge-val">
                                        @(score.HasValue ? score.Value.ToString("0") : "--")
                                    </div>
                                    @if (isLowest)
                                    {
                                        <div class="dropped-badge">Note basse</div>
                                    }
                                    else if (isHighest)
                                    {
                                        <div class="dropped-badge">Note haute</div>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Final Score Badge -->
                    @if (kata.FinalScore > 0)
                    {
                        <div class="final-score-container mt-4">
                            <span class="fs-3 text-secondary text-uppercase fw-bold me-3">Note Finale Retenue :</span>
                            <span class="display-2 fw-black text-warning">@kata.FinalScore.ToString("0")</span>
                        </div>
                    }
                </div>
            }
        }
    }
</div>

@code {
    [Parameter]
    public int TatamiId { get; set; }

    private Tatami? tatami;
    private int currentAdIndex = 0;
    private System.Threading.Timer? _adTimer;

    protected override void OnInitialized()
    {
        RefreshData();
        TournamentService.OnTatamiUpdated += HandleTatamiUpdated;
        TournamentService.OnTimerZero += HandleTimerZero;
        Lang.OnLanguageChanged += HandleLanguageChanged;

        // Timer de rotation des publicités (toutes les 8s par défaut)
        _adTimer = new System.Threading.Timer(async _ =>
        {
            if (tatami?.IsPaused == true)
            {
                var ads = TournamentService.GetAdvertisements(onlyActive: true);
                if (ads.Count > 1)
                {
                    // Durée dynamique selon la pub courante
                    currentAdIndex++;
                }
                await InvokeAsync(StateHasChanged);
            }
        }, null, TimeSpan.FromSeconds(8), TimeSpan.FromSeconds(8));
    }

    private async void HandleLanguageChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    protected override void OnParametersSet()
    {
        RefreshData();
    }

    private void RefreshData()
    {
        tatami = TournamentService.GetTatami(TatamiId);
    }

    private async void HandleTatamiUpdated(int updatedTatamiId)
    {
        if (updatedTatamiId == TatamiId || updatedTatamiId == 0)
        {
            RefreshData();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async void HandleTimerZero(int zeroTatamiId)
    {
        if (zeroTatamiId == TatamiId)
        {
            await JS.InvokeVoidAsync("tournamentAudio.playBuzzer");
        }
    }

    private string FormatSeconds(int seconds)
    {
        int m = seconds / 60;
        int s = seconds % 60;
        return $"{m:00}:{s:00}";
    }

    public void Dispose()
    {
        TournamentService.OnTatamiUpdated -= HandleTatamiUpdated;
        TournamentService.OnTimerZero -= HandleTimerZero;
        Lang.OnLanguageChanged -= HandleLanguageChanged;

       _adTimer?.Dispose();
    }
}

<style>
    .pause-screen {
        background: linear-gradient(135deg, #0d121d 0%, #1b2838 100%);
        color: white;
        min-height: calc(100vh - 70px);
        padding: 40px 60px;
        animation: fadeIn 0.5s ease;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    .tatami-tv-container {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        width: 100vw;
        background: radial-gradient(circle at 50% 30%, #151d30 0%, #080c14 100%);
        color: #fff;
        user-select: none;
        overflow-y: auto;
        overflow-x: hidden;
    }

    .tv-header {
        background: #0d121d;
        border-bottom: 2px solid #283347;
    }

    .match-info-bar {
        background: #172133;
        border-bottom: 1px solid #283347;
    }

    .timer-section {
        background: rgba(0, 0, 0, 0.3);
        border-bottom: 2px solid #222d3f;
    }

    .timer-digits {
        font-family: 'Courier New', Courier, monospace;
        font-size: clamp(3.5rem, 12vw, 8rem);
        font-weight: 900;
        line-height: 1;
        letter-spacing: 2px;
        text-shadow: 0 0 30px rgba(0, 255, 128, 0.4);
    }

    .timer-digits.running {
        color: #00ff88;
    }

    .timer-digits.paused {
        color: #ffbb00;
        text-shadow: 0 0 30px rgba(255, 187, 0, 0.4);
    }

    .timer-digits.critical {
        color: #ff3344;
        text-shadow: 0 0 40px rgba(255, 51, 68, 0.8);
        animation: pulse 1s infinite;
    }

    .corners-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        flex: 1;
        padding: 20px 30px;
    }

    .corners-grid-vs {
        display: grid;
        grid-template-columns: 1fr 65px 1fr;
        gap: 20px;
        flex: 1;
        padding: 20px 30px;
    }

    .corner-box {
        position: relative;
        border-radius: 16px;
        padding: 24px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    }

    .aka-corner {
        background: linear-gradient(135deg, #7a0914 0%, #3a0006 100%);
        border: 3px solid #ff2233;
    }

    .shiro-corner {
        background: linear-gradient(135deg, #2b3952 0%, #151d2c 100%);
        border: 3px solid #e0e6ed;
    }

    .winner-glow {
        box-shadow: 0 0 50px rgba(255, 215, 0, 0.8);
        border-color: #ffd700 !important;
    }

    .corner-title {
        font-size: clamp(1.2rem, 3.5vw, 2.2rem);
        letter-spacing: 3px;
    }

    .fighter-name {
        font-size: clamp(1.5rem, 5vw, 3.2rem);
        font-weight: 900;
        line-height: 1.1;
        margin: 10px 0;
    }

    .scores-row {
        display: flex;
        justify-content: space-around;
        gap: 15px;
    }

    .score-card {
        flex: 1;
        background: rgba(0,0,0,0.4);
        border-radius: 12px;
        padding: 10px;
        text-align: center;
        border: 2px solid rgba(255,255,255,0.2);
    }

    .score-card.active {
        background: #ffd700;
        color: #000;
        border-color: #fff;
    }

    .score-label {
        display: block;
        font-size: 1.2rem;
        font-weight: bold;
    }

    .score-value {
        font-size: 3.5rem;
        font-weight: 900;
        line-height: 1;
    }

    .penalties-row {
        display: flex;
        justify-content: space-around;
        gap: 15px;
    }

    .penalty-tag {
        flex: 1;
        text-align: center;
        padding: 8px;
        font-size: 1.3rem;
        font-weight: bold;
        background: rgba(0,0,0,0.3);
        border-radius: 8px;
    }

    .penalty-tag.active {
        background: #ff5500;
        color: #fff;
    }

    .winner-stamp {
        position: absolute;
        top: 40%;
        left: 50%;
        transform: translate(-50%, -50%) rotate(-12deg);
        background: #ffd700;
        color: #000;
        font-size: 3rem;
        font-weight: 900;
        padding: 15px 40px;
        border-radius: 12px;
        border: 4px solid #fff;
        box-shadow: 0 0 30px rgba(0,0,0,0.8);
    }

    .tv-footer {
        background: #0d121d;
        border-top: 2px solid #283347;
    }

    .judge-score-box {
        background: #192438;
        border: 2px solid #3b4e72;
        border-radius: 12px;
        padding: 15px 25px;
        min-width: 160px;
        text-align: center;
    }

    .judge-score-box.dropped {
        opacity: 0.4;
        text-decoration: line-through;
        border-color: #666;
    }

    .judge-num {
        font-size: 1.5rem;
        color: #9ab;
    }

    .judge-val {
        font-size: 3.2rem;
        font-weight: 900;
        color: #fff;
    }

    .dropped-badge {
        font-size: 0.9rem;
        color: #ff7788;
        text-decoration: none !important;
    }

    @@keyframes pulse {
        0% { transform: scale(1); }
        50% { transform: scale(1.03); }
        100% { transform: scale(1); }
    }

    @@media (max-width: 767.98px) {
        .corners-grid {
            grid-template-columns: 1fr;
            padding: 12px;
            gap: 14px;
        }

        .corner-box {
            padding: 16px;
        }

        .match-info-bar {
            flex-direction: column;
            gap: 6px;
            text-align: center;
        }

        .judges-grid-container .d-flex {
            flex-wrap: wrap;
            gap: 8px !important;
        }

        .judge-score-box {
            min-width: 55px;
            padding: 8px 10px;
        }

        .judge-val {
            font-size: 2rem;
        }
    }
</style>
