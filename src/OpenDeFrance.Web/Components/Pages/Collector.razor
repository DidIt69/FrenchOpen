@page "/collector"
@attribute [Authorize(Roles = "Admin,Table,Collector")]
@rendermode InteractiveServer
@inject ITournamentService TournamentService
@implements IDisposable
@inject ILanguageService Lang

<PageTitle>Chambre d'Appel (Collector) - Open de France</PageTitle>

<div class="container-fluid py-3">
    <!-- En-tête Chambre d'Appel -->
    <div 
        class="card border-0 shadow-sm mb-2" 
        style="background: linear-gradient(135deg, #064e3b 0%, #022c22 100%); color: white; border-left: 5px solid #10b981 !important;"
    >
        <div class="card-body py-3">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <h2 class="mb-0 fw-bold fs-4">
                            🏃 Collector
                        </h2>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-1 flex-wrap">
                    @if (checkedKeys.Count > 0)
                    {
                        <button class="btn btn-sm btn-outline-light" @onclick="ClearCheckedKeys">
                            🔄 Réinitialiser
                        </button>
                    }
                    <button class="btn btn-sm btn-outline-success text-white" @onclick="RefreshData">
                        🔄 Actualiser
                    </button>
                    <button class="btn btn-primary" @onclick="OpenInfo">
                        <svg xmlns="http://w3.org" width="16" height="16" viewBox="0 0 18 18">
                            <rect fill="#FFFFFF" x="8" y="7" width="2" height="7"/>
                            <rect fill="#FFFFFF" x="8" y="3" width="2" height="2"/>
                            <circle fill="none" stroke="#FFFFFF" stroke-width="2" stroke-miterlimit="10" cx="9" cy="9" r="8"/>
                        </svg>
                    </button>
                    <button class="btn btn-primary" @onclick="OpenFilter">
                        @if(selectedTatamiId == 0 && selectedDayFilter == 0 && selectedUrgencyFilter == "all" && searchTerm == string.Empty) 
                        {
                            <svg xmlns="http://w3.org" width="16" height="16" fill="currentColor" class="bi bi-funnel" viewBox="0 0 16 16">
                                <path d="M1.5 1.5A.5.5 0 0 1 2 1h12a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-.128.334L10 8.692V13.5a.5.5 0 0 1-.342.474l-3 1A.5.5 0 0 1 6 14.5V8.692L1.128 3.834A.5.5 0 0 1 1 3.5zm1 .5v1.308l4.372 4.858A.5.5 0 0 1 7 8.5v5.306l2-.666V8.5a.5.5 0 0 1 .128-.334L13.5 3.308V2z"/>
                            </svg>
                        } 
                        else 
                        {
                            <svg xmlns="http://w3.org" width="16" height="16" fill="currentColor" class="bi bi-funnel-fill" viewBox="0 0 16 16">
                                <path d="M1.5 1.5A.5.5 0 0 1 2 1h12a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-.128.334L10 8.692V13.5a.5.5 0 0 1-.342.474l-3 1A.5.5 0 0 1 6 14.5V8.692L1.128 3.834A.5.5 0 0 1 1 3.5z"/>
                            </svg>
                        }   
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Liste des Compétiteurs sous forme de cartes d'appel tactiles -->
    @if (!FilteredItems.Any())
    {
        <div class="card p-5 text-center bg-light border-0 shadow-sm my-4">
            <div class="display-4 text-muted mb-2">🥋</div>
            <h5 class="text-secondary">Aucun compétiteur à appeler actuellement</h5>
            <p class="text-muted small">Tous les compétiteurs des prochains combats sont en place ou aucun combat n'est programmé selon les filtres.</p>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var item in FilteredItems)
            {
                bool isChecked = checkedKeys.Contains(item.Key);

                <div class="col-12">
                    <div class="card h-100 shadow-sm border-2 @(isChecked ? "border-success bg-success-subtle opacity-75" : (item.Urgency == CollectorUrgency.NextUp ? "border-danger" : "border-primary"))">
                        <!-- En-tête de la carte : Tatami & Priorité -->
                        <div class="card-header py-2 d-flex justify-content-between align-items-center @(isChecked ? "bg-success text-white" : (item.Urgency == CollectorUrgency.NextUp ? "bg-danger text-white" : "bg-dark text-white"))">
                            <div class="d-flex align-items-center gap-1">
                                <span class="badge bg-warning text-dark fw-bold fs-6">
                                    🥋 @item.TatamiName
                                </span>
                                @if (tournamentDaysCount > 1)
                                {
                                    <span class="badge bg-light text-dark">Jour @item.CompetitionDay</span>
                                }
                            </div>
                            <div>
                                @if (isChecked)
                                {
                                    <span class="badge bg-white text-success fw-bold">✅ AU TATAMI</span>
                                }
                                else if (item.Urgency == CollectorUrgency.Current)
                                {
                                    <span class="badge bg-warning text-dark animate-pulse fw-bold">TATAMI</span>
                                }
                                else if (item.Urgency == CollectorUrgency.NextUp)
                                {
                                    <span class="badge bg-warning text-dark fw-bold">🚨 PROCHAIN</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">⏳ Dans @item.QueuePosition Match</span>
                                }
                            </div>
                        </div>

                        <!-- Corps de la carte : Athlète, Dossard, Club -->
                        <div class="card-body p-3">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div class="auto-scroll-container mb-1">
                                    <!-- Dossard géant -->
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <span class="badge @(item.Corner == CornerColor.Aka ? "bg-danger" : (item.Corner == CornerColor.Shiro ? "bg-dark" : "bg-primary"))">
                                            @(item.Corner == CornerColor.Aka ? "🔴 COIN AKA" : (item.Corner == CornerColor.Shiro ? "⚪ COIN SHIRO" : "🥋 KATA"))
                                        </span>
                                    </div>
                                    <h4 class="fw-bold mb-0 auto-scroll-content">@item.FullName</h4>
                                </div>

                                <!-- Bouton interactif pour pointer l'athlète -->
                                <button 
                                    class="btn btn-sm @(isChecked ? "btn-success" : "btn-outline-success") fw-bold px-3 py-2"
                                    style="min-width:93px;width:93px;"
                                    @onclick="() => ToggleChecked(item.Key)"
                                    title="@(isChecked ? "Marqué comme présent" : "Cliquer pour marquer comme présent")"
                                >
                                    @(isChecked ? "✅ En place" : "🔘 Valider")
                                </button>
                            </div>

                            <!-- Informations Dojo & Pays -->
                            <div class="p-2 rounded bg-light border mb-2">
                                <div class="text-black d-flex align-items-center">
                                    <img 
                                        src="/flags/@(item?.Country).png"
                                        alt="@item?.Country"
                                        title="@item?.Country"
                                        class="border rounded-1 me-1 flex-shrink-0"
                                        style="width: 22px; height: 15px; object-fit: cover; vertical-align: middle; box-shadow: 0 1px 2px rgba(0,0,0,0.15);" 
                                    />
                                    <div class="auto-scroll-container">
                                        <span class="auto-scroll-content">@(item != null ? $" {item.Club}" : "")</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Épreuve & Détails -->
                            <div class="small text-muted d-flex justify-content-between align-items-center">
                                <span>@Lang[item.CategoryName]</span>
                                <span class="badge bg-secondary-subtle text-dark border">@Lang[item.RoundName]</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(item.KataName))
                            {
                                <div class="mt-1 small text-primary fw-bold">
                                    Kata imposé : @item.KataName
                                </div>
                            }
                        </div>

                        <div class="card-footer bg-white py-1 px-3 d-flex justify-content-between align-items-center small text-muted">
                            <span>Rencontre #@item.OrderNumber</span>
                            <span>@(item.IsKata ? "Kata" : "Kumite")</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @if(isFilterOpen) 
    {
        <!-- Le fond noir semi-transparent (Backdrop) -->
        <div class="modal-backdrop fade show"></div>

        <!-- La structure de la modale Bootstrap -->
        <div class="modal fade show d-block" tabindex="-1" role="dialog">
            <div class="modal-dialog modal-dialog-centered" role="document">
                <div class="modal-content bg-dark">                
                    <!-- En-tête -->
                    <div class="modal-header">
                        <h5 class="modal-title text-white">@Lang["Filter"]</h5>
                        <button 
                            type="button" 
                            style="margin: calc(-0.5rem) calc(-0.5rem) calc(-0.5rem) auto;background: transparent;border: 0px;"
                            @onclick="CloseFilter" 
                        >
                            <svg xmlns='http://www.w3.org/2000/svg' width="16" height="16" fill="#FFF" class="bi bi-funnel-fill" viewBox="0 0 16 16">
                                <path d='M.293.293a1 1 0 0 1 1.414 0L8 6.586 14.293.293a1 1 0 1 1 1.414 1.414L9.414 8l6.293 6.293a1 1 0 0 1-1.414 1.414L8 9.414l-6.293 6.293a1 1 0 0 1-1.414-1.414L6.586 8 .293 1.707a1 1 0 0 1 0-1.414z'/>
                            </svg>
                        </button>
                    </div>
                
                    <!-- Corps -->
                    <div class="modal-body d-flex gap-2 align-self-center">
                        <!-- Barre de Filtres Rapides -->
                        <div class="card border-0 shadow-sm mb-3">
                            <div class="card-body py-2 px-3">
                                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                                    <!-- Filtre Tatamis -->
                                    <div class="d-flex align-items-center gap-2 flex-wrap">
                                        <span class="small fw-bold text-muted">Tatami :</span>
                                        <div class="btn-group btn-group-sm">
                                            <button 
                                                class="btn @(selectedTatamiId == 0 ? "btn-dark fw-bold" : "btn-outline-secondary")"
                                                @onclick="() => selectedTatamiId = 0"
                                            >
                                                Tous (@tatamis.Count)
                                            </button>
                                            @foreach (var t in tatamis)
                                            {
                                                int tId = t.Id;
                                                <button 
                                                    class="btn @(selectedTatamiId == tId ? "btn-success fw-bold text-white" : "btn-outline-secondary")"
                                                    @onclick="() => selectedTatamiId = tId"
                                                >
                                                    🥋 @t.Name
                                                </button>
                                            }
                                        </div>
                                    </div>

                                    <!-- Filtre Jours -->
                                    @if (tournamentDaysCount > 1)
                                    {
                                        <div class="d-flex align-items-center gap-2 flex-wrap">
                                            <span class="small fw-bold text-muted">Jour :</span>
                                            <div class="btn-group btn-group-sm">
                                                <button 
                                                    class="btn @(selectedDayFilter == 0 ? "btn-dark fw-bold" : "btn-outline-secondary")"
                                                    @onclick="() => selectedDayFilter = 0"
                                                >
                                                    Tous
                                                </button>
                                                @for (int d = 1; d <= tournamentDaysCount; d++)
                                                {
                                                    int dayNum = d;
                                                    <button 
                                                        class="btn @(selectedDayFilter == dayNum ? "btn-warning text-dark fw-bold" : "btn-outline-secondary")"
                                                        @onclick="() => selectedDayFilter = dayNum"
                                                    >
                                                        📅 Jour @dayNum
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    }

                                    <!-- Filtre Urgence -->
                                    <div class="d-flex align-items-center gap-2 flex-wrap">
                                        <span class="small fw-bold text-muted">Vue :</span>
                                        <div class="btn-group btn-group-sm">
                                            <button 
                                                class="btn @(selectedUrgencyFilter == "all" ? "btn-secondary active" : "btn-outline-secondary")"
                                                @onclick='() => selectedUrgencyFilter = "all"'
                                            >
                                                Tout
                                            </button>
                                            <button 
                                                class="btn @(selectedUrgencyFilter == "next" ? "btn-danger text-white active" : "btn-outline-secondary")"
                                                @onclick='() => selectedUrgencyFilter = "next"'
                                            >
                                                🚨 Immédiats (Prochains)
                                            </button>
                                            <button 
                                                class="btn @(selectedUrgencyFilter == "upcoming" ? "btn-primary active" : "btn-outline-secondary")"
                                                @onclick='() => selectedUrgencyFilter = "upcoming"'
                                            >
                                                ⏳ À venir (+2 combats)
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Recherche -->
                                    <div style="min-width: 200px;">
                                        <input 
                                            type="text" 
                                            class="form-control form-control-sm" placeholder="🔍 Rechercher dossard, nom, club..."
                                            @bind="searchTerm" @bind:event="oninput" 
                                        />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                
                    <!-- Pied de page -->
                    <div class="modal-footer">
                        <button 
                            type="button" 
                            class="btn class-secondary text-white" 
                            @onclick="CloseFilter"
                        >
                            Fermer
                        </button>
                    </div>            
                </div>
            </div>
        </div>
    }

    @if(isInfoOpen) 
    {
        <!-- Le fond noir semi-transparent (Backdrop) -->
        <div class="modal-backdrop fade show"></div>

        <!-- La structure de la modale Bootstrap -->
        <div class="modal fade show d-block" tabindex="-1" role="dialog">
            <div class="modal-dialog modal-dialog-centered" role="document">
                <div class="modal-content bg-dark">                
                    <!-- En-tête -->
                    <div class="modal-header">
                        <h5 class="modal-title text-white">@Lang["Info"]</h5>
                        <button 
                            type="button" 
                            style="margin: calc(-0.5rem) calc(-0.5rem) calc(-0.5rem) auto;background: transparent;border: 0px;"
                            @onclick="CloseInfo" 
                        >
                            <svg xmlns='http://www.w3.org/2000/svg' width="16" height="16" fill="#FFF" class="bi bi-funnel-fill" viewBox="0 0 16 16">
                                <path d='M.293.293a1 1 0 0 1 1.414 0L8 6.586 14.293.293a1 1 0 1 1 1.414 1.414L9.414 8l6.293 6.293a1 1 0 0 1-1.414 1.414L8 9.414l-6.293 6.293a1 1 0 0 1-1.414-1.414L6.586 8 .293 1.707a1 1 0 0 1 0-1.414z'/>
                            </svg>
                        </button>
                    </div>
                
                    <!-- Corps -->
                    <div class="modal-body align-self-center">
                        <div class="column">
                            <div class="col-12 mb-2">
                                <div class="p-2 rounded bg-danger text-white text-center shadow-sm">
                                    <div class="small fw-bold text-uppercase">🚨 À Placer Immédiatement</div>
                                    <div class="fs-4 fw-bold">@NextUpCount</div>
                                </div>
                            </div>
                            <div class="col-12 mb-2">
                                <div class="p-2 rounded bg-primary text-white text-center shadow-sm">
                                    <div class="small fw-bold text-uppercase">⏳ En Préparation</div>
                                    <div class="fs-4 fw-bold">@UpcomingCount</div>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="p-2 rounded bg-success text-white text-center shadow-sm">
                                    <div class="small fw-bold text-uppercase">✅ En place</div>
                                    <div class="fs-4 fw-bold">@checkedKeys.Count</div>
                                </div>
                            </div>
                        </div>
                    </div>
                
                    <!-- Pied de page -->
                    <div class="modal-footer">
                        <button 
                            type="button" 
                            class="btn class-secondary text-white" 
                            @onclick="CloseInfo"
                        >
                            Fermer
                        </button>
                    </div>            
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<Tatami> tatamis = new();
    private List<CollectorItem> allItems = new();
    private HashSet<string> checkedKeys = new();

    private int selectedTatamiId = 0; // 0 = Tous
    private int selectedDayFilter = 0; // 0 = Tous
    private string selectedUrgencyFilter = "all"; // all, next, upcoming
    private string searchTerm = string.Empty;
    private int tournamentDaysCount = 1;
    private bool isFilterOpen = false;
    private bool isInfoOpen = false;

    public class CollectorItem
    {
        public string Key { get; set; } = string.Empty;
        public int TatamiId { get; set; }
        public string TatamiName { get; set; } = string.Empty;
        public int CompetitionDay { get; set; }
        public int OrderNumber { get; set; }
        public bool IsKata { get; set; }
        public string CategoryName { get; set; } = string.Empty;
        public string RoundName { get; set; } = string.Empty;

        public int? BibNumber { get; set; }
        public string FullName { get; set; } = string.Empty;
        public string Club { get; set; } = string.Empty;
        public string Country { get; set; } = string.Empty;
        public string CountryFlag { get; set; } = string.Empty;
        public CornerColor? Corner { get; set; }
        public string KataName { get; set; } = string.Empty;

        public CollectorUrgency Urgency { get; set; }
        public int QueuePosition { get; set; } = 1; // 1 = Next, 2 = Next+1...
    }

    public enum CollectorUrgency
    {
        Current,
        NextUp,
        Upcoming
    }

    private int NextUpCount => allItems.Count(i => i.Urgency == CollectorUrgency.NextUp);
    private int UpcomingCount => allItems.Count(i => i.Urgency == CollectorUrgency.Upcoming);

    private void OpenFilter()
    {
        isFilterOpen = true;
    }

    private void CloseFilter()
    {
        isFilterOpen = false;
    }

    private void OpenInfo()
    {
        isInfoOpen = true;
    }

    private void CloseInfo()
    {
        isInfoOpen = false;
    }


    private IEnumerable<CollectorItem> FilteredItems
    {
        get
        {
            var list = allItems.AsEnumerable();

            if (selectedTatamiId > 0)
            {
                list = list.Where(i => i.TatamiId == selectedTatamiId);
            }

            if (selectedDayFilter > 0)
            {
                list = list.Where(i => i.CompetitionDay == selectedDayFilter);
            }

            if (selectedUrgencyFilter == "next")
            {
                list = list.Where(i => i.Urgency == CollectorUrgency.NextUp || i.Urgency == CollectorUrgency.Current);
            }
            else if (selectedUrgencyFilter == "upcoming")
            {
                list = list.Where(i => i.Urgency == CollectorUrgency.Upcoming);
            }

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                string term = searchTerm.Trim().ToLowerInvariant();
                list = list.Where(i =>
                    i.FullName.ToLowerInvariant().Contains(term) ||
                    (i.BibNumber.HasValue && i.BibNumber.Value.ToString().Contains(term)) ||
                    i.Club.ToLowerInvariant().Contains(term) ||
                    i.CategoryName.ToLowerInvariant().Contains(term) ||
                    i.TatamiName.ToLowerInvariant().Contains(term));
            }

            // Tri par priorité : d'abord non pointés, puis Urgence (NextUp d'abord), puis Tatami, puis Ordre
            return list.OrderBy(i => checkedKeys.Contains(i.Key) ? 1 : 0)
                       .ThenBy(i => i.Urgency)
                       .ThenBy(i => i.QueuePosition)
                       .ThenBy(i => i.TatamiId);
        }
    }

    protected override void OnInitialized()
    {
        RefreshData();
        TournamentService.OnTatamiUpdated += HandleTatamiUpdated;
        TournamentService.OnStateChanged += HandleStateChanged;
        Lang.OnLanguageChanged += HandleLanguageChanged;
    }

    private async void HandleLanguageChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    private void RefreshData()
    {
        var tournament = TournamentService.GetTournament();
        if (tournament != null)
        {
            tournamentDaysCount = Math.Max(1, tournament.DaysCount);
        }

        tatamis = TournamentService.GetTatamis();
        BuildCollectorList();
    }

    private void BuildCollectorList()
    {
        var items = new List<CollectorItem>();
        bool isKataFinished = TournamentService.IsKataCompetitionFinished(selectedDayFilter > 0 ? selectedDayFilter : null);        foreach (var t in tatamis)
        {
            // --- 1. Passages Kata sur ce tatami (en premier) ---
            if (t.Discipline == CompetitionType.Kata || t.Discipline == CompetitionType.Both)
            {
                var kataPending = t.AssignedKataPerformances
                    .Where(p => p.Status != MatchStatus.Finished)
                    .OrderBy(p => p.CompetitionDay)
                    .ThenBy(p => p.Round)
                    .ThenBy(p => p.PerformanceOrder)
                    .ToList();

                int queuePos = 0;
                foreach (var p in kataPending.Take(6)) // Prendre les 6 prochains passages Kata
                {
                    bool isCurrent = t.CurrentKataPerformanceId == p.Id;
                    CollectorUrgency urgency;

                    if (isCurrent)
                    {
                        urgency = CollectorUrgency.Current;
                    }
                    else if (queuePos == 0)
                    {
                        urgency = CollectorUrgency.NextUp;
                    }
                    else
                    {
                        urgency = CollectorUrgency.Upcoming;
                    }

                    items.Add(new CollectorItem
                    {
                        Key = $"p_{p.Id}",
                        TatamiId = t.Id,
                        TatamiName = t.Name,
                        CompetitionDay = p.CompetitionDay,
                        OrderNumber = p.PerformanceOrder,
                        IsKata = true,
                        CategoryName = p.Category?.Name ?? "Kata",
                        RoundName = p.Round == KataRound.Turn1 ? "1er Tour" : "2e Tour (Finale)",
                        BibNumber = p.Competitor?.BibNumber,
                        FullName = p.CompetitorDisplayName,
                        Club = p.Competitor?.Club ?? "Club inconnu",
                        Country = p.Competitor?.Country ?? "",
                        CountryFlag = p.Competitor?.CountryFlag ?? "🏳️",
                        KataName = p.KataName,
                        Urgency = urgency,
                        QueuePosition = queuePos + 1
                    });

                    if (!isCurrent)
                    {
                        queuePos++;
                    }
                }
            }

            // --- 2. Rencontres Kumité sur ce tatami (UNIQUEMENT si les Katas de CE tatami sont finis !) ---
            bool tatamiKataFinished = TournamentService.IsKataCompetitionFinished(
                selectedDayFilter > 0 ? selectedDayFilter : null,
                tatamiId: t.Id);
            if (tatamiKataFinished && (t.Discipline == CompetitionType.Kumite || t.Discipline == CompetitionType.Both))
            {
                var kumitePending = t.AssignedKumiteMatches
                    .Where(m => m.Status != MatchStatus.Finished)
                    .OrderBy(m => m.CompetitionDay)
                    .ThenBy(m => m.MatchNumber)
                    .ToList();

                int queuePos = 0;
                foreach (var m in kumitePending.Take(4)) // Prendre les 4 prochains combats du tatami
                {
                    bool isCurrent = t.CurrentKumiteMatchId == m.Id;
                    CollectorUrgency urgency;

                    if (isCurrent)
                    {
                        urgency = CollectorUrgency.Current;
                    }
                    else if (queuePos == 0)
                    {
                        urgency = CollectorUrgency.NextUp;
                    }
                    else
                    {
                        urgency = CollectorUrgency.Upcoming;
                    }

                    // Combattant AKA (Rouge)
                    if (m.AkaCompetitor != null || !string.IsNullOrWhiteSpace(m.AkaDisplayName))
                    {
                        items.Add(new CollectorItem
                        {
                            Key = $"k_{m.Id}_aka",
                            TatamiId = t.Id,
                            TatamiName = t.Name,
                            CompetitionDay = m.CompetitionDay,
                            OrderNumber = m.MatchNumber,
                            IsKata = false,
                            CategoryName = m.Category?.Name ?? "Kumité",
                            RoundName = m.RoundName,
                            BibNumber = m.AkaCompetitor?.BibNumber,
                            FullName = m.AkaDisplayName,
                            Club = m.AkaCompetitor?.Club ?? "Club inconnu",
                            Country = m.AkaCompetitor?.Country ?? "",
                            CountryFlag = m.AkaCompetitor?.CountryFlag ?? "🏳️",
                            Corner = CornerColor.Aka,
                            Urgency = urgency,
                            QueuePosition = queuePos + 1
                        });
                    }

                    // Combattant SHIRO (Blanc)
                    if (m.ShiroCompetitor != null || !string.IsNullOrWhiteSpace(m.ShiroDisplayName))
                    {
                        items.Add(new CollectorItem
                        {
                            Key = $"k_{m.Id}_shiro",
                            TatamiId = t.Id,
                            TatamiName = t.Name,
                            CompetitionDay = m.CompetitionDay,
                            OrderNumber = m.MatchNumber,
                            IsKata = false,
                            CategoryName = m.Category?.Name ?? "Kumité",
                            RoundName = m.RoundName,
                            BibNumber = m.ShiroCompetitor?.BibNumber,
                            FullName = m.ShiroDisplayName,
                            Club = m.ShiroCompetitor?.Club ?? "Club inconnu",
                            Country = m.ShiroCompetitor?.Country ?? "",
                            CountryFlag = m.ShiroCompetitor?.CountryFlag ?? "🏳️",
                            Corner = CornerColor.Shiro,
                            Urgency = urgency,
                            QueuePosition = queuePos + 1
                        });
                    }

                    if (!isCurrent)
                    {
                        queuePos++;
                    }
                }
            }
        }

        allItems = items;
    }

    private void ToggleChecked(string key)
    {
        if (checkedKeys.Contains(key))
        {
            checkedKeys.Remove(key);
        }
        else
        {
            checkedKeys.Add(key);
        }
    }

    private void ClearCheckedKeys()
    {
        checkedKeys.Clear();
    }

    private async void HandleTatamiUpdated(int updatedTatamiId)
    {
        RefreshData();
        await InvokeAsync(StateHasChanged);
    }

    private async void HandleStateChanged()
    {
        RefreshData();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        TournamentService.OnTatamiUpdated -= HandleTatamiUpdated;
        TournamentService.OnStateChanged -= HandleStateChanged;
        Lang.OnLanguageChanged -= HandleLanguageChanged;
    }
}
